HOME = Path.home()
SKILL = Path(__file__).resolve().parent.parent
LEDGER = Path(os.environ.get("CONTRIB_LEDGER", HOME / "contrib-queue"))
WORK = Path(os.environ.get("CONTRIB_WORK", HOME / "contrib-work"))
TOKEN_FILE = Path(os.environ.get("CONTRIB_TOKEN_FILE", HOME / ".config" / "contrib" / "claude-token"))
EXIT_DONE, EXIT_SOFT, EXIT_HARD, EXIT_SHUTDOWN_FAILED, EXIT_BUSY = 0, 10, 20, 30, 40
SOFT_DISK_GB, HARD_DISK_GB, HARD_MEM_MB, HARD_MEM_SECS = 32, 26, 2048, 300
MAX_TURNS = {"A": 8, "B": 10, "C": 6}
MAX_REQUESTS_PER_TURN = 12
TURN_TIMEOUT = 45 * 60          # one Claude turn
REQUEST_TIMEOUT = 75 * 60       # one build or test request
STAGE_BUDGET = 90 * 60          # soft stop when less than this is left before the deadline
SESSION_FILE_LIMIT = 2_000_000  # bytes the driver reads back from a session-written file
INFRA_EXITS = (97, 98, 99, 124)
SNAP_MAX_ENTRIES = 500_000      # files and folders copy_git_dir copies out of one clone's .git
SNAP_MAX_DEPTH = 64             # folder depth it follows (a ref like refs/heads/a/b/c is 4)
# Names Claude Code's sandbox masks with /dev/null inside a session's working folder.
SANDBOX_MASKS = (".bashrc", ".bash_profile", ".bash_login", ".bash_logout", ".profile", ".zshrc", ".zprofile",
                 ".zshenv", ".zlogin", ".gitconfig", ".ripgreprc", ".gitmodules", ".mcp.json", ".idea",
                 ".vscode", ".claude")
JAIL_PORT = 19200               # the scratch node's port inside its own network namespace
SETTING_SOURCES = ""            # sessions load no user, project or local settings
EM_DASH, EN_DASH = chr(0x2014), chr(0x2013)
GIT_SAFE = ["-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "credential.helper=",
            "-c", "core.pager=cat",
            # No automatic gc or maintenance: git starts it in the background, where it rewrites
            # the packs a clone or a .git copy is reading at that moment. Preflight runs gc in the
            # foreground instead (repo_gc).
            "-c", "gc.auto=0", "-c", "maintenance.auto=false"]
# What the driver copies from a session's folder into the ledger's record/ (the session folder
# itself is ignored by the ledger's git, so nothing a session plants there reaches git).
RECORD_TOP = ("packet.md", "details.md", "PR_BODY.md", "plan.md", "next.json", "candidates.json", "rules.json")
LEDGER_IGNORES = ("candidates/*/session/", "runs/*/scout/session/", "candidates/*/gh/", "runs/*/scout/gh/",
                  "candidates/*/transcripts/", "runs/*/scout/transcripts/", "runs/*/learn/session/",
                  "runs/*/learn/review/", "runs/*/learn/bundle/", "runs/*/learn/transcripts/")
GH_VERBS = {("issue", "view"), ("issue", "list"), ("pr", "view"), ("pr", "list"), ("pr", "diff"),
            ("pr", "checks"), ("search", "issues"), ("search", "prs")}
GH_FLAGS_VALUE = {"--json", "--limit", "-L", "--state", "-s", "--search", "-S", "--label", "-l", "--author",
                  "-A", "--sort", "--order", "--match"}
GH_FLAGS_BARE = {"--comments", "--name-only", "--patch"}
JAIL_TOOLS = {"bwrap", "socat", "cargo", "rustc", "xerj", "es-yaml-runner", "guarded.sh", "cc", "ld"}


_LIBC = ctypes.CDLL(None, use_errno=True)


def die_with_driver():
    """preexec_fn: the child gets SIGTERM if the driver dies, even by SIGKILL."""
    _LIBC.prctl(1, signal.SIGTERM, 0, 0, 0)     # PR_SET_PDEATHSIG


def agent_defs():
    """User agents the stages call by name, passed inline: sessions load no user settings."""
    out = {}
    for name in ("code-reviewer",):
        p = HOME / ".claude" / "agents" / f"{name}.md"
        m = re.match(r"^---\n(.*?)\n---\n(.*)$", p.read_text() if p.is_file() else "", re.S)
        if not m:
            continue
        fm = dict(re.findall(r"^(\w+):\s*(.*)$", m.group(1), re.M))
        a = {"description": fm.get("description", name).strip().strip('"'), "prompt": m.group(2).strip()}
        if fm.get("tools"):
            a["tools"] = [x.strip() for x in fm["tools"].split(",") if x.strip()]
        if fm.get("model"):
            a["model"] = fm["model"].strip()
        out[name] = a
    return out


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def load_env(path):
    env = {}
    for line in Path(path).read_text().splitlines():
        line = "" if line.lstrip().startswith("#") else line.split(" #", 1)[0].strip()
        if "=" in line:
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def read_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except (OSError, ValueError):
        return default


def write_json(p, obj):
    p = Path(p)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2) + "\n")
    tmp.replace(p)


def gz_copy(src, dst):
    """Gzip src to dst through a temp file, with a fixed mtime so an unchanged file
    gives the same bytes (and no new ledger blob) every time it is archived."""
    dst = Path(dst)
    tmp = dst.with_name(dst.name + ".tmp")
    try:
        with open(src, "rb") as i, open(tmp, "wb") as raw, \
                gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0, compresslevel=6) as o:
            shutil.copyfileobj(i, o)
        tmp.replace(dst)
    finally:
        tmp.unlink(missing_ok=True)


def tool_text(c):
    """The text of a tool result's content (a string or a list of text parts)."""
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and isinstance(x.get("text"), str))
    return ""


def inp_text(v):
    return v if isinstance(v, str) else json.dumps(v)[:4000]


SECRET_ENV = re.compile(r"^CLAUDE|TOKEN|KEY|SECRET|PASSW|CREDENTIAL|COOKIE|^SSH_AUTH_SOCK$|^AWS_|^AZURE_|^GOOGLE_|^GCP_",
                        re.I)
SAFE_ENV = ("HOME", "USER", "LOGNAME", "SHELL", "LANG", "TERM", "TZ", "PATH")


def read_session_file(p, limit=SESSION_FILE_LIMIT):
    """Read a file a session wrote: a regular file (never a symlink), not too big."""
    try:
        st = os.lstat(p)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            return None
        # Non-blocking, then check what was opened: a FIFO swapped in after the lstat must not
        # hang the driver.
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            os.close(fd)
            return None
        with os.fdopen(fd, "rb") as f:
            return f.read(limit).decode("utf-8", errors="replace")
    except OSError:
        return None


def read_session_json(p):
    t = read_session_file(p)
    if t is None:
        return None
    try:
        v = json.loads(t)
    except ValueError:
        return None
    return v if isinstance(v, dict) else None


def file_sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def copy_regular(src, dest):
    """Copy a build output out of a target dir on the host: a regular file, never through a link."""
    fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise RuntimeError(f"{src} is not a regular file")
        tmp = Path(str(dest) + ".tmp")
        with open(tmp, "wb") as o:
            shutil.copyfileobj(f, o)
    os.chmod(tmp, 0o755)
    os.replace(tmp, dest)


def one_line(s, n=300):
    s = re.sub(r"[\x00-\x1f\x7f]+", " ", str(s or ""))
    if not s.isascii():
        # Unicode separators (U+2028 and friends) are whitespace; other controls, format marks
        # (bidi overrides, zero-width marks, tag characters), private-use characters, lone
        # surrogates and unassigned code points go, so what a reader sees is all there is.
        s = "".join(" " if c.isspace() else c for c in s if c.isspace() or unicodedata.category(c)[0] != "C")
    s = re.sub(r"\s+", " ", s).strip().replace(EM_DASH, ",").replace(EN_DASH, "-")
    return s[:n]


# The packet is the user's review of a candidate (rules/packet.md); stage C's output must have
# this shape, and QUEUE.md and SUMMARY.md show its title and status line.
PACKET_HEADINGS = ("The problem", "Options", "The fix", "Decisions for you", "Not covered", "Review",
                   "Other open PRs nearby")
PACKET_ROWS = ("Area", "The bug", "Who notices", "The fix", "Size", "Proof", "Risk")
PACKET_MAX_WORDS = 1100
PACKET_MAX_BYTES = 60_000
# A source file name and a line number, like search.rs:120 or search.rs#L120. Anchored at the
# start of the name so a long run of name characters is scanned once, not once per start.
POINTER_RE = re.compile(r"(?<![\w/.-])[\w/.-]+\.(?:rs|py|go|java|kt|js|ts|tsx|c|h|cc|cpp|hpp|rb|php|cs|swift|"
                        r"scala|sh|toml|ya?ml|json|md|sql|proto|txt)(?::L?|#L)\d+")


def md_text(v, n=300):
    """Session text as one markdown-inert line: no markdown links, HTML, code spans or table breaks.
    Bare URLs stay as text (GitHub may autolink them); the source check and your approval guard them."""
    return re.sub(r"([\\`\[\]<>|])", r"\\\1", one_line(v, n))


def packet_words(text):
    """Words outside the diagrams; table pipes and other markup alone do not count."""
    return sum(1 for w in prose(text).split() if re.search(r"[A-Za-z0-9]", w))


def prose(text):
    """The text outside fenced code blocks (the diagrams)."""
    out, fenced = [], False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fenced = not fenced
        elif not fenced:
            out.append(line)
    return "\n".join(out)


def packet_head(text):
    """(title, status) of a packet: its first line when that is a '# ' title, and the bold
    status line right under it. Session text, so each is one line with no link brackets."""
    lines = [l.strip() for l in (text or "").splitlines() if l.strip()]
    if not lines or not lines[0].startswith("# "):
        return None, None
    clean = lambda v: md_text(v.replace("**", "").replace("`", ""), 200)
    title = clean(lines[0][2:]) or None
    status = clean(lines[1]) if len(lines) > 1 and lines[1].startswith("**") else None
    return title, status


def packet_problems(text):
    """What a finished packet lacks against rules/packet.md, one line each for the session."""
    if len(text.encode()) > PACKET_MAX_BYTES:
        return [f"session/packet.md is {len(text.encode())} bytes; a packet is a short review "
                f"(at most {PACKET_MAX_WORDS} words), so move detail to session/details.md"]
    problems = []
    title, status = packet_head(text)
    if not title:
        problems.append("session/packet.md must start with a '# ' title line")
    if not (status or "").startswith("Ready to publish."):
        problems.append("the packet's status line (bold, right under the title) must start with **Ready to publish.**")
    for h in PACKET_HEADINGS:
        if not re.search(rf"^## {re.escape(h)}[ \t]*$", text, re.M):
            problems.append(f"session/packet.md is missing the heading '## {h}'")
    for r in PACKET_ROWS:
        if not re.search(rf"^\|[ \t]*\*\*{re.escape(r)}\*\*[ \t]*\|", text, re.M):
            problems.append(f"the packet's at-a-glance table is missing the row **{r}**")
    if text.count("```mermaid") < 2:
        problems.append("session/packet.md needs two mermaid flowcharts (the problem and the fix)")
    words = packet_words(text)
    if words > PACKET_MAX_WORDS:
        problems.append(f"session/packet.md has {words} words outside the diagrams, over the limit of "
                        f"{PACKET_MAX_WORDS}; move detail to session/details.md")
    m = POINTER_RE.search(prose(text))
    if m:
        problems.append(f"session/packet.md has a file:line pointer ({one_line(m.group(0), 80)}); "
                        "those go in session/details.md")
    if "(details.md)" not in text:
        problems.append("the packet's footer must link [details.md](details.md)")
    return problems


# A learned profile (SPEC.md, rules/profile.md): rules a learn session drew from a repo's guide
# files and its outside contributors' PRs, then a second, fresh session reviewed. Claude reads and
# judges: what the rules are, how strong, and why. The driver checks only what it can check as a
# fact (each quote is in the guide file or the maintainer's comment it names, each PR is a merged PR
# in the bundle) and the file's shape. Rule text stays session text all the way through, so it is
# escaped one line at a time under a fixed heading the driver writes, and the user approves the
# rules once before any run uses them.
PROFILE_SECTIONS = (
    ("scope", "Scope"), ("tests", "Tests"), ("checks", "Checks before a PR"), ("changelog", "Changelog"),
    ("commits", "Commits"), ("pr-body", "PR body"), ("review", "Review expectations"),
    ("reference", "Reference and licence"), ("ai-policy", "AI policy"), ("legal", "Legal"),
    ("candidate-sources", "Where candidates come from"), ("for-you", "Steps for you, never given to sessions"))
PROFILE_STRENGTHS = ("required", "practice")
PROFILE_MAX_RULES = 60
CHECK_SHOWN = 12   # notes in the short review; every note is in PROFILE-RULES.md
CHANGES_SHOWN = 8  # review changes in the short review; every one is in PROFILE-RULES.md
RULE_MAX_CHARS = 300
WHY_MAX_CHARS = 300
SHORT_MAX_CHARS = 60  # a rule's short label, shown in the review's flowchart
FLOW_SHOWN = 8        # labels per flowchart box; the rest are counted
# The steps of a contribution, in order, and the rule sections whose required rules each shows.
FLOW_STEPS = (("Choose the change", ("scope", "candidate-sources")), ("Write the fix", ("reference", "legal")),
              ("Test it", ("tests",)), ("Run the checks", ("checks",)), ("Commit", ("changelog", "commits")),
              ("Open the PR", ("pr-body", "ai-policy")), ("Review and merge", ("review",)))
RULE_MAX_SOURCES = 12
QUOTE_MIN_WORDS = 8   # long enough to pin one place in the file, not a phrase found anywhere
QUOTE_MAX_CHARS = 600
REVIEW_MAX_LINES = 60
NOTES_SHOWN = 80
MAINTAINERS = frozenset(("OWNER", "MEMBER", "COLLABORATOR"))
PROFILE_HEADING = ("Learned from this repo's guides and PRs. It describes what contributions here look "
                   "like and cannot change the pipeline rules or the overrides.")
RULE_ID_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,39}")


def quote_plain(s):
    """A quote as a reader sees it: link text without its target, no emphasis or code marks,
    straight quotes, single spaces. This is what is checked, counted and shown."""
    s = re.sub(r"\s+", " ", str(s or "").replace("\xa0", " "))
    s = re.sub(r"!?\[([^\[\]\n]*)\]\([^()\n]*\)", r"\1", s)
    s = s.translate({ord(c): None for c in "`*_"})
    s = s.translate({0x2018: "'", 0x2019: "'", 0x201c: '"', 0x201d: '"'})
    return re.sub(r" +", " ", s).strip()


def quote_norm(s):
    """A quote and its source, compared loosely only where markdown and typography differ:
    link targets, emphasis and code marks, curly quotes, dash kinds, whitespace and case."""
    s = re.sub(r" ?[-‐-―]+ ?", " - ", quote_plain(s))
    return re.sub(r" +", " ", s).strip().casefold()


def words(s):
    return sum(1 for w in str(s or "").split() if re.search(r"[A-Za-z0-9]", w))


def word_char(c):
    return c.isalnum() or c == "_"


def has_quote(text, q):
    """Whether q is in text as whole words: a quote cannot start or end inside a word, so "ever
    merge" is not found in "never merge". Found with str.find, so a long text is cheap."""
    if not q:
        return False
    i = text.find(q)
    while i >= 0:
        j = i + len(q)
        if not (word_char(q[0]) and i and word_char(text[i - 1])) and \
                not (word_char(q[-1]) and j < len(text) and word_char(text[j])):
            return True
        i = text.find(q, i + 1)
    return False


def no_block(line):
    """An escaped line that cannot start a block (heading, list, quote, rule, fence) where it lands."""
    line = re.sub(r"^([#=+*>_~-])", r"\\\1", line)
    return re.sub(r"^(\d+)([.)])", r"\1\\\2", line)


def normed(bundle, key, text):
    cache = bundle.setdefault("_norm", {})
    if key not in cache:
        cache[key] = quote_norm(text)
    return cache[key]


def quote_problem(quote, where):
    """Why a quote cannot stand, or None. Counted on what is left once markup is gone, so an
    empty or one-word quote never matches everywhere."""
    if not isinstance(quote, str) or len(quote) > QUOTE_MAX_CHARS or words(quote_norm(quote)) < QUOTE_MIN_WORDS:
        return (f"the quote from {where} needs {QUOTE_MIN_WORDS} or more words of text and at most "
                f"{QUOTE_MAX_CHARS} characters")
    return None


def check_source(src, bundle):
    """(normalized source, None) when src checks out against the bundle, else (None, why).
    Facts only: the quote is in that file or comment, the comment is by a maintainer (GitHub's
    own label), the PRs are merged PRs the driver fetched."""
    if not isinstance(src, dict):
        return None, "a source is not an object"
    prs = bundle.get("prs", {})
    if "guide" in src:
        path, quote = src.get("guide"), src.get("quote")
        g = bundle.get("guides", {}).get(path) if isinstance(path, str) else None
        if g is None:
            return None, f"guide {one_line(path, 80)!r} is not in the bundle"
        why = quote_problem(quote, one_line(path, 80))
        if why:
            return None, why
        if not has_quote(normed(bundle, ("guide", path), g.get("text", "")), quote_norm(quote)):
            return None, f"the quote is not in {one_line(path, 80)} at this commit"
        return {"kind": "guide", "path": path, "blob": g.get("blob", ""),
                "quote": one_line(quote_plain(quote), QUOTE_MAX_CHARS)}, None
    if "comment" in src:
        num, cid, quote = src.get("pr"), src.get("comment"), src.get("quote")
        pr = prs.get(num) if isinstance(num, int) and not isinstance(num, bool) else None
        if pr is None:
            return None, f"PR {one_line(num, 20)} is not in the bundle"
        c = next((c for c in pr.get("comments", []) if c.get("id") == cid), None)
        if c is None:
            return None, f"comment {one_line(cid, 40)!r} is not on PR {num} in the bundle"
        if c.get("association") not in MAINTAINERS:
            return None, f"comment {one_line(cid, 40)} on PR {num} is not by a maintainer"
        why = quote_problem(quote, f"PR {num}")
        if why:
            return None, why
        if not has_quote(normed(bundle, ("comment", num, cid), c.get("body", "")), quote_norm(quote)):
            return None, f"the quote is not in comment {one_line(cid, 40)} on PR {num}"
        return {"kind": "comment", "pr": num, "comment": cid, "author": c.get("author", ""),
                "quote": one_line(quote_plain(quote), QUOTE_MAX_CHARS)}, None
    if "prs" in src:
        nums = src.get("prs")
        if not isinstance(nums, list) or not nums or len(nums) > 200 or \
                not all(isinstance(n, int) and not isinstance(n, bool) for n in nums):
            return None, "a prs source must list PR numbers"
        nums = sorted(set(nums))
        bad = [n for n in nums if prs.get(n, {}).get("state") != "merged"]
        if bad:
            return None, f"PR {bad[0]} is not a merged PR in the bundle"
        return {"kind": "prs", "prs": nums}, None
    return None, "a source must name a guide, a comment or merged prs"


def check_rules(raw, bundle):
    """Check the shape of a session's rules.json and every source against the bundle the driver
    fetched. Returns (kept, notes): kept rules carry only the sources that check out; notes are
    (id, what was left out and why). What a rule says and how strong it is are Claude's call."""
    kept, notes = [], []
    rules = raw.get("rules") if isinstance(raw, dict) else None
    if not isinstance(rules, list):
        return kept, [("(file)", "rules.json needs a list called rules")]
    if len(rules) > 2 * PROFILE_MAX_RULES:
        return kept, [("(file)", f"rules.json lists {len(rules)} rules; the limit is {PROFILE_MAX_RULES}")]
    sections = {k for k, _ in PROFILE_SECTIONS}
    seen = set()
    for n, r in enumerate(rules):
        rid = r.get("id") if isinstance(r, dict) else None
        name = rid if isinstance(rid, str) and RULE_ID_RE.fullmatch(rid) else f"(rule {n + 1})"
        if len(kept) >= PROFILE_MAX_RULES:
            notes.append((name, f"over the limit of {PROFILE_MAX_RULES} rules"))
            continue
        if not isinstance(r, dict):
            notes.append((name, "not an object"))
            continue
        if not (isinstance(rid, str) and RULE_ID_RE.fullmatch(rid)) or rid in seen:
            notes.append((name, "the id must be new, lowercase letters, digits and hyphens, at most 40"))
            continue
        if not isinstance(r.get("section"), str) or r["section"] not in sections:
            notes.append((name, "unknown section"))
            continue
        if not isinstance(r.get("strength"), str) or r["strength"] not in PROFILE_STRENGTHS:
            notes.append((name, "strength must be required or practice"))
            continue
        text, why = r.get("text"), r.get("why")
        clean = one_line(text, 4 * RULE_MAX_CHARS) if isinstance(text, str) else ""
        if words(clean) < 3 or len(clean) > RULE_MAX_CHARS:
            notes.append((name, f"the text must be one or two sentences, at most {RULE_MAX_CHARS} characters"))
            continue
        reason = one_line(why, 4 * WHY_MAX_CHARS) if isinstance(why, str) else ""
        if words(reason) < 3 or len(reason) > WHY_MAX_CHARS:
            notes.append((name, f"the reason (why) must be one or two sentences, at most {WHY_MAX_CHARS} characters"))
            continue
        srcs = r.get("sources")
        if not isinstance(srcs, list) or not srcs or len(srcs) > RULE_MAX_SOURCES:
            notes.append((name, f"it needs 1 to {RULE_MAX_SOURCES} sources"))
            continue
        good = {}
        for s in srcs:
            v, bad = check_source(s, bundle)
            if v:
                good.setdefault(json.dumps(v, sort_keys=True), v)
            else:
                notes.append((name, f"a source was left out: {bad}"))
        if not good:
            notes.append((name, "left out: no source checks out"))
            continue
        seen.add(rid)
        # One order and no repeats, so the same rules always give the same id.
        short = one_line(r.get("short"), 4 * SHORT_MAX_CHARS) if isinstance(r.get("short"), str) else ""
        rule = {"id": rid, "section": r["section"], "strength": r["strength"],
                "text": clean, "why": reason, "sources": [good[k] for k in sorted(good)]}
        # Stored only when it passes, so a learn without labels keeps the id it had before labels
        # existed; the flowchart shows the id in its place.
        if words(short) >= 2 and len(short) <= SHORT_MAX_CHARS:
            rule["short"] = short
        kept.append(rule)
    return kept, notes


def review_lines(raw):
    """The review session's list of what it changed in the draft, as plain lines."""
    items = raw.get("review") if isinstance(raw, dict) else None
    return [one_line(x, 300) for x in (items if isinstance(items, list) else [])
            if isinstance(x, str) and one_line(x)][:REVIEW_MAX_LINES]


def cost_text(res):
    cost = res.get("total_cost_usd")
    return (f"{res.get('num_turns', '?')} turns, {round((res.get('duration_ms') or 0) / 60000, 1)} min"
            + (f", about ${cost:.2f}" if isinstance(cost, (int, float)) else ""))


def profile_id(rules):
    """The id the user approves: the first 12 hex digits of the rules' SHA-256."""
    canon = json.dumps(sorted(rules, key=lambda r: r["id"]), sort_keys=True, separators=(",", ":"),
                       ensure_ascii=False)
    return hashlib.sha256(canon.encode()).hexdigest()[:12]


def source_ref(s):
    """A source as a short plain reference (no link): what a session sees next to a rule."""
    if s["kind"] == "guide":
        return md_text(s["path"], 120)
    if s["kind"] == "comment":
        return f"maintainer on #{s['pr']}"
    nums = s["prs"]
    more = f" and {len(nums) - 5} more" if len(nums) > 5 else ""
    return "merged " + ", ".join(f"#{n}" for n in nums[:5]) + more


def rule_order(rules):
    order = {k: i for i, (k, _) in enumerate(PROFILE_SECTIONS)}
    return sorted(rules, key=lambda r: (order[r["section"]], PROFILE_STRENGTHS.index(r["strength"]), r["id"]))


def render_profile(repo, rules, base, learned_at):
    """profile.md: the learned rules as sessions read them, under the driver's own heading."""
    pid = profile_id(rules)
    out = [f"## Contribution rules learned from {md_text(repo, 100)}", "", PROFILE_HEADING, "",
           f"Rules id {pid}, learned at base {md_text(base, 12)} on {md_text(learned_at, 10)}. "
           "A required rule is one this project sends a PR back for; a practice is what merged PRs here "
           "usually do.", ""]
    last = None
    for r in rule_order([r for r in rules if r["section"] != "for-you"]):
        if r["section"] != last:
            if last is not None:
                out.append("")
            last = r["section"]
            out += [f"### {dict(PROFILE_SECTIONS)[last]}", ""]
        refs = "; ".join(source_ref(s) for s in r["sources"])
        out.append(f"- {r['strength']}: {md_text(r['text'], RULE_MAX_CHARS)} ({refs})")
    return "\n".join(out) + "\n"


def source_link(repo, base, s):
    """A source as a markdown link for the user's review document. The driver builds every URL
    from the repo, the base and a checked path or number; nothing a session wrote becomes one."""
    quote = urllib.parse.quote
    site = f"https://github.com/{repo}"
    if s["kind"] == "guide":
        return f"[{md_text(s['path'], 120)}]({site}/blob/{base}/{quote(s['path'])})"
    if s["kind"] == "comment":
        return f"[maintainer {md_text(s['author'], 40)} on #{s['pr']}]({site}/pull/{s['pr']})"
    nums = s["prs"]
    shown = ", ".join(f"[#{n}]({site}/pull/{n})" for n in nums[:8])
    return f"merged PRs {shown}" + (f" and {len(nums) - 8} more" if len(nums) > 8 else "")


def review_notes(items, shown):
    lines = [f"- {md_text(i, 40)}: {md_text(one_line(w), 300)}" for i, w in items[:shown]]
    return lines + ([f"- and {len(items) - shown} more, in PROFILE-RULES.md"] if len(items) > shown else [])


def plain_list(lines, shown):
    return [f"- {no_block(md_text(x, 300))}" for x in lines[:shown]] + \
        ([f"- and {len(lines) - shown} more, in PROFILE-RULES.md"] if len(lines) > shown else [])


def flow_label(s):
    """A session's short label as plain text that cannot break out of a mermaid box."""
    return re.sub(r" +", " ", re.sub(r"[^\w ,.'():/+-]", " ", one_line(s, SHORT_MAX_CHARS))).strip() or "(no label)"


def count(n, one, many):
    """'1 file', '2 files': the review's tables read as sentences."""
    return f"{n} {one if n == 1 else many}"


def render_flow(req):
    """The required rules as the steps of a contribution, one box per step with a rule, in a
    mermaid flowchart. The steps and their order are fixed here; the labels are the sessions'."""
    boxes = []
    for title, secs in FLOW_STEPS:
        rs = [r for r in rule_order(req) if r["section"] in secs]
        if rs:
            labels = [flow_label(r.get("short") or r["id"].replace("-", " ")) for r in rs[:FLOW_SHOWN]]  # no label: the id
            labels += [f"and {len(rs) - FLOW_SHOWN} more"] if len(rs) > FLOW_SHOWN else []
            boxes.append(f"<b>{title}</b>, {len(rs)} required" + "".join(f"<br/>{l}" for l in labels))
    if not boxes:
        return ["(none)"]
    return (["```mermaid", "flowchart TD"] + [f'    s{i}["{b}"]' for i, b in enumerate(boxes)]
            + [f"    s{i} --> s{i + 1}" for i in range(len(boxes) - 1)] + ["```"])


def render_review(repo, rules, notes, summary, meta, changes=()):
    """PROFILE-REVIEW.md: the short document the user reads before approving learned rules.
    Every rule with its reason and sources is in PROFILE-RULES.md (render_rules)."""
    pid = profile_id(rules)
    base = str(meta.get("base", ""))
    you = [r for r in rules if r["section"] == "for-you"]
    req = [r for r in rules if r["section"] != "for-you" and r["strength"] == "required"]
    prac = [r for r in rules if r["section"] != "for-you" and r["strength"] == "practice"]
    guides, merged, closed, often, cited = (int(meta.get(k, 0)) for k in ("guides", "merged", "closed", "often", "cited"))
    out = [f"# What {md_text(repo, 100)} expects from a contribution", "",
           (f"**Learned, not yet approved.** Rules id `{pid}`. Runs on this repo refuse until you approve it "
            f"with `contrib-run --repo {md_text(repo, 100)} --approve-profile {pid}`; to correct a rule, write the "
            "correction in the repo's overrides file." if rules else
            ("**Nothing was kept.** No rule had a source that checked out; why is in "
             "[PROFILE-RULES.md](PROFILE-RULES.md). There is nothing to approve." if notes else
             "**Nothing was kept.** The sessions listed no rules. There is nothing to approve.")), "",
           "| | |", "|---|---|",
           f"| **Read** | {count(guides - often - cited, 'guide file', 'guide files')}, "
           f"{count(often, 'file', 'files')} merged PRs often change"
           + (f", {count(cited, 'file', 'files')} current rules cite" if cited else "") + ", at base "
           f"`{md_text(base, 12)}`; {count(merged, 'merged PR', 'merged PRs')} by outside contributors, "
           f"{closed} closed without merging |",
           f"| **Rules** | {len(req)} required, {count(len(prac), 'practice', 'practices')}, "
           f"{count(len(you), 'step', 'steps')} for you. Drafted by one "
           "session, checked and corrected by a second. Each rule with its reason and sources: "
           "[PROFILE-RULES.md](PROFILE-RULES.md) |",
           f"| **Left out** | " + (f"{count(len(notes), 'rule or source', 'rules or sources')} the driver left "
                                    "out, with the reasons under Left out below and in PROFILE-RULES.md |"
                                    if notes else "nothing: every rule's sources checked out |" if rules else
                                    "nothing: the sessions listed no rules |")]
    if guides - often <= 1 or merged < 6:
        out.append("| **Little to learn from** | Few guide files or merged outside PRs, so most of what this "
                   "repo expects is not here; expect to add overrides. |")
    out += ["", "## What the project cares about", ""]
    lines = [md_text(one_line(l, RULE_MAX_CHARS), RULE_MAX_CHARS)
             for l in str(summary or "").splitlines() if one_line(l)][:6]
    out += [f"- {no_block(l)}" for l in lines] or ["(The sessions wrote no summary.)"]
    out += ["", "## What a PR must do here", "", "The required rules, at the step of a contribution where each "
            "applies. A PR that breaks one is likely sent back. Why each is required, and the practices, "
            "are in PROFILE-RULES.md.", ""] + render_flow(req)
    if you:
        out += ["", "## Steps for you", "", "Things only you can do, by hand. Sessions never see these.", ""]
        out += [f"- {no_block(md_text(r['text'], RULE_MAX_CHARS))} ({source_link(repo, base, r['sources'][0])})"
                for r in rule_order(you)]
    if changes:
        out += ["", f"## What the review changed ({len(changes)})", ""] + plain_list(list(changes), CHANGES_SHOWN)
    if notes:
        out += ["", "## Left out", ""] + review_notes(notes, CHECK_SHOWN)
    return "\n".join(out) + "\n"


def render_rules(repo, rules, notes, meta, changes=()):
    """PROFILE-RULES.md: every learned rule with its reason and sources, and every note."""
    pid = profile_id(rules)
    base = str(meta.get("base", ""))
    out = [f"# Every rule learned for {md_text(repo, 100)}, with its sources", "",
           f"Rules id `{pid}`, base `{md_text(base, 12)}`. The short review is in "
           "[PROFILE-REVIEW.md](PROFILE-REVIEW.md).", ""]
    last = None
    for r in rule_order(rules):
        if r["section"] != last:
            last = r["section"]
            out += ["", f"## {dict(PROFILE_SECTIONS)[last]}", ""]
        out.append(f"- **{r['strength']}** `{md_text(r['id'], 40)}`: {md_text(r['text'], RULE_MAX_CHARS)}")
        out.append(f"  - Why: {md_text(r['why'], WHY_MAX_CHARS)}")
        for s in r["sources"]:
            q = f": \"{md_text(s['quote'], QUOTE_MAX_CHARS)}\"" if s.get("quote") else ""
            out.append(f"  - {source_link(repo, base, s)}{q}")
    if changes:
        out += ["", "## What the review changed", ""] + plain_list(list(changes), REVIEW_MAX_LINES)
    if notes:
        out += ["", "## Left out", ""] + review_notes(notes, NOTES_SHOWN)
    return "\n".join(out) + "\n"


# ----- what a learn fetches -------------------------------------------------------------
# Guide files, matched per path segment ('*' stays inside one folder), case-insensitively.
GUIDE_GLOBS = ("AGENTS.md", "CLAUDE.md", "CONTRIBUTING*", "CODE_OF_CONDUCT*", "CLA*", ".contributors", "CODEOWNERS",
               ".github/*TEMPLATE*", ".github/*TEMPLATE*/*", ".github/*CONTRIBUT*", ".github/AI*",
               ".github/CODEOWNERS", "docs/*CONTRIBUT*", "docs/*REVIEW*", "docs/CODEOWNERS")
GUIDE_TEXT = (".md", ".markdown", ".rst", ".txt")
GUIDE_MAX_FILES = 40
GUIDE_MAX_BYTES = 200_000
GUIDE_TOTAL_BYTES = 1_500_000   # all guides together, so PRs keep at least half the bundle
LEARN_MERGED, LEARN_CLOSED = 30, 15
LEARN_SEARCH_PAGES = 3
LEARN_BODY_MAX, LEARN_COMMENT_MAX, LEARN_BUNDLE_MAX = 20_000, 5_000, 3_000_000
LEARN_MAX_TURNS = 60
LEARN_TIMEOUT = 40 * 60
LEARN_TOOLS = ("Read", "Glob", "Grep", "Edit", "Write")
# Files the guides may never name but merged PRs keep changing (a changelog, a ratchet list):
# the start of each is read like a guide, so a rule can quote it.
OFTEN_TEXT = GUIDE_TEXT + (".yml", ".yaml", ".toml", ".cfg", ".ini")
OFTEN_MAX_FILES = 8
OFTEN_EXCERPT = 12_000
LOCK_FILE = re.compile(r"[._-]lock\.(?:ya?ml|toml|txt)$|(?:^|/)requirements[^/]*\.txt$", re.I)
TEST_PATH = re.compile(r"(?:^|/)(?:tests?|__tests__|specs?)(?:/|$)|(?:^|/)test_[^/]*\.py$|_test\.[a-z]+$|"
                       r"\.(?:test|spec)\.[a-z]+$", re.I)
CLA_FILE = re.compile(r"(?:^|/)(?:\.contributors|CLA[^/]*)(?:/|$)", re.I)
LINK_RE = re.compile(r"\]\(\s*<?([^)\s>]+)")


def guide_match(path):
    """True when a repo path is one of the guide files a learn reads."""
    segs = path.lower().split("/")
    for g in GUIDE_GLOBS:
        gs = g.lower().split("/")
        if len(gs) == len(segs) and all(fnmatch.fnmatchcase(s, q) for s, q in zip(segs, gs)):
            return True
    return False


def guide_links(path, text):
    """Repo paths a guide's markdown links point to (relative, or from the root), without anchors."""
    out = []
    for t in LINK_RE.findall(text):
        t = t.split("#", 1)[0].split("?", 1)[0]
        if not t or re.match(r"[a-z][a-z0-9+.-]*:", t, re.I):
            continue
        q = posixpath.normpath(t.lstrip("/") if t.startswith("/") else posixpath.join(posixpath.dirname(path), t))
        if q not in out and q not in (".", "..") and not q.startswith("../"):
            out.append(q)
    return out


def merged_files(prs):
    """{path: how many merged PRs changed it}."""
    c = collections.Counter()
    for p in prs.values():
        if p.get("state") == "merged":
            c.update(set(p.get("files") or []))
    return c


def often_files(prs, guides):
    """Text files that at least 3 merged PRs (and a tenth of them) changed, not already a guide:
    [(path, count)], most changed first."""
    merged = sum(1 for p in prs.values() if p.get("state") == "merged")
    floor = max(3, -(-merged // 10))
    hits = [(q, k) for q, k in merged_files(prs).items()
            if k >= floor and q not in guides and q.lower().endswith(OFTEN_TEXT) and not LOCK_FILE.search(q)]
    return sorted(hits, key=lambda x: (-x[1], x[0]))[:OFTEN_MAX_FILES]


def test_dirs(prs):
    """Folders merged PRs put tests in: [(folder, how many merged PRs)], most first."""
    c = collections.Counter()
    for p in prs.values():
        if p.get("state") == "merged":
            c.update({posixpath.dirname(q) or "." for q in p.get("files") or [] if TEST_PATH.search(q)})
    return sorted(c.items(), key=lambda x: (-x[1], x[0]))[:10]


def rule_changes(prev, rules):
    """Plain lines saying how the rules changed from a previous profile.json."""
    old = {r.get("id"): r for r in ((prev or {}).get("rules") or []) if isinstance(r, dict) and isinstance(r.get("id"), str)}
    new = {r["id"]: r for r in rules}
    out = [f"added {i} ({new[i]['strength']}): {new[i]['text']}" for i in sorted(new.keys() - old.keys())]
    out += [f"removed {i}" for i in sorted(old.keys() - new.keys())]
    for i in sorted(new.keys() & old.keys()):
        a, b = old[i], new[i]
        what = [k for k in ("section", "strength", "text", "short", "why", "sources") if a.get(k) != b.get(k)]
        if what:
            out.append(f"changed {i}: its {', '.join(what)}")
    return out


def inside(path, root):
    """True when path (resolved, following symlinks) is root or below it."""
    p, r = os.path.realpath(path), os.path.realpath(root)
    return p == r or p.startswith(r + os.sep)


def c_free_gb():
    st = os.statvfs("/mnt/c")
    return st.f_bavail * st.f_frsize // (1 << 30)


def mem_avail_mb():
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) // 1024
    return 0


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, TypeError):
        return False
    except PermissionError:
        return True


def gc_running(path):
    """The pid in .git/gc.pid while that gc is alive on this host, else None. git itself treats
    a gc.pid older than 12 hours as stale, and so does this."""
    f = Path(path) / ".git" / "gc.pid"
    try:
        pid, host = f.read_text().split()[:2]
        pid = int(pid)
        if time.time() - f.stat().st_mtime > 12 * 3600 or host != socket.gethostname():
            return None
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return None
    except PermissionError:
        pass
    return pid


def stop_group(pgid, first=signal.SIGTERM, grace=30, log=None, proc=None):
    """Signal a process group, wait, then SIGKILL that group only. True if it is gone.
    proc is the leader's Popen when this process started it: a dead leader stays a zombie
    until reaped, and a group holding only a zombie still answers killpg, so it is polled
    (Popen keeps the exit code; a bare waitpid would steal it from a thread in proc.wait)."""
    if not pgid:
        return True

    def alive():
        if proc is not None:
            proc.poll()
        try:
            os.killpg(pgid, 0)
            return True
        except ProcessLookupError:
            return False

    for sig, wait in ((first, grace), (signal.SIGTERM, 15), (signal.SIGKILL, 5)):
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            return True
        deadline = time.time() + wait
        while time.time() < deadline:
            if not alive():
                return True
            time.sleep(0.5)
        if log:
            log(f"group {pgid} still alive after {sig.name}")
    return not alive()


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def gh_argv(args, repo):
    """Turn a session's gh request into a read-only argv, or refuse it."""
    if not isinstance(args, list) or not args or not all(isinstance(a, str) for a in args):
        return None, "args must be a list of strings"
    if any(len(a) > 400 or re.search(r"[\x00-\x1f]", a) for a in args):
        return None, "an argument is too long or has control characters"
    owner, name = repo.split("/", 1)
    if args[0] == "api":
        if len(args) < 2:
            return None, "gh api needs a path"
        path = args[1].lstrip("/")
        ok = rf"repos/{re.escape(owner)}/{re.escape(name)}/(issues|pulls)(/\d+)?" \
             r"(/(comments|files|commits|reviews|timeline|events|labels))?(\?[A-Za-z0-9_=&.-]*)?"
        if not re.fullmatch(ok, path):
            return None, "gh api path is not on the read list (issues and pulls of this repo)"
        out, i, rest = ["api", path, "--method", "GET"], 0, args[2:]
        while i < len(rest):
            a = rest[i]
            if a == "--paginate":
                out.append(a)
                i += 1
            else:
                return None, f"gh api flag {a!r} is not allowed"
        return out, ""
    if len(args) < 2 or (args[0], args[1]) not in GH_VERBS:
        return None, f"gh {' '.join(args[:2])} is not on the read-only list"
    out, i, rest = args[:2], 0, []
    for a in args[2:]:
        if a.startswith("--") and "=" in a:
            rest += a.split("=", 1)
        else:
            rest.append(a)
    foreign = re.compile(r"(?i)(\b(repo|org|user|owner)\s*:|github\.com|://)")
    while i < len(rest):
        a = rest[i]
        if a in ("--search", "-S") and i + 1 < len(rest) and foreign.search(rest[i + 1]):
            return None, f"gh {a} may not name a repo, org, user or URL; the driver scopes it to {repo}"
        if not a.startswith("-") and foreign.search(a):
            return None, f"gh argument {a!r} names a repo, org, user or URL; only {repo} is readable"
        if not a.startswith("-") and args[0] != "search" and not re.fullmatch(r"[A-Za-z0-9._/-]{1,200}", a):
            return None, f"gh argument {a!r} is not a number or branch name"
        if a in ("--repo", "-R") and i + 1 < len(rest):
            # The driver adds the repo itself; naming the same one is harmless.
            if rest[i + 1].lower() != repo.lower():
                return None, f"gh {a} names another repo; only {repo} is readable"
            i += 2
        elif a in GH_FLAGS_BARE:
            out.append(a)
            i += 1
        elif a in GH_FLAGS_VALUE and i + 1 < len(rest) and not rest[i + 1].startswith("-"):
            out += [a, rest[i + 1]]
            i += 2
        elif not a.startswith("-"):
            out.append(a)
            i += 1
        else:
            return None, f"gh flag {a!r} is not allowed"
    out += ["--repo", repo] if args[0] == "search" else ["-R", repo]
    return out, ""


class StopRun(Exception):
    pass


# Keys a profile's .env must set. A profile is in commands mode when it names TEST_CMD: the
# repo's own commands run its tests and checks. Otherwise it is in cargo mode (xerj).
BASE_KEYS = ("REPO_DIR", "UPSTREAM_REMOTE", "BASE_BRANCH", "CONTRIBUTOR")
CARGO_KEYS = ("GUARD", "YAML_DIR", "SERVER_BUILD", "SERVER_BIN", "RUNNER_BUILD", "RUNNER_BIN")
COMMAND_KEYS = ("GUARD", "SETUP_CMD", "SETUP_KEY", "TEST_CMD", "TEST_EXIT_PASS", "TEST_EXIT_FAIL")
CMD_SLOTS = {"env", "cache", "paths", "junit"}


def profile_problems(prof, base_only=False):
    """What is missing or malformed in a profile's .env, as sentences; empty when it is usable."""
    cmd = bool(prof.get("TEST_CMD", "").strip())
    need = list(BASE_KEYS) if base_only else [*BASE_KEYS, *(COMMAND_KEYS if cmd else CARGO_KEYS)]
    checks = prof.get("CHECKS", "").split()
    if cmd and not base_only:
        need += [f"CHECK_{n}" for n in checks]
    out = [f"{k} is missing or empty" for k in dict.fromkeys(need) if not prof.get(k, "").strip()]
    if not cmd or base_only:
        return out
    for k in ("TEST_EXIT_PASS", "TEST_EXIT_FAIL", "TEST_EXIT_NONE"):
        v = prof.get(k, "").strip()
        if v and not re.fullmatch(r"\d{1,3}", v):
            out.append(f"{k} is not an exit code: {v!r}")
    for n in checks:
        if not re.fullmatch(r"[A-Z][A-Z0-9_]{0,30}", n):
            out.append(f"CHECKS names {n!r}: a check name is capital letters, digits and _")
    for n in prof.get("GATE_CHECKS", "").split():
        if n not in checks:
            out.append(f"GATE_CHECKS names {n}, which is not in CHECKS")
    if "{paths}" not in shlex.split(prof.get("TEST_CMD", "")):
        out.append("TEST_CMD has no {paths} word")
    for p in prof.get("TOOLS", "").split():
        if not os.path.isabs(p):
            out.append(f"TOOLS names {p!r}, which is not an absolute path")
    for k in ("SETUP_CMD", "TEST_CMD", "JAIL_ENV", *[f"CHECK_{n}" for n in checks]):
        try:
            for w in shlex.split(prof.get(k, "")):
                bad = set(re.findall(r"\{(\w+)\}", w)) - CMD_SLOTS
                if bad:
                    out.append(f"{k} uses an unknown slot {{{sorted(bad)[0]}}}")
        except ValueError as e:
            out.append(f"{k} does not split into words: {e}")
    return out


def render_cmd(tpl, values, lists=None):
    """A profile command as argv. The template is split into words as a shell would, then a word
    that is exactly `{name}` for a list becomes that list's items, one argument each, and other
    `{name}` slots are filled with one string. Nothing runs it through a shell, so a value from a
    session is always data and never code."""
    lists = lists or {}
    argv = []
    for w in shlex.split(tpl):
        m = re.fullmatch(r"\{(\w+)\}", w)
        if m and m.group(1) in lists:
            argv += [str(x) for x in lists[m.group(1)]]
            continue

        def fill(x):
            if x.group(1) not in values:
                raise RuntimeError(f"command slot {{{x.group(1)}}} has no value here")
            return str(values[x.group(1)])
        argv.append(re.sub(r"\{(\w+)\}", fill, w))
    return argv


def junit_counts(path):
    """tests, failures, errors and skipped from a JUnit XML report, summed over its suites; None
    when there is no readable report. These are counts the runner wrote, read as facts."""
    import xml.etree.ElementTree as ET
    try:
        if os.path.getsize(path) > 50_000_000:
            return None
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return None
    suites = [root] if root.tag == "testsuite" else root.findall("testsuite")
    c = dict.fromkeys(("tests", "failures", "errors", "skipped"), 0)
    for s in suites:
        for k in c:
            try:
                c[k] += int(s.get(k, "0"))
            except ValueError:
                return None
    return c if suites else None


def has_report(prof):
    """Whether the profile's TEST_CMD writes a report the driver reads: {junit} in any word."""
    return any("{junit}" in w for w in shlex.split(prof.get("TEST_CMD", "")))


def gone_note(note):
    """A gate test whose note says no test matched (renamed or removed since it passed). Not a
    run whose tests were all skipped: that is a test switched off, never 'gone'."""
    return "no test ran" in str(note or "")


def issue_number(x):
    """The issue number a scout wrote, as an int; None when it wrote none; -1 when it wrote
    something that is not an issue number."""
    if x is None or x == "":
        return None
    if isinstance(x, bool):
        return -1
    if isinstance(x, int):
        return x if 0 < x < 10 ** 9 else -1
    m = re.fullmatch(r"#?(\d{1,9})", x.strip()) if isinstance(x, str) else None
    return int(m.group(1)) if m and int(m.group(1)) > 0 else -1


def judge_test(rc, counts, expect, prof, report=True):
    """Whether a commands-mode test run met its expectation, and why not. Facts only: the exit code
    against the profile's codes, then the report's counts when the command writes one
    (report=True); counts is None when it should have and did not."""
    ok_rc, fail_rc = int(prof["TEST_EXIT_PASS"]), int(prof["TEST_EXIT_FAIL"])
    none_rc = int(prof["TEST_EXIT_NONE"]) if prof.get("TEST_EXIT_NONE", "").strip() else None
    if expect == "any":
        return True, ""
    if none_rc is not None and rc == none_rc:
        return False, "no test ran: none was found; check the paths and the filter"
    if rc not in (ok_rc, fail_rc):
        return False, f"exit {rc} is neither the pass nor the fail code: an import, collection or usage error; read the log"
    if report and counts is None:
        return False, "the runner wrote no readable report, so the driver cannot count the tests"
    if expect == "pass":
        if rc != ok_rc:
            return False, "a test failed"
        if counts is not None and counts["tests"] - counts["skipped"] <= 0:
            return False, "every test it found was skipped, so nothing passed"
        return True, ""
    if rc != fail_rc:
        return False, "every test passed; nothing failed"
    if counts is not None and (counts["failures"] == 0 or counts["errors"] > 0):
        return False, "the run failed, but not by a test failing (errors in the report, or no failures)"
    return True, ""


# Claude Code makes its sandbox bridge sockets in the session's TMPDIR, named
# claude-socks-<16 hex>.sock (a slash plus 34 characters); a Unix socket path holds at most 107.
SOCK_NAME_ROOM, SOCK_PATH_MAX = 35, 107


class Driver:
    # Defaults for drivers built without __init__ (unit checks); __init__ sets them from the profile.
    commands = False
    assign_first = False
    env_dir = None
    last_counts = None

    def __init__(self, args):
        self.args = args
        self.t_start = time.time()
        self.answer_cand = None
        self.repo = args.repo
        pdir = Path(os.environ.get("CONTRIB_PROFILE_DIR", SKILL / "profiles"))
        self.prof = load_env(pdir / f"{self.repo.replace('/', '-')}.env")
        self.prof_md, self.rules_from = self.load_profile(pdir)
        if self.prof_md is None and not (getattr(args, "learn", False) or getattr(args, "approve_profile", None)
                                         or args.commit_ledger):
            print(f"no profile for {self.repo}: run --learn, read its PROFILE-REVIEW.md, then --approve-profile ID",
                  file=sys.stderr)
            sys.exit(2)
        probs = profile_problems(self.prof, base_only=bool(getattr(args, "learn", False) or getattr(args, "approve_profile", None)
                                                           or args.commit_ledger))
        if probs:
            print(f"profile {pdir / (self.repo.replace('/', '-') + '.env')} is not usable: " + "; ".join(probs),
                  file=sys.stderr)
            sys.exit(2)
        self.commands = bool(self.prof.get("TEST_CMD", "").strip())
        self.assign_first = self.prof.get("ASSIGN_FIRST", "").strip() == "1"
        self.env_dir = None
        self.last_counts = None
        self.repo_dir = Path(self.prof["REPO_DIR"])
        self.upstream = f"{self.prof['UPSTREAM_REMOTE']}/{self.prof['BASE_BRANCH']}"
        for d in (LEDGER / "candidates", LEDGER / "runs", WORK / "bins", WORK / "clones", WORK / "bin", WORK / "nodes", WORK / "tmp",
                  WORK / "targets", WORK / "cargo-home"):
            d.mkdir(parents=True, exist_ok=True)
        if not (LEDGER / "rejects.md").exists():
            (LEDGER / "rejects.md").write_text("# Rejected candidates\n\n")
        self.lockf = open(LEDGER / ".run.lock", "w")
        try:
            fcntl.flock(self.lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            if not getattr(args, "approve_profile", None):
                print("another contrib-run holds the ledger lock; not starting", file=sys.stderr)
                sys.exit(EXIT_BUSY)
            print("a run holds the ledger lock; waiting for it to finish before approving", file=sys.stderr, flush=True)
            fcntl.flock(self.lockf, fcntl.LOCK_EX)
        self.run_id = datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S")
        self.run_dir = LEDGER / "runs" / self.run_id
        self.run_dir.mkdir(parents=True, exist_ok=True)
        self.logf = open(LEDGER / "runs" / f"{self.run_id}.log", "a")
        self.deadline = time.time() + args.hours * 3600
        self.stop_kind = None
        self.stop_reason = None
        self.lock = threading.RLock()
        self.current = {}            # role -> pgid of what is running now
        self.started = set()         # every process group this run started
        self.cand = None             # candidate folder being worked (driver-owned)
        self.target_name = None      # retest builds into its own target dir
        # Sessions cannot see ~/.gitconfig, so the driver hands them the user's commit identity.
        ident = {}
        for k, a, c in (("user.name", "GIT_AUTHOR_NAME", "GIT_COMMITTER_NAME"),
                        ("user.email", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_EMAIL")):
            v = subprocess.run(["git", "config", "--global", k], capture_output=True, text=True).stdout.strip()
            if v:
                ident[a] = ident[c] = v
        self.identity = ident
        # xq lives in the skill folder, which sessions cannot read; they run this copy instead.
        copy_regular(SKILL / "bin" / "xq", WORK / "bin" / "xq")
        self.failures_in_row = 0
        self.guard_kills = 0
        self.low_mem_since = None
        self.done = []

    # ----- paths ----------------------------------------------------------------------
    @property
    def sdir(self):
        """The one folder of the candidate a session may write."""
        return self.cand / "session"

    def st(self):
        return read_json(self.cand / "state.json", {}) if self.cand else {}

    def clone(self):
        return WORK / "clones" / self.cand.name

    def bins(self):
        return WORK / "bins" / self.cand.name

    # ----- logging and stop control -------------------------------------------------
    def log(self, msg):
        line = f"{now()} {msg}"
        try:
            print(line, flush=True)
        except OSError:
            pass
        try:
            self.logf.write(line + "\n")
            self.logf.flush()
        except OSError:
            pass

    def request_stop(self, kind, reason):
        with self.lock:
            if self.stop_kind == "hard" or (self.stop_kind == "soft" and kind == "soft"):
                return
            first = self.stop_kind is None
            self.stop_kind, self.stop_reason = kind, reason
        if first or kind == "hard":
            self.log(f"STOP ({kind}): {reason}")
        if kind == "hard":
            threading.Thread(target=self.interrupt_current, daemon=True).start()

    def interrupt_current(self):
        for role, pgid in list(self.current.items()):
            first = signal.SIGINT if role == "session" else signal.SIGTERM
            grace = 60 if role == "session" else 30
            self.log(f"interrupting {role} (group {pgid})")
            if not stop_group(pgid, first, grace, self.log):
                self.survived = True

    guard_blocked = False     # set when the build guard refuses to start: no request can run
    survived = False          # set when a stopped process group was still there after SIGKILL
    cut_note = ""             # names the requests run_requests skipped, for the session's next prompt

    def check_stop(self, between=False):
        if between:
            # Between steps, read the stop files now rather than waiting for the watchdog's tick.
            if (LEDGER / "STOP-NOW").exists():
                self.request_stop("hard", "STOP-NOW file")
            elif (LEDGER / "STOP").exists():
                self.request_stop("soft", "STOP file")
        if self.stop_kind == "hard" or (between and self.stop_kind == "soft"):
            raise StopRun()

    def watchdog(self):
        while True:
            time.sleep(self.args.tick)
            try:
                if (LEDGER / "STOP-NOW").exists():
                    self.request_stop("hard", "STOP-NOW file")
                elif (LEDGER / "STOP").exists():
                    self.request_stop("soft", "STOP file")
                gb = c_free_gb()
                if gb < HARD_DISK_GB:
                    self.request_stop("hard", f"C: free {gb} GB (hard floor {HARD_DISK_GB})")
                elif gb < SOFT_DISK_GB and not (self.args.stub and not self.args.real_requests):
                    self.request_stop("soft", f"C: free {gb} GB (soft floor {SOFT_DISK_GB})")
                mem = mem_avail_mb()
                if mem < HARD_MEM_MB:
                    self.low_mem_since = self.low_mem_since or time.time()
                    if time.time() - self.low_mem_since > HARD_MEM_SECS:
                        self.request_stop("hard", f"MemAvailable {mem} MB for over {HARD_MEM_SECS}s")
                else:
                    self.low_mem_since = None
                if time.time() > self.deadline:
                    self.request_stop("hard", "deadline passed")
                elif self.deadline - time.time() < STAGE_BUDGET:
                    self.request_stop("soft", "deadline less than one stage away")
            except Exception as e:      # the watchdog must never die
                self.log(f"watchdog error: {e}")

    def on_signal(self, signum, _frame):
        self.request_stop("hard", f"signal {signal.Signals(signum).name}")

    # ----- subprocess helpers ---------------------------------------------------------
    def run_tracked(self, role, cmd, cwd=None, env=None, timeout=None, out=None, err_apart=False):
        """Run in its own process group, tracked so a hard stop can interrupt it."""
        fh = open(out, "w") if out else subprocess.DEVNULL
        eh = open(str(out) + ".err", "w") if (out and err_apart) else subprocess.STDOUT
        p = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=fh, stderr=eh,
                             start_new_session=True, text=True, encoding="utf-8", errors="replace", preexec_fn=die_with_driver)
        self.current[role] = p.pid
        self.started.add(p.pid)
        self.last_timed_out = False   # tells a 124 from this time limit apart from a command's own 124
        try:
            try:
                rc = p.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                self.log(f"{role} timed out after {timeout}s")
                if not stop_group(p.pid, signal.SIGTERM, 30, self.log, proc=p):
                    self.survived = True
                rc = 124
                self.last_timed_out = True
            try:                      # anything it left running in its group goes too
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        finally:
            self.current.pop(role, None)
            self.started.discard(p.pid)
            if out:
                fh.close()
                if err_apart:
                    eh.close()
        return rc

    def git_env(self):
        env = dict(os.environ)
        for k in list(env):
            if k.startswith("GIT_"):
                env.pop(k)
        env.update({"GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_TERMINAL_PROMPT": "0"})
        env.update(getattr(self, "identity", {}) or {})
        return env

    def git(self, *a, cwd=None, check=True, env=None, timeout=1800):
        cmd = ["git", *GIT_SAFE, "-C", str(cwd or self.repo_dir), *a]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace",
                               env=env or self.git_env(), timeout=timeout)
        except subprocess.TimeoutExpired:
            raise RuntimeError(f"git {' '.join(a[:4])}: no answer after {timeout} s")
        if check and r.returncode:
            raise RuntimeError(f"git {' '.join(a[:4])}: {r.stderr.strip()[:300]}")
        return r.stdout.strip()

    @staticmethod
    def gh_env():
        """gh needs its config and PATH, nothing else from the driver's environment."""
        env = {k: os.environ[k] for k in ("PATH", "HOME", "LANG", "LC_ALL", "XDG_CONFIG_HOME", "GH_CONFIG_DIR")
               if k in os.environ}
        env.update(GH_PROMPT_DISABLED="1", GH_NO_UPDATE_NOTIFIER="1", BROWSER="false", NO_COLOR="1")
        return env

    def gh(self, *a):
        env = self.gh_env()
        r = subprocess.run(["gh", *a], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=300, env=env)
        if r.returncode:
            raise RuntimeError(f"gh {' '.join(a[:3])}: {r.stderr.strip()[:300]}")
        return r.stdout

    # ----- environment for sessions -------------------------------------------------
    def headless_env(self):
        # An allowlist, not a denylist: a run started from inside a Claude Code session or a
        # shell with exported tokens passes none of that on.
        env = {k: v for k, v in os.environ.items() if k in SAFE_ENV or k.startswith("LC_")}
        if self.args.stub:
            # Test mode only: the stub reads its knobs from STUB_* and writes a fake transcript.
            env.update({k: v for k, v in os.environ.items()
                        if k.startswith("STUB_") or k == "CONTRIB_TRANSCRIPTS"})
        env.update({
            "XERJ_DISABLE_FEEDBACK": "true",
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_CONFIG_NOSYSTEM": "1",
            # ~/.gitconfig is hidden from sessions, and git treats an unreadable one as fatal.
            "GIT_CONFIG_GLOBAL": "/dev/null",
            # An empty credential.helper resets the helper list: git has no credentials.
            "GIT_CONFIG_COUNT": "3",
            "GIT_CONFIG_KEY_0": "credential.helper", "GIT_CONFIG_VALUE_0": "",
            "GIT_CONFIG_KEY_1": "core.hooksPath", "GIT_CONFIG_VALUE_1": "/dev/null",
            "GIT_CONFIG_KEY_2": "core.fsmonitor", "GIT_CONFIG_VALUE_2": "false",
            "CONTRIB_CANDIDATE_DIR": str(self.cand) if self.cand else "",
            "PATH": f"{WORK / 'bin'}:{env.get('PATH', '')}",
            # ~/.gitconfig is hidden from sessions, so they commit under these names.
            **self.identity,
        })
        return env

    def claude_env(self):
        env = self.headless_env()
        if TOKEN_FILE.exists():
            env["CLAUDE_CODE_OAUTH_TOKEN"] = TOKEN_FILE.read_text().strip()
        return env

    # ----- the jail -------------------------------------------------------------------
    def jail(self, inner, *, net=False, rw=(), ro=(), over=(), chdir=None, env=None, argv=()):
        """bwrap argv: root read-only, home, /tmp, /run and /mnt replaced by empty tmpfs, then
        only the listed paths bound back: ro, then rw, then `over`, read-only (src, dest) binds
        laid on top. No network unless net. Session code runs here."""
        a = ["bwrap", "--die-with-parent", "--new-session", "--unshare-pid", "--unshare-ipc",
             "--unshare-uts", "--unshare-cgroup-try"]
        if not net:
            a.append("--unshare-net")
        a += ["--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp", "--tmpfs", "/run",
              "--tmpfs", "/mnt", "--tmpfs", str(HOME)]
        for p in (HOME / ".rustup", HOME / ".cargo" / "bin", *map(Path, ro)):
            a += ["--ro-bind", str(p), str(p)]
        for p in rw:
            a += ["--bind", str(p), str(p)]
        for src, dest in over:
            a += ["--ro-bind", str(src), str(dest)]
        e = {"PATH": f"{HOME}/.cargo/bin:/usr/local/bin:/usr/bin:/bin", "HOME": str(HOME),
             "RUSTUP_HOME": str(HOME / ".rustup"), "RUSTUP_TOOLCHAIN": self.prof.get("RUST_TOOLCHAIN", "stable"),
             "CARGO_HOME": str(WORK / "cargo-home"), "CARGO_TARGET_DIR": str(self.target_dir()),
             "CC": "/usr/bin/cc", "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "/usr/bin/cc",
             "CARGO_BUILD_JOBS": "4", "RUST_TEST_THREADS": "4", "TMPDIR": "/tmp", "XERJ_DISABLE_FEEDBACK": "true",
             "LANG": "C.UTF-8", "TERM": "dumb", "CARGO_TERM_COLOR": "never", "RUSTUP_AUTO_INSTALL": "0"}
        if not net:
            e["CARGO_NET_OFFLINE"] = "true"
        e.update(env or {})
        a.append("--clearenv")
        for k, v in e.items():
            a += ["--setenv", k, str(v)]
        if chdir:
            a += ["--chdir", str(chdir)]
        return a + ["bash", "-c", inner, "jail", *argv]

    def target_dir(self):
        """Each candidate builds into its own target dir: code one candidate's tests run cannot
        plant artifacts another candidate links. Removed when the candidate is finished."""
        return WORK / "targets" / (self.target_name or (self.cand.name if self.cand else "_none"))

    def git_dir_check(self, keep=None):
        """The clone's .git must still be a plain, self-contained repository before git runs on
        it or the driver binds it: a session can write .git, and git follows commondir,
        alternates and symlinked object or ref folders to other repositories on the machine.
        The host checks a copy (git_copy), never the live .git by path. With keep (a use such as
        "save" or "build") the checked copy is kept and returned; otherwise it is removed."""
        snap = self.git_copy(keep or "check")
        try:
            g = self.clone() / ".git"
            where = self.cgit("rev-parse", "--absolute-git-dir", check=False)
            if where != str(g):
                raise RuntimeError(f"git in the clone resolves its git dir to {where!r}, not {g}. Clone kept for a look")
        except BaseException:
            self.drop_copy(snap)
            raise
        if keep:
            return snap
        self.drop_copy(snap)
        return None

    def git_copy(self, use):
        """A checked hard-link copy of the clone's .git in WORK/snap/<slug>.<use>, a folder no
        session can write. A session process still running could swap any name in .git between
        a check and a use, so the host never checks or fetches from the live .git by path: copy_git_dir copies it
        by handle, and only the copy is checked, fetched from or bound into a jail."""
        snap = WORK / "snap" / f"{self.cand.name}.{use}"
        self.remove_snap(snap)
        snap.parent.mkdir(parents=True, exist_ok=True)
        try:
            self.copy_git_dir(self.clone(), snap)
            self.check_git_tree(snap)
        except BaseException:
            self.drop_copy(snap)
            raise
        return snap

    def drop_copy(self, snap):
        try:
            self.remove_snap(snap)
        except (OSError, RuntimeError):
            pass          # the next copy's remove_snap refuses before copying anything

    @staticmethod
    def check_git_tree(g):
        """Plain folders and regular files only, every folder listable, nothing that points git at
        another repository. Raises with the offending path."""
        if not stat.S_ISDIR(os.lstat(g).st_mode):
            raise RuntimeError(f"{g} is not a plain directory. Clone kept for a look")
        for rel in ("commondir", "gitdir", "objects/info/alternates", "objects/info/http-alternates"):
            if os.path.lexists(g / rel):
                raise RuntimeError(f"{g / rel} exists; a candidate clone never has one. Clone kept for a look")

        cfg = g / "config"
        if os.path.lexists(cfg):
            if not stat.S_ISREG(os.lstat(cfg).st_mode):
                raise RuntimeError(f"{cfg} is not a regular file. Clone kept for a look")
            r = subprocess.run(["git", "config", "--file", str(cfg), "--no-includes", "--name-only", "--list"],
                               capture_output=True, text=True, errors="replace", timeout=30,
                               env={"PATH": "/usr/bin:/bin", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"})
            if r.returncode:
                raise RuntimeError(f"{cfg} does not parse. Clone kept for a look")
            inc = [k for k in r.stdout.split() if k.lower().startswith(("include.", "includeif."))]
            if inc:
                raise RuntimeError(f"{cfg} sets {inc[0]}; a candidate clone never includes other config")

        def unreadable(e):
            raise RuntimeError(f"cannot list {e.filename}: {e.strerror}. Clone kept for a look")

        for root, dirs, files in os.walk(g, followlinks=False, onerror=unreadable):
            for name in dirs + files:
                q = Path(root) / name
                m = os.lstat(q).st_mode
                if stat.S_ISLNK(m):
                    raise RuntimeError(f"{q} is a symlink. Clone kept for a look")
                if stat.S_ISDIR(m):
                    if m & 0o500 != 0o500:
                        raise RuntimeError(f"{q} is not readable and searchable. Clone kept for a look")
                elif not stat.S_ISREG(m):
                    raise RuntimeError(f"{q} is not a regular file (a FIFO, socket or device). Clone kept for a look")

    def fetch_from_clone(self, refspec, check=True):
        """The only way objects leave a candidate clone. A session process may still be changing
        .git, and git reads whatever the path holds when it opens it, so the host never reads the
        clone's .git: it hard-links a copy into a folder no session can write (links share file
        contents, never file types or names; see copy_git_dir), checks the copy, swaps in a
        minimal config so the session's settings (includes, partial clone, pack limits) cannot
        steer the host, and fetches from the copy with upload-pack --strict, object checks and a
        time limit."""
        snap = self.git_dir_check(keep="save")
        try:
            (snap / "config").unlink(missing_ok=True)
            (snap / "config").write_text("[core]\n\trepositoryformatversion = 0\n\tbare = true\n")
            return self.git("-c", "transfer.fsckObjects=true", "fetch", "-q", "--no-tags", "--upload-pack",
                            "git-upload-pack --strict", str(snap), refspec, check=check, timeout=600)
        finally:
            self.drop_copy(snap)

    @staticmethod
    def copy_git_dir(clone, snap):
        """Hard-link copy of clone/.git into a new folder snap. cp looks every path up again by
        name, so a folder a live session swaps for a symlink mid-copy would be followed and host
        files linked in. Here every folder is opened by handle, relative to its parent, with
        O_NOFOLLOW, and checked to be the one just looked at: a symlink is refused at any moment,
        never followed. Folders are made here (mode 0700, so the copy can always be removed);
        only regular files are linked, and a name that changed between look and link raises."""
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
        count = 0

        def opendir(name, dir_fd, what, want=None):
            try:
                fd = os.open(name, flags, dir_fd=dir_fd)
            except OSError as e:
                raise RuntimeError(f"cannot open {what}: {e.strerror}. Clone kept for a look") from None
            st = os.fstat(fd)
            if want is not None and (st.st_dev, st.st_ino) != want:
                os.close(fd)
                raise RuntimeError(f"{what} changed during the copy. Clone kept for a look")
            return fd

        def walk(sfd, dfd, rel, depth):
            nonlocal count
            if depth > SNAP_MAX_DEPTH:
                raise RuntimeError(f"{rel} is nested deeper than {SNAP_MAX_DEPTH} folders. Clone kept for a look")
            try:
                names = os.listdir(sfd)
            except OSError as e:
                raise RuntimeError(f"cannot list {rel}: {e.strerror}. Clone kept for a look") from None
            for name in names:
                count += 1
                if count > SNAP_MAX_ENTRIES:
                    raise RuntimeError(f"the clone's .git has more than {SNAP_MAX_ENTRIES} entries. Clone kept for a look")
                what = f"{rel}/{name}"
                try:
                    st = os.stat(name, dir_fd=sfd, follow_symlinks=False)
                except OSError as e:
                    raise RuntimeError(f"cannot look at {what}: {e.strerror}. Clone kept for a look") from None
                if stat.S_ISDIR(st.st_mode):
                    os.mkdir(name, 0o700, dir_fd=dfd)
                    c = opendir(name, sfd, what, (st.st_dev, st.st_ino))
                    try:
                        d = opendir(name, dfd, f"the copy of {what}")
                        try:
                            walk(c, d, what, depth + 1)
                        finally:
                            os.close(d)
                    finally:
                        os.close(c)
                elif stat.S_ISREG(st.st_mode):
                    try:
                        os.link(name, name, src_dir_fd=sfd, dst_dir_fd=dfd, follow_symlinks=False)
                        got = os.stat(name, dir_fd=dfd, follow_symlinks=False)
                    except OSError as e:
                        raise RuntimeError(f"cannot link {what}: {e.strerror}. Clone kept for a look") from None
                    if not stat.S_ISREG(got.st_mode) or (got.st_dev, got.st_ino) != (st.st_dev, st.st_ino):
                        raise RuntimeError(f"{what} changed during the copy. Clone kept for a look")
                elif stat.S_ISLNK(st.st_mode):
                    raise RuntimeError(f"{what} is a symlink. Clone kept for a look")
                else:
                    raise RuntimeError(f"{what} is not a regular file (a FIFO, socket or device). Clone kept for a look")

        cfd = opendir(str(clone), None, str(clone))
        try:
            g = f"{clone}/.git"
            try:
                st = os.stat(".git", dir_fd=cfd, follow_symlinks=False)
            except OSError as e:
                raise RuntimeError(f"cannot look at {g}: {e.strerror}. Clone kept for a look") from None
            if not stat.S_ISDIR(st.st_mode):
                raise RuntimeError(f"{g} is not a plain directory. Clone kept for a look")
            sfd = opendir(".git", cfd, g, (st.st_dev, st.st_ino))
            try:
                os.mkdir(snap, 0o700)
                dfd = opendir(str(snap), None, str(snap))
                try:
                    walk(sfd, dfd, g, 0)
                finally:
                    os.close(dfd)
            finally:
                os.close(sfd)
        finally:
            os.close(cfd)

    @staticmethod
    def remove_snap(snap):
        """Remove a snap copy, or a symlink or file left in its place (an older copy step could
        leave one). rmtree refuses a symlink, and ignore_errors once hid that and left it for
        the next copy to follow, so unlink those. Raises if anything is left."""
        try:
            if os.path.islink(snap) or (os.path.lexists(snap) and not os.path.isdir(snap)):
                os.unlink(snap)
            elif os.path.lexists(snap):
                shutil.rmtree(snap)
        except OSError as e:
            raise RuntimeError(f"could not clear {snap}: {e.strerror}. Clone kept for a look") from None
        if os.path.lexists(snap):
            raise RuntimeError(f"could not clear {snap}. Clone kept for a look")

    def cgit(self, *a, check=True, index=False):
        """git on the candidate clone, in a no-network jail that sees only the clone. The clone's
        config is writable by the session (filters, includes, commondir), so no driver git command
        may run it on the host. Objects leave the clone only by a fetch into the pipeline clone,
        whose upload-pack side does not run the served repository's config."""
        dst = self.clone()
        env = {"GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_TERMINAL_PROMPT": "0",
               "GIT_AUTHOR_NAME": "contrib-run", "GIT_AUTHOR_EMAIL": "contrib-run@localhost",
               "GIT_COMMITTER_NAME": "contrib-run", "GIT_COMMITTER_EMAIL": "contrib-run@localhost"}
        if index:
            env["GIT_INDEX_FILE"] = str(dst / ".git" / "contrib-index")
        argv = self.jail('exec git "$@"', rw=(dst,), chdir=dst, env=env, argv=(*GIT_SAFE, "-C", str(dst), *a))
        r = subprocess.run(argv, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=600, preexec_fn=die_with_driver)
        if check and r.returncode:
            raise RuntimeError(f"git {' '.join(a[:4])}: {r.stderr.strip()[:300]}")
        return r.stdout.strip()

    def git_ok(self, *a):
        return subprocess.run(["git", *GIT_SAFE, "-C", str(self.repo_dir), *a], capture_output=True,
                              env=self.git_env()).returncode == 0

    def guarded(self, rid, argv, retries=None):
        """Run argv (usually a jail) under the build guard: one at a time, memory and disk kills."""
        out = self.cand / "results" / f"{rid}.log"
        if self.args.stub and not self.args.real_requests:
            out.write_text(f"[stub] would run: {shlex.join(argv)[:4000]}\n")
            return 0, out
        status = self.cand / "results" / f".{rid}.guard"
        status.unlink(missing_ok=True)
        env = dict(os.environ, CARGO_TARGET_DIR=str(self.target_dir()), LOCK_WAIT="3600", GUARD_STATUS=str(status))
        if retries is not None:
            env["RETRIES"] = str(retries)
        rc = self.run_tracked("build", [self.prof["GUARD"], shlex.join(argv)], env=env, timeout=REQUEST_TIMEOUT,
                              out=out)
        said = status.read_text().strip() if status.is_file() else ""
        status.unlink(missing_ok=True)
        if rc in (97, 98, 99) and not said:
            # The command's own exit code, passed through by the guard: not the machine's.
            with open(out, "a") as f:
                f.write(f"\n[driver] exit {rc} came from the command, not the guard; recorded as exit 1\n")
            rc = 1
        elif rc == 124 and not self.last_timed_out:
            # Only the driver's own time limit makes 124 a machine problem.
            with open(out, "a") as f:
                f.write("\n[driver] exit 124 came from the command, not the time limit; recorded as exit 1\n")
            rc = 1
        if rc == 98:
            self.guard_kills += 1
            if self.guard_kills >= 2:
                self.request_stop("hard", "the build guard killed two runs for memory or disk")
        if rc == 99 and said.startswith("not-started"):
            # The guard did not start the build: low disk, low memory or another build holding
            # the lock for an hour. Nothing after this would get further.
            self.guard_blocked = True
            self.request_stop("soft", "the build guard could not start a build: " + one_line(
                (out.read_text(errors="replace").strip().splitlines() or ["no reason given"])[-1], 160))
        return rc, out

    def engine_dir(self):
        return self.clone() / self.prof.get("CRATE_ROOT", ".")

    def cargo_jail(self, inner, extra_rw=(), over=(), env=None, argv=()):
        """Builds and tests: the clone and this candidate's target dir writable; the crate cache
        and the clone's .git read-only, so session code cannot poison later builds or change
        the repository's config and refs while it runs.
        bwrap resolves a bind's source when the jail starts, which can be long after a check
        (the guard may wait for its lock), and a .git swapped for a symlink by then would bind
        whatever it points at; `../../..` from the clone is the home folder, read-only, with the
        token. So the jail binds a checked copy (git_dir_check keep="build"), whose path no
        session can change. A destination swapped by then can only make bwrap refuse to start the
        jail or put the copy elsewhere inside it; either way the copy is all it binds."""
        src = self.git_dir_check(keep="build")
        t = self.target_dir()
        t.mkdir(parents=True, exist_ok=True)
        (WORK / "cargo-home").mkdir(parents=True, exist_ok=True)
        g = self.clone() / ".git"
        return self.jail(inner, rw=(self.clone(), t, *extra_rw), ro=(WORK / "cargo-home",),
                         over=((src, g), *over), chdir=self.engine_dir(), env=env, argv=argv)

    def ensure_fetched(self, rid):
        """Download crates for the base commit's Cargo.lock, never the session's. The fetch jail
        has network, so it sees only upstream files exported from the pipeline clone. A candidate
        that adds a dependency fails its offline build, and the session is told why."""
        base = self.st()["base_sha"]
        if not re.fullmatch(r"[0-9a-f]{40}", base or ""):
            raise RuntimeError("state.json base_sha is not a commit id")
        root = self.prof.get("CRATE_ROOT", ".")
        lock_id = self.git("rev-parse", "--verify", "--quiet", f"{base}:{root}/Cargo.lock", check=False) or base
        home = WORK / "cargo-home"
        home.mkdir(parents=True, exist_ok=True)
        stamp = home / ".fetched-locks"
        if lock_id in (stamp.read_text().split() if stamp.is_file() else []):
            return 0
        exp = WORK / "tmp" / f"fetch-{lock_id[:12]}"
        shutil.rmtree(exp, ignore_errors=True)
        exp.mkdir(parents=True)
        try:
            if not (self.args.stub and not self.args.real_requests):
                r = subprocess.run(f"git {shlex.join(GIT_SAFE)} -C {shlex.quote(str(self.repo_dir))} archive {base}"
                                   f" | tar -x -C {shlex.quote(str(exp))}", shell=True, capture_output=True,
                                   text=True, encoding="utf-8", errors="replace", env=self.git_env())
                if r.returncode:
                    self.log(f"export of {base[:12]} for cargo fetch failed: {one_line(r.stderr, 200)}")
                    return 1
            argv = self.jail("cargo fetch --locked", net=True, rw=(home,), ro=(exp,), chdir=exp / root)
            rc, _ = self.guarded(f"{rid}-fetch", argv, retries=0)
        finally:
            shutil.rmtree(exp, ignore_errors=True)
        if rc == 0:
            with open(stamp, "a") as f:
                f.write(lock_id + "\n")
        return rc

    # ----- preflight -----------------------------------------------------------------
    def preflight(self):
        self.log(f"run {self.run_id}: repo {self.repo}, limit {self.args.limit}, "
                 f"deadline {datetime.datetime.fromtimestamp(self.deadline).isoformat(timespec='minutes')}")
        self.log(f"profile: {self.rules_from}")
        self.recover_stale()
        # Session scratch folders left by a run that did not finish (the run lock means none is
        # in use); a resumed session needs only its transcript, not its scratch files.
        for d in (WORK / "tmp").glob("*"):
            if d.is_dir() and not d.is_symlink() and re.fullmatch(r"(scout|cand|session|learn)-[\w.-]+", d.name):
                shutil.rmtree(d, ignore_errors=True)
        # Build folders are kept only for candidates that will continue (needs-you, stopped).
        keep = {Path(st["_dir"]).name for st in self.all_states()
                if st.get("status") in ("needs-you", "stopped", "running")}
        for base in (WORK / "targets", WORK / "bins"):
            for d in base.glob("*"):
                if d.is_dir() and not d.is_symlink() and d.name not in keep and re.fullmatch(r"[\w.-]+", d.name):
                    shutil.rmtree(d, ignore_errors=True)
        # Checked .git copies (git_copy) are remade on every use, so any left now is stale; a
        # stopped candidate's build copy would otherwise keep its removed clone's packs on disk.
        for d in (WORK / "snap").glob("*"):
            self.drop_copy(d)
        self.trim_kept_builds()
        self.ensure_ledger_ignores()
        gb = c_free_gb()
        self.session_tmp(self.run_dir / "scout", make=False)   # the longest scratch path fits the sockets
        if gb < int(self.prof.get("START_GB", 32)) and not (self.args.stub and not self.args.real_requests):
            raise RuntimeError(f"C: has {gb} GB free, below the {self.prof.get('START_GB', 32)} GB start floor")
        if not shutil.which(self.args.claude):
            raise RuntimeError(f"{self.args.claude} not found")
        if not shutil.which("bwrap") or not shutil.which("socat"):
            raise RuntimeError("bubblewrap or socat missing: the sandbox and the jails cannot run")
        for rem in self.git("remote", check=False).split():
            if self.git("remote", "get-url", "--push", rem) != "no_push":
                raise RuntimeError(f"remote {rem} of {self.repo_dir} can push; set its push URL to no_push")
        self.refuse_shallow()
        self.repo_gc(self.repo_dir)
        self.repo_gc(LEDGER)
        if self.args.stub:
            self.log("preflight ok (stub)")
            return
        self.gh("auth", "status")
        fork = f"https://github.com/{self.prof['CONTRIBUTOR']}/{self.repo.split('/')[1]}.git"
        r = subprocess.run(["git", "-C", str(self.repo_dir), "push", "--dry-run", fork,
                            f"HEAD:refs/heads/contrib-preflight-{self.run_id}"],
                           capture_output=True, text=True, encoding="utf-8", errors="replace", env=self.headless_env(), timeout=120)
        if r.returncode == 0:
            raise RuntimeError("a headless push dry-run succeeded; credentials are reachable")
        self.git("fetch", "--quiet", self.prof["UPSTREAM_REMOTE"], self.prof["BASE_BRANCH"])
        if not TOKEN_FILE.exists():
            raise RuntimeError(f"no token at {TOKEN_FILE}; run `claude setup-token` and save it there")
        if TOKEN_FILE.stat().st_mode & 0o077:
            raise RuntimeError(f"{TOKEN_FILE} is readable by others; chmod 600 it")
        settings = self.run_dir / "settings-preflight.json"
        write_json(settings, self.settings_for([self.run_dir / "preflight"], None))
        (self.run_dir / "preflight").mkdir(exist_ok=True)
        cmd = self.claude_cmd("Reply with the single word: ok", "haiku", settings, [self.run_dir / "preflight"],
                              None, "") + ["--no-session-persistence"]
        r = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", env=self.claude_env(), stdin=subprocess.DEVNULL,
                           timeout=180, cwd=str(self.run_dir / "preflight"))
        if r.returncode or '"is_error":true' in r.stdout.replace(" ", ""):
            raise RuntimeError("claude cannot start a sandboxed session: " + (r.stdout + r.stderr).strip()[-300:])
        self.log("preflight ok")

    def repo_gc(self, path, timeout=1800):
        """Automatic gc is off for every driver git command (GIT_SAFE) and, from the first run on,
        in the pipeline clone's and the ledger's own config, so other tools (contrib-check, a fetch
        by hand) do not start one there either. gc runs here instead: in the foreground, in its own
        process group (a time limit or a hard stop ends all of it, children included), before this
        run reads the repository, and only when git's own limits say it is due. A gc that fails is
        logged and the run goes on; one already running, or one that runs out of time, stops it."""
        path = Path(path)
        if not (path / ".git").is_dir():
            return
        self.git("config", "gc.auto", "0", cwd=path)
        self.git("config", "maintenance.auto", "false", cwd=path)
        live = gc_running(path)
        if live:
            raise RuntimeError(f"a git gc is running in {path} (pid {live}); start the run once it has finished")
        out = self.run_dir / f"gc-{path.name}.log"
        rc = self.run_tracked("gc", ["git", *GIT_SAFE, "-C", str(path), "-c", "gc.auto=6700",
                                     "-c", "gc.autoPackLimit=50", "-c", "gc.autoDetach=false",
                                     "gc", "--auto", "--quiet"],
                              env=self.git_env(), timeout=timeout, out=out)
        if self.last_timed_out:
            raise RuntimeError(f"git gc in {path} did not finish in {timeout} s and was stopped")
        tail = out.read_text(errors="replace").strip()[-300:] if out.exists() else ""
        out.unlink(missing_ok=True)
        if rc:
            self.log(f"git gc in {path} failed (exit {rc}); the run goes on, but the repository "
                     f"needs a look: {tail}")

    def open_count(self):
        if self.args.stub:
            mine = 0
        else:
            mine = len(json.loads(self.gh("pr", "list", "-R", self.repo, "--author", self.prof["CONTRIBUTOR"],
                                          "--state", "open", "--json", "number", "--limit", "100")))
        ready = sum(1 for s in self.all_states() if s.get("status") == "ready")
        return mine, ready

    # ----- ledger --------------------------------------------------------------------
    def trim_kept_builds(self):
        """A needs-you candidate keeps its build folder so an answer does not cost a cold build.
        Those folders go once they are KEEP_BUILD_DAYS old, and oldest first while C: is below the
        start floor; the candidate then simply rebuilds when answered."""
        days = float(self.prof.get("KEEP_BUILD_DAYS", 14))
        floor = int(self.prof.get("START_GB", 32))
        kept = []
        for st in self.all_states():
            if st.get("status") != "needs-you" or not st.get("build_kept"):
                continue
            t = WORK / "targets" / Path(st["_dir"]).name
            age = time.time() - (t.stat().st_mtime if t.is_dir() else 0)
            kept.append((age, st))
        kept.sort(key=lambda x: -x[0])          # oldest first
        for age, st in kept:
            if age < days * 86400 and c_free_gb() >= floor:
                continue
            name = Path(st["_dir"]).name
            for base in (WORK / "targets", WORK / "bins"):
                d = base / name
                if d.is_dir() and not d.is_symlink():
                    shutil.rmtree(d, ignore_errors=True)
            d = st.pop("_dir")
            st["build_kept"] = False
            write_json(Path(d) / "state.json", st)
            self.log(f"dropped the kept build folder of {name} ({age / 86400:.1f} days old)")

    def all_states(self):
        out = []
        for d in sorted((LEDGER / "candidates").glob("*/state.json")):
            s = read_json(d, {})
            s["_dir"] = str(d.parent)
            out.append(s)
        return out

    def state(self, **upd):
        p = self.cand / "state.json"
        s = read_json(p, {})
        s.update(upd)
        s["updated"] = now()
        write_json(p, s)
        return s

    def session_homes(self):
        homes = [d for d in sorted((LEDGER / "candidates").glob("*")) if d.is_dir() and not d.is_symlink()]
        homes += [d / "scout" for d in sorted((LEDGER / "runs").glob("*")) if (d / "scout").is_dir()]
        homes += [d / "learn" for d in sorted((LEDGER / "runs").glob("*")) if (d / "learn").is_dir()]
        return homes

    def record_sessions(self):
        """Copy the plain files worth keeping from each session folder into its driver-owned
        record/ folder, read the way every session file is read (regular files, size-capped)."""
        for home in self.session_homes():
            src = home / "session"
            if not src.is_dir() or src.is_symlink():
                continue
            files = {}
            for name in RECORD_TOP:
                t = read_session_file(src / name)
                if t is not None:
                    files[name] = t
            ev = src / "evidence"
            if ev.is_dir() and not ev.is_symlink():
                for q in sorted(ev.iterdir())[:60]:
                    if re.fullmatch(r"[A-Za-z0-9][\w.-]{0,99}\.(md|txt|json|log)", q.name):
                        t = read_session_file(q)
                        if t is not None:
                            files["evidence/" + q.name] = t
            dst = home / "record"
            shutil.rmtree(dst, ignore_errors=True)
            for rel, t in files.items():
                (dst / rel).parent.mkdir(parents=True, exist_ok=True)
                (dst / rel).write_text(t)

    def ensure_ledger_ignores(self):
        gi = LEDGER / ".gitignore"
        have = gi.read_text().splitlines() if gi.exists() else []
        add = [x for x in LEDGER_IGNORES if x not in have]
        if add:
            head = "# Kept on disk, out of git (contrib-run): session folders are copied to record/"
            gi.write_text("\n".join(have + ([] if head in have else [head]) + add) + "\n")
        for pat in LEDGER_IGNORES:
            # -f skips git's local-modification check, which would run `git status` inside any
            # nested repo an older driver committed as a gitlink; --cached leaves the files alone.
            r = subprocess.run(["git", *GIT_SAFE, "-c", "submodule.recurse=false", "-C", str(LEDGER), "rm",
                                "-r", "-q", "-f", "--cached", "--ignore-unmatch", pat + "*"],
                               capture_output=True, text=True, encoding="utf-8", errors="replace",
                               env=self.git_env())
            if r.returncode:
                raise RuntimeError(f"could not untrack {pat} in the ledger: {one_line(r.stderr, 200)}")

    def ledger_unsafe(self):
        """Why the ledger's index is unsafe for `git add -A`, or None."""
        r = subprocess.run(["git", *GIT_SAFE, "-C", str(LEDGER), "ls-files", "-s"], capture_output=True,
                           text=True, encoding="utf-8", errors="replace", env=self.git_env())
        if r.returncode:
            return f"git ls-files failed: {one_line(r.stderr, 150)}"
        for line in r.stdout.splitlines():
            mode, _, rest = line.partition(" ")
            path = rest.split("\t", 1)[-1]
            if mode == "160000":
                return f"a nested repository is tracked at {path}"
            if re.match(r"(candidates/[^/]+|runs/[^/]+/(?:scout|learn))/session/|runs/[^/]+/learn/review/", path):
                return f"a session-written file is still tracked: {path}"
        return None

    def ledger_nested_git(self):
        """Any .git the ledger's git could see, other than its own (session folders are ignored)."""
        # Skip a session folder only when the ledger's git really ignores it.
        rels = [str((h / "session").relative_to(LEDGER)) for h in self.session_homes() if (h / "session").is_dir()]
        r = subprocess.run(["git", *GIT_SAFE, "-C", str(LEDGER), "check-ignore", "--stdin"],
                           input="\n".join(rels) + "\n", capture_output=True, text=True,
                           encoding="utf-8", errors="replace", env=self.git_env()) if rels else None
        ignored = set(r.stdout.split("\n")) if r is not None and r.returncode in (0, 1) else set()
        skip = {LEDGER / ".git"} | {LEDGER / x for x in rels if x in ignored}
        for root, dirs, files in os.walk(LEDGER):
            r = Path(root)
            dirs[:] = [d for d in dirs if r / d not in skip]
            if ".git" in dirs or ".git" in files:
                return r / ".git"
        return None

    def ledger_commit(self, msg):
        self.ensure_ledger_ignores()
        self.record_sessions()
        bad = self.ledger_unsafe() or self.ledger_nested_git()
        if bad:
            self.log(f"ledger commit skipped: found {bad}; remove it by hand after looking at it")
            return
        g = ["git", *GIT_SAFE, "-c", "diff.ignoreSubmodules=all", "-c", "core.untrackedCache=false",
             "-c", "submodule.recurse=false", "-C", str(LEDGER)]
        subprocess.run([*g, "add", "-A"], capture_output=True, env=self.git_env())
        subprocess.run([*g, "commit", "-qm", one_line(msg, 200)], capture_output=True, env=self.git_env())

    def rebuild_queue(self, banner=None):
        groups = {}
        for s in self.all_states():
            groups.setdefault(s.get("status", "stopped"), []).append(s)
        lines = ["# Queue", ""]
        if banner:
            lines += banner + [""]
        titles = [("ready", "Ready for your review"), ("needs-you", "Needs your decision"),
                  ("stopped", "Stopped mid-way (resumable)"), ("running", "Running"), ("failed", "Failed"),
                  ("abandoned", "Abandoned"), ("published", "Published")]
        for key, title in titles:
            items = groups.get(key, [])
            if not items:
                continue
            lines.append(f"## {title} ({len(items)})")
            for s in sorted(items, key=lambda s: s.get("updated", ""), reverse=True):
                slug = Path(s["_dir"]).name
                name, status = self.report_head(s["_dir"])
                name = name or packet_head("# " + one_line(s.get("title"), 200))[0] or slug
                head = f"- [{name}](candidates/{slug}/session/packet.md) (`{slug}`)"
                if key == "needs-you":
                    lines += [f"{head}, stage {md_text(s.get('stage'), 10) or '?'}",
                              f"  - **Question:** {md_text(s.get('question'), 800)}",
                              f"  - Answer with `contrib-run --repo {self.repo} --answer {slug} \"...\"`"]
                    continue
                note = (status if key == "ready" else None) or md_text(
                    s.get("reason") or s.get("stop_reason") or s.get("summary"), 200)
                lines.append(f"{head}{(': ' + note) if note else ''}")
            lines.append("")
        (LEDGER / "QUEUE.md").write_text("\n".join(lines).rstrip() + "\n")

    def report_head(self, cand_dir):
        """(title, status) from a candidate's packet; (None, None) when it has none yet."""
        t = read_session_file(Path(cand_dir) / "session" / "packet.md")
        return packet_head(t) if t else (None, None)

    def reject(self, slug, reason):
        with open(LEDGER / "rejects.md", "a") as f:
            f.write(f"- {datetime.date.today()} {self.repo} {slug}: {one_line(reason)}\n")

    # ----- a repo's contribution rules: the hand profile, or learned ones you approved ---------
    def rules_dir(self):
        return LEDGER / "repos" / self.repo.replace("/", "-")

    def rules_file(self, name):
        """profile.json (the latest learn) or approved.json (the rules runs use), only when its
        rules still hash to the id it names."""
        f = read_json(self.rules_dir() / name, None)
        if not isinstance(f, dict) or not isinstance(f.get("rules"), list):
            return None
        try:
            return f if profile_id(f["rules"]) == f.get("id") else None
        except (KeyError, TypeError, ValueError):
            return None

    def learned(self):
        """(the latest learned rules, the approved rules). Runs use the approved ones, so a newer
        learn changes nothing until you approve its id."""
        return self.rules_file("profile.json"), self.rules_file("approved.json")

    def load_profile(self, pdir):
        """(the profile text sessions read, where it came from). A hand profile wins while there
        is one; otherwise the learned rules, only once you approved their id."""
        name = self.repo.replace("/", "-")
        hand = pdir / f"{name}.md"
        if hand.exists():
            return hand.read_text(), "hand profile"
        latest, appr = self.learned()
        if appr is None:
            return None, None
        try:
            text = render_profile(self.repo, appr["rules"], str(appr.get("base", "")), str(appr.get("learned_at", "")))
        except (KeyError, TypeError):
            return None, None
        over = pdir / f"{name}.overrides.md"
        if over.exists():
            text = ("## Your overrides (these win over the learned rules)\n\n" + over.read_text().strip()
                    + "\n\n" + text)
        frm = f"learned rules {appr['id']}"
        if latest and latest["id"] != appr["id"]:
            frm += f"; newer learned rules {latest['id']} wait for your approval"
        return text, frm

    def git_blob(self, sha):
        r = subprocess.run(["git", *GIT_SAFE, "-C", str(self.repo_dir), "cat-file", "blob", sha],
                           capture_output=True, env=self.git_env(), timeout=120)
        if r.returncode:
            raise RuntimeError(f"git cat-file {sha[:12]}: {one_line(r.stderr.decode(errors='replace'), 200)}")
        return r.stdout

    def gh_json(self, *a):
        out = self.gh(*a)
        try:
            return json.loads(out) if out.strip() else None
        except ValueError:
            raise RuntimeError(f"gh {' '.join(a[:3])}: the answer was not JSON")

    def fetch_guides(self, base, also=()):
        """The guide files at base, the in-repo text files they link to, and any file a current
        rule cites: ({path: {"text", "blob"}}, notes on what was left out)."""
        tree, links = {}, {}
        for ent in self.git("ls-tree", "-r", "-z", "--full-tree", base).split("\0"):
            meta, _, path = ent.partition("\t")
            parts = meta.split()
            if path and len(parts) == 3 and parts[1] == "blob" and parts[0] in ("100644", "100755"):
                tree[path] = parts[2]
            elif path and len(parts) == 3 and parts[1] == "blob" and parts[0] == "120000":
                links[path] = parts[2]
        guides, notes, total, targets = {}, [], [0], set()

        def add(path):
            if path in guides:
                return
            if len(guides) >= GUIDE_MAX_FILES:
                notes.append(f"{path}: past the limit of {GUIDE_MAX_FILES} files")
                return
            data = self.git_blob(tree[path])
            if len(data) > GUIDE_MAX_BYTES:
                notes.append(f"{path}: {len(data)} bytes, over the limit of {GUIDE_MAX_BYTES}")
            elif b"\0" in data:
                notes.append(f"{path}: not a text file")
            elif total[0] + len(data) > GUIDE_TOTAL_BYTES:
                notes.append(f"{path}: past the total of {GUIDE_TOTAL_BYTES} bytes for all guides")
            else:
                total[0] += len(data)
                guides[path] = {"text": data.decode("utf-8", errors="replace"), "blob": tree[path]}

        # A guide that is a symbolic link (CONTRIBUTING.md -> docs/contributing.md, say) is read
        # as the file it points to, when that file is in the tree.
        for q in sorted(x for x in links if guide_match(x)):
            target = self.git_blob(links[q]).decode("utf-8", errors="replace")
            to = posixpath.normpath(posixpath.join(posixpath.dirname(q), target))
            if target.startswith("/") or to.startswith("../") or to not in tree:
                notes.append(f"{q}: a link to {one_line(target, 120)}, which is not a file in the tree")
            else:
                notes.append(f"{q}: a link, read as {to}")
                targets.add(to)
                add(to)
        first = sorted(q for q in tree if guide_match(q)) + [q for q in also if q in tree and not guide_match(q)]
        for q in first:
            add(q)
        linked = []
        for q in list(guides):
            if q.lower().endswith(GUIDE_TEXT):
                linked += [x for x in guide_links(q, guides[q]["text"])
                           if x in tree and x not in guides and x not in linked and x.lower().endswith(GUIDE_TEXT)]
        for q in linked:
            add(q)
        # A guide is a file the globs match, a link's target, or a file one of those links to.
        real = {q for q in guides if guide_match(q) or q in targets}
        for q in sorted(real):
            if q.lower().endswith(GUIDE_TEXT):
                real.update(x for x in guide_links(q, guides[q]["text"]) if x in guides)
        for q in guides:
            if q not in real:
                guides[q]["cited"] = True
        return guides, notes

    def fetch_often(self, base, prs, guides):
        """Add the start of each file merged PRs often change to guides, marked with how many
        changed it; returns how many were added."""
        added = 0
        for q, k in often_files(prs, {q for q, g in guides.items() if not g.get("cited")}):
            # Paths come from PRs: read them literally, never as pathspec magic.
            parts = self.git("--literal-pathspecs", "ls-tree", "--full-tree", base, "--", q).split("\t", 1)[0].split()
            if len(parts) != 3 or parts[1] != "blob" or parts[0] not in ("100644", "100755"):
                continue
            data = self.git_blob(parts[2])
            if b"\0" in data:
                continue
            part = len(data) > OFTEN_EXCERPT
            if part:
                cut = data[:OFTEN_EXCERPT]
                data = cut[:cut.rfind(b"\n") + 1] or cut
            guides[q] = {"text": data.decode("utf-8", errors="replace"), "blob": parts[2], "often": k, "part": part}
            added += 1
        return added

    def fetch_pr(self, n, item, merged):
        """One PR as the learn bundle keeps it, or None when it only touches CLA files."""
        api = f"repos/{self.repo}"
        files = self.gh_json("api", f"{api}/pulls/{n}/files?per_page=100") or []
        names = [str(f.get("filename", "")) for f in files if isinstance(f, dict)]
        if names and all(CLA_FILE.search(x) for x in names):
            return None
        # One page of each list is read; a full page means there was more, which the index says.
        cut = ["files"] if isinstance(files, list) and len(files) >= 100 else []
        comments = []
        for kind, path, prefix in (("comment", f"{api}/issues/{n}/comments?per_page=100", "ic"),
                                   ("review", f"{api}/pulls/{n}/reviews?per_page=100", "rv"),
                                   ("review comment", f"{api}/pulls/{n}/comments?per_page=100", "rc")):
            got = self.gh_json("api", path) or []
            if isinstance(got, list) and len(got) >= 100:
                cut.append(kind + "s")
            for c in got if isinstance(got, list) else []:
                if not isinstance(c, dict) or not str(c.get("body") or "").strip():
                    continue
                comments.append({"id": f"{prefix}-{c.get('id')}", "kind": kind,
                                 "author": one_line((c.get("user") or {}).get("login", ""), 60),
                                 "association": one_line(c.get("author_association", ""), 30),
                                 "path": one_line(c.get("path", ""), 200) if prefix == "rc" else "",
                                 "body": str(c.get("body"))[:LEARN_COMMENT_MAX]})
        return {"number": n, "title": one_line(item.get("title"), 200), "state": "merged" if merged else "closed",
                "author": one_line((item.get("user") or {}).get("login", ""), 60),
                "association": one_line(item.get("author_association", ""), 30), "files": names[:100],
                "body": str(item.get("body") or "")[:LEARN_BODY_MAX], "comments": comments, "cut": cut}

    def fetch_prs(self, merged, want, budget):
        """Up to `want` PRs by outside contributors (not maintainers, bots or you), newest first,
        merged or closed without merging. budget is a one-item list: the bundle's bytes left."""
        q = f"repo:{self.repo} is:pr " + ("is:merged" if merged else "is:closed is:unmerged")
        me = str(self.prof.get("CONTRIBUTOR") or "").lower()
        prs, skipped = {}, collections.Counter()
        for page in range(1, LEARN_SEARCH_PAGES + 1):
            res = self.gh_json("api", "-X", "GET", "search/issues", "-f", f"q={q}", "-f", "sort=updated",
                               "-f", "order=desc", "-f", "per_page=100", "-f", f"page={page}")
            items = res.get("items") if isinstance(res, dict) and isinstance(res.get("items"), list) else []
            for it in items:
                if len(prs) >= want:
                    break
                if not isinstance(it, dict) or not isinstance(it.get("number"), int):
                    continue
                if budget[0] <= 0:
                    skipped["left out, the bundle was full"] += 1
                    continue
                user = it.get("user") or {}
                login = str(user.get("login", ""))
                if it.get("author_association") in MAINTAINERS:
                    skipped["passed over, by maintainers"] += 1
                elif user.get("type") == "Bot" or login.endswith("[bot]"):
                    skipped["passed over, by bots"] += 1
                elif me and login.lower() == me:
                    skipped["passed over, yours"] += 1
                else:
                    pr = self.fetch_pr(it["number"], it, merged)
                    if pr is None:
                        skipped["passed over, only CLA files"] += 1
                        continue
                    size = len(json.dumps(pr))
                    if size > budget[0]:
                        # One huge PR is skipped, not allowed to end the fetch for the rest.
                        skipped["left out, too big for what was left of the bundle"] += 1
                        continue
                    budget[0] -= size
                    if pr.get("cut"):
                        skipped["read in part, more than 100 " + " or ".join(pr["cut"])] += 1
                    prs[it["number"]] = pr
            if len(prs) >= want or budget[0] <= 0 or len(items) < 100:
                break
        return prs, skipped

    def write_bundle(self, bdir, base, guides, prs, subjects, labels, notes, current):
        """The learn session's reading: guides/, prs/<N>.md, subjects, labels and an index."""
        shutil.rmtree(bdir, ignore_errors=True)
        gdir = bdir / "guides"
        gdir.mkdir(parents=True)
        for path, g in guides.items():
            dst = gdir / path
            if not inside(dst.parent, gdir) and dst.parent != gdir:
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(g["text"])
        (bdir / "prs").mkdir()
        for n, pr in sorted(prs.items()):
            out = [f"# PR #{n}: {pr['title']}", "",
                   f"State: {'merged' if pr['state'] == 'merged' else 'closed without merging'}",
                   f"Author: {pr['author']} ({pr['association']})",
                   f"Files changed ({len(pr['files'])}): " + ", ".join(pr["files"][:60]), "", "## Body", "",
                   pr["body"] or "(empty)", "", "## Reviews and comments", ""]
            for c in pr["comments"]:
                where = f" on {c['path']}" if c.get("path") else ""
                out += [f"### {c['kind']}, id {c['id']}, by {c['author']} ({c['association']}){where}", "", c["body"], ""]
            if not pr["comments"]:
                out.append("(none)")
            (bdir / "prs" / f"{n}.md").write_text("\n".join(out) + "\n")
        (bdir / "subjects.txt").write_text("\n".join(subjects) + "\n")
        (bdir / "labels.txt").write_text("\n".join(labels) + "\n")
        if current is not None:
            write_json(bdir / "current.json", current)
        merged = sorted(n for n, p in prs.items() if p["state"] == "merged")
        closed = sorted(n for n, p in prs.items() if p["state"] != "merged")
        plain = sorted(q for q in guides if not {"often", "cited"} & set(guides[q]))
        cited = sorted(q for q in guides if "cited" in guides[q] and "often" not in guides[q])
        often = sorted((q for q in guides if "often" in guides[q]), key=lambda q: (-guides[q]["often"], q))
        idx = [f"# Bundle for {self.repo}", "", f"Base commit: {base}", "",
               f"## Guide files ({len(plain)})", ""] + [f"- guides/{q}" for q in plain]
        if often:
            idx += ["", f"## Files merged PRs often change ({len(often)})", "",
                    "No guide may name these, but they show what a contribution touches. Each is under guides/ "
                    "and can be quoted like a guide.", ""]
            idx += [f"- guides/{one_line(q, 200)}: changed by {guides[q]['often']} merged PRs"
                    + (f"; only its first {OFTEN_EXCERPT // 1000} KB" if guides[q].get("part") else "") for q in often]
        tdirs = test_dirs(prs)
        if tdirs:
            idx += ["", "## Where merged PRs put their tests", ""] + [f"- {one_line(d, 200)}: {k} merged PRs" for d, k in tdirs]
        if cited:
            idx += ["", f"## Files a current rule cites ({len(cited)})", "",
                    "Files a current rule quotes that are no longer guide files. Each is under guides/ and can be "
                    "quoted like a guide.", ""]
            idx += [f"- guides/{one_line(q, 200)}" for q in cited]
        idx += ["", f"## Merged PRs by outside contributors ({len(merged)})", "",
                ", ".join(map(str, merged)) or "(none)", "", f"## Closed without merging ({len(closed)})", "",
                ", ".join(map(str, closed)) or "(none)"]
        if notes:
            idx += ["", "## Left out", ""] + [f"- {x}" for x in notes]
        (bdir / "index.md").write_text("\n".join(idx) + "\n")

    def changes_entry(self, rdir, title, lines, raw=()):
        f = rdir / "CHANGES.md"
        head = "" if f.exists() else f"# Rule changes for {md_text(self.repo, 100)}\n"
        body = [f"- {md_text(x, 400)}" for x in lines] + list(raw)
        with open(f, "a") as fh:
            fh.write(f"{head}\n## {datetime.date.today().isoformat()}: {title} (run {self.run_id})\n\n"
                     + "\n".join(body or ["- no rule changed"]) + "\n")

    def learn(self):
        """--learn: fetch the bundle; one session drafts rules.json, a second re-reads the bundle and
        corrects it. The driver checks only that each source is real, keeps the rules with one
        that is, and writes the profile and its review. Approves nothing."""
        home = self.run_dir / "learn"
        self.session_tmp(home, make=False)   # the scratch path fits the sandbox sockets, before any fetch
        sdir, bdir = home / "session", home / "bundle"
        self.learn_written = []   # what a failure part way through has left, for its message
        sdir.mkdir(parents=True, exist_ok=True)
        self.log(f"learn {self.repo}: fetching the bundle")
        if not self.args.stub:
            self.git("fetch", "-q", "--no-tags", self.prof["UPSTREAM_REMOTE"], timeout=900)
        base = self.git("rev-parse", "--verify", self.upstream + "^{commit}")
        rdir = self.rules_dir()
        latest, appr = self.learned()
        # A refresh is compared with the rules runs use now, and keeps their ids.
        prev = appr or latest
        cited = sorted({s["path"] for r in (prev or {}).get("rules", []) if isinstance(r, dict)
                        for s in r.get("sources", []) if isinstance(s, dict) and s.get("kind") == "guide"
                        and isinstance(s.get("path"), str)})
        guides, notes = self.fetch_guides(base, cited)
        prs, skipped, labels = {}, collections.Counter(), []
        if not self.args.stub:
            budget = [LEARN_BUNDLE_MAX - OFTEN_MAX_FILES * OFTEN_EXCERPT - sum(len(g["text"]) for g in guides.values())]
            for merged, want in ((True, LEARN_MERGED), (False, LEARN_CLOSED)):
                got, sk = self.fetch_prs(merged, want, budget)
                prs.update(got)
                skipped.update(sk)
            for lb in self.gh_json("api", f"repos/{self.repo}/labels?per_page=100") or []:
                if isinstance(lb, dict):
                    labels.append(one_line(f"{lb.get('name', '')}: {lb.get('description') or ''}", 200))
        n_often = self.fetch_often(base, prs, guides)
        subjects = [one_line(s, 200) for s in self.git("log", "--format=%s", "-n", "200", base).splitlines()]
        notes += [f"PRs {k}: {v}" for k, v in sorted(skipped.items())]
        current = {"id": prev.get("id"), "rules": prev.get("rules")} if prev else None
        self.write_bundle(bdir, base, guides, prs, subjects, labels, notes, current)
        n_merged = sum(1 for x in prs.values() if x["state"] == "merged")
        self.log(f"learn: base {base[:12]}, {len(guides)} guide files, {n_merged} merged and "
                 f"{len(prs) - n_merged} closed PRs by outside contributors")
        bundle = {"guides": guides, "prs": prs}
        vdir = home / "review"
        vdir.mkdir(exist_ok=True)
        res = self.learn_session("learn", home, f"{'Refresh' if prev else 'Learn'} the contribution rules of "
                                 f"{self.repo}. Your bundle is in {bdir}; start with {bdir}/index.md. Write "
                                 f"{sdir}/rules.json, then {sdir}/next.json.", "stages/learn.md", sdir)
        draft = read_session_json(sdir / "rules.json")
        if draft is None:
            raise RuntimeError("the learn session wrote no readable rules.json")
        dkept, dnotes = check_rules(draft, bundle)
        (vdir / "draft-check.md").write_text(
            f"# The driver's check of the draft\n\n{len(dkept)} rules had a source that checked out. These "
            "rules or sources did not:\n\n" + ("\n".join(f"- {i}: {one_line(w, 300)}" for i, w in dnotes)
                                              or "(none)") + "\n")
        self.log(f"learn: draft has {len(dkept)} rules that check out, {len(dnotes)} notes; review starts")
        rres = self.learn_session("review", home, f"Review the draft contribution rules of {self.repo}. The bundle "
                                  f"is in {bdir}; start with {bdir}/index.md. The draft is {sdir}/rules.json, and the "
                                  f"driver's check of its sources is {vdir}/draft-check.md. Write {vdir}/rules.json, "
                                  f"then {vdir}/next.json.", "stages/learn-review.md", vdir)
        raw = read_session_json(vdir / "rules.json")
        if raw is None:
            raise RuntimeError("the review session wrote no readable rules.json")
        kept, rnotes = check_rules(raw, bundle)
        summary = raw.get("summary") if isinstance(raw.get("summary"), str) else ""
        changes = review_lines(raw)
        meta = {"base": base, "guides": len(guides), "often": n_often, "merged": n_merged,
                "cited": sum(1 for g in guides.values() if "cited" in g and "often" not in g),
                "closed": len(prs) - n_merged}
        review = render_review(self.repo, kept, rnotes, summary, meta, changes)
        used = f"| **Sessions** | learn: {cost_text(res)}; review: {cost_text(rres)} (API-equivalent) |"
        review = review.replace("\n\n## What the project cares about", f"\n{used}\n\n## What the project cares about", 1)
        if not kept:
            (home / "PROFILE-RULES.md").write_text(render_rules(self.repo, kept, rnotes, meta, changes))
            (home / "PROFILE-REVIEW.md").write_text(review)
            raise RuntimeError(f"no rule's sources checked out; what was left out, and why, is in {home / 'PROFILE-RULES.md'}")
        pid = profile_id(kept)
        learned_at = datetime.date.today().isoformat()
        prof = {"repo": self.repo, "id": pid, "base": base, "learned_at": learned_at, "run": self.run_id,
                "summary": summary[:2000], "rules": kept, "notes": rnotes, "changes": changes,
                "draft": {"kept": len(dkept), "notes": len(dnotes)}, "meta": meta}
        same = appr is not None and appr["id"] == pid
        if same:
            review = "\n".join(f"**Approved** (the same rules as the id you approved). Rules id `{pid}`. To correct "
                               "a rule, write the correction in the repo's overrides file."
                               if x.startswith("**Learned, not yet approved.**") else x for x in review.split("\n"))
        (rdir / "history").mkdir(parents=True, exist_ok=True)
        self.learn_written.append("profile.json")
        write_json(rdir / "profile.json", prof)
        self.learn_written.append(f"history/{self.run_id}-{pid}.json")
        write_json(rdir / "history" / f"{self.run_id}-{pid}.json", prof)
        if same:
            # profile.md is the approved rules as runs see them; unapproved rules never get that heading.
            (rdir / "profile.md").write_text(render_profile(self.repo, kept, base, learned_at))
        self.learn_written.append("PROFILE-RULES.md")
        (rdir / "PROFILE-RULES.md").write_text(render_rules(self.repo, kept, rnotes, meta, changes))
        self.learn_written.append("PROFILE-REVIEW.md")
        (rdir / "PROFILE-REVIEW.md").write_text(review)
        self.learn_written.append("CHANGES.md")
        hint = [] if same else [f"- Approve with `contrib-run --repo {self.repo} --approve-profile {pid}` "
                                "after reading PROFILE-REVIEW.md"
                                + (f"; until then runs keep using {appr['id']}" if appr else "")]
        self.changes_entry(rdir, f"learned {pid}" + ("" if same else ", not approved"), rule_changes(prev, kept), hint)
        self.ledger_commit(f"learn {self.repo} rules {pid}")
        self.log(f"learn: {len(kept)} rules kept, {len(rnotes)} notes, {len(changes)} review changes; rules id {pid}; "
                 f"read {rdir / 'PROFILE-REVIEW.md'}" + ("" if same else ", then approve it"))
        return EXIT_DONE

    def learn_session(self, stage, home, prompt, stage_file, wdir):
        """One learn-side session (learn, then review): reads only its learn folder, writes only wdir."""
        system = "\n\n---\n\n".join((SKILL / f).read_text() for f in ("rules/common.md", "rules/profile.md", stage_file))
        try:
            res = self.session(stage, home, prompt, system, self.args.learn_model, [wdir], None, home, learn=True)
        finally:
            self.archive_transcripts(home)
            shutil.rmtree(self.session_tmp(home, make=False), ignore_errors=True)
        if res.get("is_error") or res.get("_rc"):
            raise RuntimeError(f"the {stage} session ended with an error: {one_line(res.get('result'), 200)}")
        return res

    def learn_failure(self, e):
        """The log line for a learn that failed: what it left behind, if anything."""
        left = getattr(self, "learn_written", [])
        what = (f"after writing {', '.join(left)} under {self.rules_dir()}; nothing was approved, and runs "
                "keep the rules they had" if left else "nothing was written")
        return f"learn failed, {what}: {type(e).__name__}: {one_line(str(e), 300)}"

    def approve_profile(self, want):
        """--approve-profile ID: approve the learned rules, only under the id they hash to now."""
        rdir = self.rules_dir()
        if not (rdir / "profile.json").exists():
            print(f"no learned rules for {self.repo}; run --learn first", file=sys.stderr)
            return 2
        prof, appr = self.learned()
        if prof is None:
            print("profile.json does not match its own id; run --learn again", file=sys.stderr)
            return 2
        pid = prof["id"]
        if want != pid:
            print(f"the learned rules' id is {pid}, not {one_line(want, 20)}; read PROFILE-REVIEW.md for {pid} first",
                  file=sys.stderr)
            return 2
        if appr is not None and appr["id"] == pid:
            print(f"rules {pid} for {self.repo} are already approved")
            return EXIT_DONE
        # approved.json holds the rules themselves, so a later learn cannot change what runs use.
        write_json(rdir / "approved.json", {"id": pid, "approved_at": now(), "base": prof.get("base"),
                                            "learned_at": prof.get("learned_at"), "run": prof.get("run"),
                                            "rules": prof["rules"]})
        (rdir / "profile.md").write_text(render_profile(self.repo, prof["rules"], prof.get("base", ""),
                                                        prof.get("learned_at", "")))
        rv = rdir / "PROFILE-REVIEW.md"
        if rv.exists():
            day = datetime.date.today().isoformat()
            rv.write_text("\n".join(f"**Approved on {day}.** Rules id `{pid}`. To correct a rule, write the "
                                    "correction in the repo's overrides file."
                                    if x.startswith("**Learned, not yet approved.**") else x
                                    for x in rv.read_text().split("\n")))
        hand = Path(os.environ.get("CONTRIB_PROFILE_DIR", SKILL / "profiles")) / f"{self.repo.replace('/', '-')}.md"
        use = (f"approved, but the hand profile {hand.name} still wins until it is removed" if hand.exists()
               else "runs on this repo use these rules from now on")
        self.changes_entry(rdir, f"approved {pid}", [use] + ([f"they replace {appr['id']}"] if appr else []))
        self.ledger_commit(f"approve {self.repo} rules {pid}")
        print(f"approved rules {pid} for {self.repo}" + (f"; the hand profile {hand.name} still wins until it is removed"
                                                          if hand.exists() else ""))
        return EXIT_DONE

    # ----- GitHub snapshots (driver only; sessions never hold a token) ------------------
    def snapshot(self, dest):
        dest.mkdir(parents=True, exist_ok=True)
        if self.args.stub:
            for n in ("issues", "prs", "mine"):
                write_json(dest / f"{n}.json", [])
            return
        issues = self.gh("issue", "list", "-R", self.repo, "--state", "open", "--limit", "300", "--json",
                         "number,title,body,labels,author,createdAt,updatedAt,comments,assignees")
        prs = self.gh("pr", "list", "-R", self.repo, "--state", "open", "--limit", "200", "--json",
                      "number,title,body,author,createdAt,headRefName,files,isDraft,closingIssuesReferences")
        mine = self.gh("pr", "list", "-R", self.repo, "--author", self.prof["CONTRIBUTOR"], "--state", "all",
                       "--limit", "50", "--json", "number,title,state,createdAt,mergedAt,files")
        (dest / "issues.json").write_text(issues)
        (dest / "prs.json").write_text(prs)
        (dest / "mine.json").write_text(mine)
        (dest / "fetched.txt").write_text(now() + "\n")

    # ----- sandboxed Claude sessions -------------------------------------------------
    def settings_for(self, write_dirs, clone, only=None):
        """Session settings. Sandboxed Bash may write only write_dirs; the file tools only those too."""
        h = str(HOME)
        # Reads are closed by default: every entry in the home directory is hidden except the
        # ledger and the work dir (and their parents), and so are the Windows drives under /mnt.
        keep = [Path(os.path.realpath(p)) for p in (LEDGER, WORK)]
        secret_files = ["/mnt", str(TOKEN_FILE.parent), f"/run/user/{os.getuid()}"]
        # Every Claude Code scratch folder on this machine (/tmp/claude-<uid>) is hidden: the
        # session's own scratch folder is moved under WORK/tmp by session_tmp().
        tmp_root = Path(f"/tmp/claude-{os.getuid()}")
        if tmp_root.is_dir():
            for e in sorted(os.listdir(tmp_root)):
                secret_files.append(str(tmp_root / e))
        for e in sorted(os.listdir(h)):
            q = Path(h) / e
            if not any(k == q or q in k.parents for k in keep):
                secret_files.append(str(q))
        if only is not None:
            # A learn session reads its own folders only. Claude Code lets the file tools read
            # outside the working folder without asking, so an allow rule cannot narrow them; deny
            # rules can, and they win over any allow. Everything is hidden from the filesystem root
            # down, level by level, except the path to each allowed folder.
            allow = [Path(os.path.realpath(p)) for p in only]
            stack = [Path("/")]
            while stack:
                d = stack.pop()
                if d in allow or not d.is_dir() or d.is_symlink():
                    continue
                for e in sorted(os.listdir(d)):
                    q = d / e
                    if any(a == q or q in a.parents for a in allow):
                        stack.append(q)
                    else:
                        secret_files.append(str(q))
        deny_write = [f"{h}/.claude", str(SKILL), str(LEDGER / "QUEUE.md"), str(LEDGER / "rejects.md")]
        deny_edit = [f"Edit(/{h}/.claude/**)", f"Edit(/{SKILL}/**)"]
        if clone:
            g = Path(clone) / ".git"
            deny_write += [str(g / "config"), str(g / "hooks"), str(g / "info")]
            deny_edit += [f"Edit(/{g}/config)", f"Edit(/{g}/hooks/**)", f"Edit(/{g}/info/**)"]
        domains = [] if only is not None else self.prof.get("REF_HOST", "").split()
        node = self.st().get("node")
        if node and node.get("port"):
            # The sandbox's own localhost is private; the proxy runs on the host and may reach
            # this one loopback port, where the bridge to the jailed node listens.
            domains.append(f"127.0.0.1:{int(node['port'])}")
        return {
            "sandbox": {
                "enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
                "autoAllowBashIfSandboxed": True,
                "filesystem": {"allowWrite": [str(d) for d in write_dirs], "denyWrite": deny_write,
                               # The whole scratch root, so folders other sessions create during
                               # this turn are covered too.
                               "denyRead": [str(tmp_root)]},
                "credentials": {
                    "files": [{"path": p, "mode": "deny"} for p in secret_files],
                    "envVars": [{"name": n, "mode": "deny"} for n in sorted(
                                {"GH_TOKEN", "GITHUB_TOKEN", "ANTHROPIC_API_KEY", "CARGO_REGISTRY_TOKEN",
                                 "CLAUDE_CODE_OAUTH_TOKEN", "SSH_AUTH_SOCK"}
                                | {k for k in os.environ if SECRET_ENV.search(k)})],
                },
                "network": {"allowedDomains": domains, "strictAllowlist": True},
            },
            "permissions": {
                "deny": [f"Read(/{p})" for p in secret_files] + [f"Read(/{p}/**)" for p in secret_files]
                + ["Read(//proc/**)", "Read(//sys/**)", f"Read(/{tmp_root})", f"Read(/{tmp_root}/**)"] + deny_edit
                + ["Bash(git push:*)", "Bash(gh:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(xerj:*)",
                   "Bash(cargo:*)", "Bash(sudo:*)", "WebFetch(domain:api.github.com)", "WebSearch"]
                + [f"Bash({w}:*)" for w in self.prof.get("SESSION_DENY", "").split()],
            },
        }

    def claude_cmd(self, prompt, model, settings, write_dirs, system_text, session_arg, learn=False):
        tools = ["Read", "Glob", "Grep"] if learn else \
            ["Read", "Glob", "Grep", "Bash", "Agent"] + [f"WebFetch(domain:{h})" for h in self.prof.get("REF_HOST", "").split()]
        cmd = [self.args.claude, "-p", prompt, "--output-format", "json", "--model", model,
               "--permission-mode", "dontAsk", "--settings", str(settings),
               "--setting-sources", SETTING_SOURCES, "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
               "--allowedTools", *tools, *[f"Edit(/{d}/**)" for d in write_dirs]]
        if learn:
            # A learn session has the file tools and nothing else: no shell, web, agents or MCP.
            cmd += ["--tools", ",".join(LEARN_TOOLS), "--max-turns", str(LEARN_MAX_TURNS)]
        agents = None if learn else agent_defs()
        if agents:
            cmd += ["--agents", json.dumps(agents)]
        if system_text:
            cmd += ["--append-system-prompt", system_text]
        for d in write_dirs:
            cmd += ["--add-dir", str(d)]
        if session_arg:
            cmd += session_arg
        return cmd

    def transcripts(self, sid):
        root = Path(os.environ.get("CONTRIB_TRANSCRIPTS", HOME / ".claude" / "projects"))
        return list(root.glob(f"*/{sid}.jsonl"))

    def session_tmp(self, home, make=True):
        """The session's scratch folder: its own, outside the shared /tmp/claude-<uid> (which is
        hidden from it), removed when the candidate or the scout finishes and swept at start."""
        scout = self.run_dir / "scout"
        # A fixed-length name: Claude Code puts its sandbox bridge sockets in this folder, and a
        # long slug once pushed their path past the Unix socket limit, so no sandboxed command ran.
        rid = self.run_id.replace("-", "")
        d = WORK / "tmp" / (f"scout-{rid}" if home == scout else f"learn-{rid}"
                            if home == self.run_dir / "learn" else
                            f"cand-{hashlib.sha256(home.name.encode()).hexdigest()[:12]}")
        n = len(os.fsencode(d))     # the socket limit counts bytes, not characters
        if n + SOCK_NAME_ROOM > SOCK_PATH_MAX:
            raise RuntimeError(f"the session scratch folder {d} is {n} bytes long; the sandbox sockets made "
                               f"in it need it to be at most {SOCK_PATH_MAX - SOCK_NAME_ROOM} "
                               f"(set CONTRIB_WORK to a shorter folder)")
        if make:
            d.mkdir(mode=0o700, parents=True, exist_ok=True)
        return d

    def session(self, stage, cwd, prompt, system_text, model, write_dirs, clone, home, _fresh=False, learn=False):
        """One turn of a sandboxed headless session. home is a driver-owned folder for its records.
        A session id is recorded only once the session exists (its result names it, or its
        transcript is on disk), so a launch that failed is never 'resumed'."""
        sess = home / "sessions.json"
        known = read_json(sess, {})
        settings = self.run_dir / f"settings-{home.name}-{stage}.json"
        stmp = self.session_tmp(home)
        write_json(settings, self.settings_for([*write_dirs, stmp], clone, only=[home, stmp] if learn else None))
        new_sid = None
        pend = known.get(f"{stage}.pending")
        if stage not in known and isinstance(pend, str) and self.transcripts(pend):
            # A turn that a stop interrupted: the session exists, so carry on in it.
            known[stage] = pend
        known.pop(f"{stage}.pending", None)
        if stage in known:
            arg = ["--resume", known[stage]]
        else:
            new_sid = str(uuid.uuid4())
            known[f"{stage}.pending"] = new_sid
            arg = ["--session-id", new_sid]
        write_json(sess, known)
        cmd = self.claude_cmd(prompt, model, settings, write_dirs, system_text, arg, learn=learn)
        stamp = int(time.time())
        out = home / "sessions" / f"{stage}-{stamp}.json"
        n = 1
        while out.exists():
            out = home / "sessions" / f"{stage}-{stamp}_{n}.json"
            n += 1
        out.parent.mkdir(exist_ok=True)
        self.log(f"session {stage}: turn starts ({model})")
        env = self.claude_env()
        env["CLAUDE_CODE_TMPDIR"] = env["TMPDIR"] = str(stmp)
        rc = self.run_tracked("session", cmd, cwd=str(cwd), env=env, timeout=LEARN_TIMEOUT if learn else TURN_TIMEOUT, out=out,
                              err_apart=True)
        text = out.read_text(errors="replace") if out.exists() else ""
        err = Path(str(out) + ".err").read_text(errors="replace")[-4000:] if Path(str(out) + ".err").exists() else ""
        res = read_json(out, None)
        if not isinstance(res, dict):
            res = {"is_error": True, "result": text[-2000:]}
        res["_rc"] = rc
        msg = str(res.get("result", ""))
        if new_sid:
            known.pop(f"{stage}.pending", None)
            if res.get("session_id") == new_sid or self.transcripts(new_sid):
                known[stage] = new_sid
            write_json(sess, known)
        if (res.get("is_error") or rc) and not new_sid and not _fresh \
                and "no conversation found" in (msg + " " + err).lower():
            # The recorded session is gone (never started, or its transcript was removed): drop
            # it and start this stage's session afresh. The stage's files carry its progress.
            self.log(f"session {stage}: recorded session not found; starting a new one")
            known.pop(stage, None)
            write_json(sess, known)
            note = ("Your earlier session for this stage was lost, so this is a new one. Read the "
                    "candidate folder (state.json, results/, and session/ including any plan.md and "
                    "packet.md) to see where the work stands, then carry on.\n\n")
            self.check_stop()
            return self.session(stage, cwd, note + prompt, system_text, model, write_dirs, clone, home,
                                _fresh=True, learn=learn)
        if res.get("is_error") or rc:
            low = (msg + " " + err).lower()
            if any(k in low for k in ("usage limit", "rate limit", "limit reached", "credit balance",
                                      "please run /login", "authentication", "oauth", "invalid api key")):
                self.request_stop("hard", f"Claude usage or auth error: {one_line(msg or err, 160)}")
            self.log(f"session {stage}: error rc={rc}: {one_line(msg or err, 200)}")
        else:
            self.log(f"session {stage}: turn ends")
        return res

    def system_text(self, stage_file):
        packet = (SKILL / "rules" / "packet.md").read_text()
        if stage_file[:1] in ("A", "C"):
            packet += "\n" + (SKILL / "examples" / "packet.md").read_text()
        parts = [(SKILL / "rules" / "common.md").read_text(), self.prof_md,
                 *([self.requests_text()] if self.commands else []), packet,
                 (SKILL / "stages" / stage_file).read_text()]
        return "\n\n---\n\n".join(parts)

    # ----- builds, tests, nodes and reads ------------------------------------------------
    def tree_key(self):
        """Id of the clone's whole working tree, dirty edits included: a binary is built for this."""
        self.git_dir_check()
        self.cgit("read-tree", "HEAD", index=True)
        self.cgit("add", "-A", index=True)
        tree = self.cgit("write-tree", index=True)
        if not re.fullmatch(r"[0-9a-f]{40}", tree):
            raise RuntimeError("git write-tree did not return a tree id")
        return tree

    def binary_for(self, what, rid):
        """Build if needed and return this candidate's copy of the binary for the current tree."""
        tree = self.tree_key()
        bindir = self.bins()
        bindir.mkdir(parents=True, exist_ok=True)
        name = "xerj" if what == "server" else "es-yaml-runner"
        dest = bindir / f"{name}-{tree[:12]}"
        if dest.is_file() and not dest.is_symlink():
            rec = self.st().get("binaries", {}).get(dest.name, {})
            if rec.get("sha256") and rec["sha256"] == file_sha256(dest):
                return dest, 0
            dest.unlink()
        rc = self.ensure_fetched(rid)
        if rc:
            return None, rc
        build = self.prof["SERVER_BUILD"] if what == "server" else self.prof["RUNNER_BUILD"]
        src = self.target_dir() / (self.prof["SERVER_BIN"] if what == "server" else self.prof["RUNNER_BIN"])
        # The build runs in the jail; the binary is copied out on the host after the jail is gone.
        # The bin dir is never writable from a jail, so code that runs at build time cannot plant
        # a binary under another tree's name. The target dir is this candidate's own.
        rc, _ = self.guarded(f"{rid}-build-{what}", self.cargo_jail(build))
        if rc:
            return None, rc
        if self.args.stub and not self.args.real_requests:
            dest.write_text("stub")
        else:
            if not inside(Path(os.path.realpath(src)), self.target_dir()):
                return None, 1
            copy_regular(src, dest)
        s = self.st()
        s.setdefault("binaries", {})[dest.name] = {"head": self.cgit("rev-parse", "HEAD"),
                                                   "tree": tree, "built": now(), "sha256": file_sha256(dest)}
        self.state(binaries=s["binaries"])
        return dest, 0

    def free_port(self):
        base = int(self.prof.get("PORT_BASE", 19400))
        for port in range(base, base + 50):
            with socket.socket() as s:
                if s.connect_ex(("127.0.0.1", port)) != 0:
                    return port
        raise RuntimeError("no free scratch port")

    def node_start(self, rid):
        """A jailed node in its own network namespace, reached through a socat bridge on 127.0.0.1."""
        self.node_stop()
        bin_, rc = self.binary_for("server", rid)
        if not bin_:
            return rc, "server build failed"
        port = self.free_port()
        ndir = WORK / "nodes" / str(port)
        shutil.rmtree(ndir, ignore_errors=True)
        (ndir / "data").mkdir(parents=True)
        sock = ndir / "node.sock"
        log = open(self.cand / "results" / f"{rid}-node.log", "w")
        if self.args.stub and not self.args.real_requests:
            p = subprocess.Popen(["sleep", "3600"], start_new_session=True)
            b = subprocess.Popen(["sleep", "3600"], start_new_session=True)
        else:
            inner = (f'socat UNIX-LISTEN:"$2",fork TCP:127.0.0.1:{JAIL_PORT} & '
                     f'exec "$1" --insecure --data-dir "$3" --port {JAIL_PORT}')
            p = subprocess.Popen(self.jail(inner, rw=(ndir,), ro=(bin_,), argv=(str(bin_), str(sock), str(ndir / "data"))),
                                 stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                 start_new_session=True, preexec_fn=die_with_driver)
            self.started.add(p.pid)
            bridge = self.jail(f'exec socat TCP-LISTEN:{port},bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:"$1"',
                               net=True, rw=(ndir,), argv=(str(sock),))
            b = subprocess.Popen(bridge, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                 start_new_session=True, preexec_fn=die_with_driver)
        self.started.update((p.pid, b.pid))
        self.node_procs = {p.pid: p, b.pid: b}     # node_stop reaps them (see stop_group)
        log.close()
        self.state(node={"pid": p.pid, "bridge": b.pid, "port": port, "dir": str(ndir), "bin": bin_.name})
        if not (self.args.stub and not self.args.real_requests):
            for _ in range(120):
                try:
                    c = http.client.HTTPConnection("127.0.0.1", port, timeout=2)
                    c.request("GET", "/")
                    c.getresponse().read()
                    break
                except (OSError, http.client.HTTPException):
                    time.sleep(0.5)
            else:
                self.node_stop()
                return 1, f"node did not answer on port {port}"
        return 0, f"node up on 127.0.0.1:{port} (binary {bin_.name}); use xq"

    def node_stop(self):
        node = self.st().get("node") if self.cand else None
        if not node:
            return True
        procs = getattr(self, "node_procs", {})
        # Both are stopped even when the first is not gone (all() over a generator would skip
        # the bridge).
        gone = all([stop_group(node.get(k), signal.SIGTERM, 20, self.log, proc=procs.get(node.get(k)))
                    for k in ("pid", "bridge")])
        d = node.get("dir", "")
        if gone and d and inside(d, WORK / "nodes") and Path(d) != WORK / "nodes":
            shutil.rmtree(d, ignore_errors=True)
        if gone:
            self.started.difference_update({node.get("pid"), node.get("bridge")})
            self.state(node=None)
        return gone

    def run_requests(self, reqs, driver=False):
        res_dir = self.cand / "results"
        res_dir.mkdir(exist_ok=True)
        index = res_dir / "index.jsonl"
        if not isinstance(reqs, list):
            reqs = []
        # A session is told this limit in rules/common.md; the cut is also named at the top of its
        # next prompt (cut_note), kept in state.json across a stop or a resume: in the 2026-11-09 run
        # a line in index.jsonl alone was missed.
        left = reqs[MAX_REQUESTS_PER_TURN:]
        reqs = reqs[:MAX_REQUESTS_PER_TURN]
        self.cut_note = ""
        if left:
            total, first = len(reqs) + len(left), MAX_REQUESTS_PER_TURN + 1
            # Named as they would run (the rid rule below), so a session's own words never reach the prompt.
            ids = [re.sub(r"[^A-Za-z0-9_.-]", "_", str(r["id"]))[:60] if isinstance(r, dict) and r.get("id")
                   else "(no id)" for r in left]
            shown = ", ".join(ids[:12]) + (f", and {len(ids) - 12} more" if len(ids) > 12 else "")
            which = (f"request {first} did not run and has no result" if len(left) == 1 else
                     f"requests {first} to {total} did not run and have no result")
            self.cut_note = (f"Only the first {MAX_REQUESTS_PER_TURN} of your {total} requests ran; {which} "
                             f"(ids: {shown}). Ask again for any you still need.")
            with open(index, "a") as f:
                f.write(json.dumps({"at": now(), "id": "too-many", "kind": "invalid", "exit": 2, "expect": "any", "met": False,
                                    "infra": False, "secs": 0, "log": "", "note": self.cut_note}) + "\n")
        for n, req in enumerate(reqs):
            self.check_stop()
            if self.guard_blocked:
                with open(index, "a") as f:
                    f.write(json.dumps({"at": now(), "id": "skipped", "kind": "invalid", "exit": 2, "expect": "any",
                                        "met": False, "infra": True, "secs": 0, "log": "", "note":
                                        f"{len(reqs) - n} requests not run: the run is stopping "
                                        f"({one_line(self.stop_reason, 120)})"}) + "\n")
                raise StopRun()
            if not isinstance(req, dict):
                req = {"kind": "invalid"}
            rid = re.sub(r"[^A-Za-z0-9_.-]", "_", str(req.get("id") or f"r{int(time.time())}-{n}"))[:60]
            kind = req.get("kind")
            t0 = time.time()
            rc, note, out = 0, "", res_dir / f"{rid}.log"
            self.last_counts = None
            try:
                if self.commands and kind not in ("test", "check", "gh"):
                    rc, note = 2, f"unknown request kind {kind!r}: this repo's kinds are test, check and gh"
                elif self.commands and kind == "test":
                    rc, out, note = self.req_cmd_test(rid, req)
                elif self.commands and kind == "check":
                    rc, out, note = self.req_check(rid, req)
                elif kind == "test":
                    rc, out, note = self.req_test(rid, req)
                elif kind == "fmt":
                    rc = self.ensure_fetched(rid)
                    if not rc:
                        rc, out = self.guarded(rid, self.cargo_jail(
                            "cargo fmt --all --check" if req.get("check") is True else "cargo fmt --all"), retries=0)
                    note = self.cgit("diff", "--no-ext-diff", "--stat", check=False)
                elif kind == "clippy":
                    crates = [c for c in req.get("crates", []) if isinstance(c, str) and re.fullmatch(r"[\w-]{1,60}", c)]
                    rc = self.ensure_fetched(rid)
                    if not rc:
                        if req.get("workspace") is True and driver:
                            # What CI's lint job runs (the dev profile, every crate and target).
                            # No incremental data or debuginfo: neither changes a lint, both cost GBs.
                            try:
                                rc, out = self.guarded(rid, self.cargo_jail(
                                    "cargo clippy --workspace --all-targets -- -D warnings",
                                    env={"CARGO_INCREMENTAL": "0", "CARGO_PROFILE_DEV_DEBUG": "0"}))
                            finally:
                                shutil.rmtree(self.target_dir() / "debug", ignore_errors=True)
                        else:
                            sel = " ".join(f"-p {c}" for c in crates)
                            rc, out = self.guarded(rid, self.cargo_jail(
                                f"cargo clippy --profile ci-test {sel} --tests -- -D warnings"))
                elif kind == "build":
                    b, rc = self.binary_for("runner" if req.get("what") == "runner" else "server", rid)
                    note = f"binary {b.name if b else 'none'}"
                elif kind == "node-start":
                    rc, note = self.node_start(rid)
                elif kind == "node-stop":
                    rc = 0 if self.node_stop() else 1
                elif kind == "yaml":
                    rc, out, note = self.req_yaml(rid, req)
                elif kind == "gh":
                    rc, note = self.req_gh(req, out)
                else:
                    rc, note = 2, f"unknown request kind {kind!r}"
            except StopRun:
                raise
            except Exception as e:
                rc, note = 1, f"driver error: {e}"
            if not Path(out).exists():
                Path(out).write_text(note + "\n")
            expect = req.get("expect", "pass" if kind in ("test", "check", "clippy", "yaml", "fmt", "build") else "any")
            if expect not in ("pass", "fail", "any"):
                expect = "pass"
            infra = rc in INFRA_EXITS
            met, note = self.judge_result(kind, expect, rc, out, note)
            rec = {"id": rid, "at": now(), "kind": kind, "exit": rc, "expect": expect, "met": met, "infra": infra,
                   "secs": int(time.time() - t0), "log": str(Path(out).relative_to(self.cand)), "note": one_line(note, 500)}
            if self.commands and kind == "test" and not note.startswith("refused:") and not req.get("without"):
                rec["req"] = {"paths": [p for p in req["paths"]] if isinstance(req.get("paths"), list) else [req.get("paths")],
                              "filter": req.get("filter", "") if isinstance(req.get("filter"), str) else ""}
                if self.last_counts is not None:
                    rec["counts"] = self.last_counts
            elif not self.commands and kind == "test" and rc not in (2,) and not req.get("without"):
                rec["req"] = {k: req[k] for k in ("crate", "target", "filter") if isinstance(req.get(k), str)}
            with open(index, "a") as f:
                f.write(json.dumps(rec) + "\n")
            self.log(f"request {rid} ({kind}): exit {rc}, expect {expect}, met {met}")

    def clone_path(self, p):
        """A session-named path inside the clone, or None."""
        if not isinstance(p, str) or not p or p.startswith("/") or ".." in Path(p).parts or "\x00" in p:
            return None
        f = self.clone() / p
        return f if inside(f.parent, self.clone()) and not f.is_symlink() else None

    def req_test(self, rid, req):
        out = self.cand / "results" / f"{rid}.log"
        crate, target, filt = req.get("crate", ""), req.get("target", "lib"), req.get("filter", "")
        if not all(isinstance(x, str) for x in (crate, target, filt)):
            return 2, out, "crate, target and filter must be strings"
        if not re.fullmatch(r"[\w-]{1,60}", crate) or not re.fullmatch(r"[\w-]{1,80}", target):
            return 2, out, "bad crate or target"
        if filt and not re.fullmatch(r"[\w:]{1,200}", filt):
            return 2, out, "bad filter"
        sel = "--lib" if target == "lib" else f"--test {target}"
        inner = f"cargo test --profile ci-test -p {crate} {sel}" + (f" -- {filt}" if filt else "")
        without = req.get("without", [])
        if not isinstance(without, list):
            return 2, out, "without must be a list of paths"
        rels = without
        if any(self.clone_path(p) is None for p in rels) or len(rels) > 20:
            return 2, out, "a without path is not a plain file path inside the clone"
        if any(not os.path.lexists(self.clone() / p) for p in rels):
            return 2, out, "a without path does not exist in the clone; only files the fix changed or added can be reverted"
        rc = self.ensure_fetched(rid)
        if rc:
            return rc, out, "cargo fetch failed"
        # The base versions are laid over the clone inside this run's jail only: nothing in the
        # clone is touched on the host, so there is nothing to restore and no path to follow.
        base = self.st()["base_sha"]
        tmp = WORK / "tmp" / f"without-{self.cand.name}-{rid}"
        shutil.rmtree(tmp, ignore_errors=True)
        over = []
        try:
            if rels:
                tmp.mkdir(parents=True)
            for i, rel in enumerate(rels):
                r = subprocess.run(["git", *GIT_SAFE, "-C", str(self.repo_dir), "cat-file", "blob", f"{base}:{rel}"],
                                   capture_output=True, env=self.git_env())
                src = tmp / str(i)
                src.write_bytes(r.stdout if r.returncode == 0 else b"")
                over.append((src, self.clone() / rel))
            rc, out = self.guarded(rid, self.cargo_jail(inner, over=over),
                                   retries=0 if req.get("expect") == "fail" else None)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
            # The overlaid base files were newer than the real ones, so cargo's records now say
            # the base build is current. Touch the real files so the next build recompiles them.
            for rel in rels:
                try:
                    p = self.clone_path(rel)          # refuses a symlinked parent planted meanwhile
                    if os.path.realpath(p).startswith(os.path.realpath(self.clone()) + os.sep):
                        os.utime(p, follow_symlinks=False)
                except Exception:
                    pass
        note = "reverted to base for this run: " + ", ".join(rels) if rels else ""
        return rc, out, note

    def refuse_shallow(self):
        """Sessions read history (git log, blame) to check claims; a shallow clone hides it."""
        if self.git("rev-parse", "--is-shallow-repository", check=False) == "true":
            raise RuntimeError(f"{self.repo_dir} is a shallow clone; run once: git -C {self.repo_dir} fetch "
                               f"--unshallow {self.prof['UPSTREAM_REMOTE']}")

    def judge_result(self, kind, expect, rc, out, note):
        """Whether a finished request met its expectation, and the note to record. Facts only: the
        exit code, then for tests the runner's own report counts (commands mode) or cargo's summary
        lines (cargo mode). A run the driver refused never meets an expectation in commands mode."""
        if rc in INFRA_EXITS:
            return False, note
        met = (expect == "any") or (expect == "pass" and rc == 0) or (expect == "fail" and rc != 0)
        def add(why):
            return (note + "; " if note else "") + why
        if self.commands and note.startswith(("refused:", "unknown request kind", "driver error",
                                              "the dependency setup failed")):
            return False, note
        if kind != "test":
            return met, note
        log = Path(out).read_text(errors="replace") if Path(out).exists() else ""
        if self.commands:
            if log.startswith("[stub]"):
                return met, note
            met, why = judge_test(rc, self.last_counts, expect, self.prof, report=has_report(self.prof))
            return met, (add(why) if why else note)
        if met and expect == "fail":
            if re.search(r"^error\[E\d+\]:|^error: could not compile", log, re.M) or "test result: FAILED" not in log:
                return False, add("it did not compile or no test failed")
        if met and expect == "pass" and not log.startswith("[stub]"):
            ran = sum(int(x) for x in re.findall(r"^test result: ok\. (\d+) passed", log, re.M))
            ignored = sum(int(x) for x in re.findall(r"^test result: \w+\. \d+ passed; \d+ failed; (\d+) ignored", log, re.M))
            if ran == 0 and ignored:
                return False, add(f"the test is ignored ({ignored} ignored), not run")
            if ran == 0:
                return False, add("no test ran: check the target and filter")
        return met, note

    # ----- commands mode: the repo's own setup, tests and checks ---------------------------
    def env_root(self):
        return WORK / "envs" / self.repo.replace("/", "-")

    def tool_dirs(self):
        return [Path(p) for p in self.prof.get("TOOLS", "").split()]

    def jail_env(self):
        """The profile's JAIL_ENV, with {env} and {cache} filled, and TOOLS first on PATH."""
        e = {}
        if self.tool_dirs():
            e["PATH"] = ":".join(map(str, self.tool_dirs())) + f":{HOME}/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
        vals = {"env": str(self.env_dir or ""), "cache": str(self.env_root() / "cache")}
        for w in shlex.split(self.prof.get("JAIL_ENV", "")):
            k, sep, v = w.partition("=")
            if sep and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
                e[k] = render_cmd(shlex.quote(v), vals)[0] if v else ""
        return e

    def cmd_values(self, junit=None):
        v = {"env": str(self.env_dir), "cache": str(self.env_root() / "cache")}
        if junit:
            v["junit"] = str(junit)
        return v

    def ensure_setup(self, rid):
        """Install the repo's dependencies for the base commit, once per change of the SETUP_KEY
        paths. SETUP_CMD is the only command with network, so it runs on files exported from the
        pipeline clone at the base, never on the session's clone, with only the new environment,
        the export and the setup caches writable. Every later run gets the environment read-only."""
        base = self.st()["base_sha"]
        if not re.fullmatch(r"[0-9a-f]{40}", base or ""):
            raise RuntimeError("state.json base_sha is not a commit id")
        ids = [self.git("rev-parse", "--verify", "--quiet", f"{base}:{p}", check=False) or "-"
               for p in self.prof["SETUP_KEY"].split()]
        key = hashlib.sha256("\n".join([self.prof["SETUP_CMD"], self.prof.get("JAIL_ENV", ""),
                                        self.prof.get("TOOLS", ""), *ids]).encode()).hexdigest()[:16]
        root = self.env_root()
        self.env_dir = root / key
        if (self.env_dir / ".contrib-ready").is_file():
            return 0
        for p in self.tool_dirs():
            if not p.is_dir():
                raise RuntimeError(f"TOOLS names {p}, which is not a folder")
        exp, tgt = WORK / "tmp" / f"setup-{key}", WORK / "tmp" / f"setup-{key}-target"
        for d in (exp, tgt, self.env_dir):
            shutil.rmtree(d, ignore_errors=True)
            d.mkdir(parents=True)
        for d in (root / "cache", root / "cargo"):
            d.mkdir(parents=True, exist_ok=True)
        self.log(f"setup: installing dependencies for base {base[:12]} into {self.env_dir}")
        try:
            if not (self.args.stub and not self.args.real_requests):
                r = subprocess.run(f"git {shlex.join(GIT_SAFE)} -C {shlex.quote(str(self.repo_dir))} archive {base}"
                                   f" | tar -x -C {shlex.quote(str(exp))}", shell=True, capture_output=True,
                                   text=True, encoding="utf-8", errors="replace", env=self.git_env())
                if r.returncode:
                    self.log(f"export of {base[:12]} for setup failed: {one_line(r.stderr, 200)}")
                    return 1
            env = dict(self.jail_env(), CARGO_HOME=str(root / "cargo"), CARGO_TARGET_DIR=str(tgt))
            argv = self.jail('exec "$@"', net=True, rw=(exp, tgt, self.env_dir, root / "cache", root / "cargo"),
                             ro=self.tool_dirs(), chdir=exp, env=env,
                             argv=render_cmd(self.prof["SETUP_CMD"], self.cmd_values()))
            rc, _ = self.guarded(f"{rid}-setup", argv, retries=0)
        finally:
            shutil.rmtree(exp, ignore_errors=True)
            shutil.rmtree(tgt, ignore_errors=True)
        if rc:
            shutil.rmtree(self.env_dir, ignore_errors=True)
            return rc
        (self.env_dir / ".contrib-ready").write_text(base + "\n")
        kept = sorted((d for d in root.iterdir() if (d / ".contrib-ready").is_file()),
                      key=lambda d: (d / ".contrib-ready").stat().st_mtime, reverse=True)
        for d in kept[2:]:
            if d != self.env_dir:
                shutil.rmtree(d, ignore_errors=True)
        for d in root.iterdir():        # a setup that failed or was cut off leaves a folder never marked ready
            if d.is_dir() and d.name not in ("cache", "cargo") and d != self.env_dir and not (d / ".contrib-ready").is_file():
                shutil.rmtree(d, ignore_errors=True)
        return 0

    def cmd_jail(self, argv, over=(), extra_rw=()):
        """A profile command in the jail: no network, the clone writable, the environment and the
        tools read-only, and the clone's .git a checked copy, as in cargo_jail."""
        src = self.git_dir_check(keep="build")
        return self.jail('exec "$@"', rw=(self.clone(), *extra_rw), ro=(self.env_dir, *self.tool_dirs()),
                         over=((src, self.clone() / ".git"), *over), chdir=self.clone(), env=self.jail_env(),
                         argv=argv)

    def session_paths(self, paths, dirs=False):
        """Paths a session named for a command: existing files (or folders, when dirs) inside the
        clone, none starting with '-' or '@' (many runners read '@name' as a file of more options), so
        each stays one argument naming one thing. None if any is not."""
        if isinstance(paths, str):
            paths = [paths]
        if not isinstance(paths, list) or not 1 <= len(paths) <= 40:
            return None
        for p in paths:
            f = self.clone_path(p)
            if f is None or p.startswith(("-", "@")) or any(c in p for c in "\n\r"):
                return None
            if not (f.is_file() or (dirs and f.is_dir())) or not inside(f, self.clone()):
                return None
        return list(paths)

    def req_cmd_test(self, rid, req):
        out = self.cand / "results" / f"{rid}.log"
        paths = self.session_paths(req.get("paths"))
        filt = req.get("filter", "")
        if paths is None:
            return 2, out, "refused: paths must be 1 to 40 test files that exist in the clone"
        if not isinstance(filt, str) or len(filt) > 200 or filt.startswith(("-", "@")) or any(c in filt for c in "\n\r\x00"):
            return 2, out, "refused: the filter must be one line of at most 200 characters, not starting with - or @"
        if filt and not self.prof.get("TEST_FILTER_FLAG", "").strip():
            return 2, out, "refused: this repo's profile has no TEST_FILTER_FLAG, so a filter cannot be passed"
        without = req.get("without", [])
        if not isinstance(without, list):
            return 2, out, "refused: without must be a list of paths"
        rels = without
        if any(self.clone_path(p) is None for p in rels) or len(rels) > 20:
            return 2, out, "refused: a without path is not a plain file path inside the clone"
        if any(not os.path.lexists(self.clone() / p) for p in rels):
            return 2, out, "refused: a without path does not exist in the clone; only files the fix changed or added can be reverted"
        rc = self.ensure_setup(rid)
        if rc:
            return rc, out, "the dependency setup failed"
        base = self.st()["base_sha"]
        tmp = WORK / "tmp" / f"cmd-{self.cand.name}-{rid}"
        shutil.rmtree(tmp, ignore_errors=True)
        (tmp / "report").mkdir(parents=True)
        junit = tmp / "report" / "junit.xml"
        try:
            # As in req_test: base versions laid over the clone inside this run's jail only.
            over = []
            for i, rel in enumerate(rels):
                r = subprocess.run(["git", *GIT_SAFE, "-C", str(self.repo_dir), "cat-file", "blob", f"{base}:{rel}"],
                                   capture_output=True, env=self.git_env())
                src = tmp / str(i)
                src.write_bytes(r.stdout if r.returncode == 0 else b"")
                over.append((src, self.clone() / rel))
            argv = render_cmd(self.prof["TEST_CMD"], self.cmd_values(junit), {"paths": paths})
            if filt:
                argv += [self.prof["TEST_FILTER_FLAG"].strip(), filt]
            rc, out = self.guarded(rid, self.cmd_jail(argv, over=over, extra_rw=(tmp / "report",)),
                                   retries=0 if req.get("expect") == "fail" else None)
            if junit.is_file() and not junit.is_symlink():
                shutil.copyfile(junit, self.cand / "results" / f"{rid}.junit.xml")
                self.last_counts = junit_counts(self.cand / "results" / f"{rid}.junit.xml")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        note = "reverted to base for this run: " + ", ".join(rels) if rels else ""
        if self.last_counts:
            c = self.last_counts
            note = (note + "; " if note else "") + (f"{c['tests']} tests, {c['failures']} failed, "
                                                    f"{c['errors']} errors, {c['skipped']} skipped")
        return rc, out, note

    def req_check(self, rid, req):
        out = self.cand / "results" / f"{rid}.log"
        names = self.prof.get("CHECKS", "").split()
        name = req.get("name")
        if name not in names:
            return 2, out, f"refused: unknown check {name!r}; this repo's checks are {', '.join(names) or 'none'}"
        if req.get("paths") in (None, "", []):
            paths = shlex.split(self.prof.get("CHECK_PATHS", ""))
        else:
            paths = self.session_paths(req.get("paths"), dirs=True)
            if paths is None:
                return 2, out, "refused: paths must be 1 to 40 files or folders that exist in the clone"
        rc = self.ensure_setup(rid)
        if rc:
            return rc, out, "the dependency setup failed"
        argv = render_cmd(self.prof[f"CHECK_{name}"], self.cmd_values(), {"paths": paths})
        rc, out = self.guarded(rid, self.cmd_jail(argv), retries=0)
        note = self.cgit("diff", "--no-ext-diff", "--stat", check=False)
        return rc, out, (f"files changed so far: {one_line(note, 300)}" if note else "")

    def requests_text(self):
        """Commands mode: the runs a stage session can ask for, written from the profile, so the
        session sees the exact commands and how each result is judged."""
        p = self.prof
        flag = p.get("TEST_FILTER_FLAG", "").strip()
        rows = [f"| `test` | `paths`: a list of test files in the clone; `filter` (optional"
                + (f", passed as `{flag} <filter>`" if flag else ", not available here")
                + "); `expect`: `fail`, `pass` or `any`; `without` (optional): files laid back to their base "
                f"version for this run only | `{p['TEST_CMD']}` |"]
        for n in p.get("CHECKS", "").split():
            rows.append(f"| `check`, `name`: `{n}` | `paths` (optional; default: the profile's list) | `{p[f'CHECK_{n}']}` |")
        rows.append("| `gh` | `args`: a read-only gh command | `gh <args>` |")
        none = p.get("TEST_EXIT_NONE", "").strip()
        gate = p.get("GATE_CHECKS", "").split()
        return "\n".join([
            "## Runs you can request", "",
            "Each run is one item in next.json's `requests`, with an `id`, a `kind` and the fields below. "
            "It runs in the driver's jail: no network, the clone writable, the dependencies read-only. The "
            "dependencies are installed once from the base commit's files, so a change that needs a new or "
            "different dependency cannot be tested here: say so in the packet instead. Every run uses the "
            f"base version of {', '.join(f'`{k}`' for k in p['SETUP_KEY'].split())}, so a change there is "
            "never tested, and the final gate refuses a branch that makes one.", "",
            "| kind | fields | command |", "|---|---|---|", *rows, "",
            f"A test result is read from facts only: exit {p['TEST_EXIT_PASS']} with at least one test run is a "
            f"pass; exit {p['TEST_EXIT_FAIL']} with failing tests and no errors is a fail"
            + (f"; exit {none} means no test was found" if none else "")
            + "; any other exit is an error (an import, collection or usage problem): read the log. The driver "
            "writes each result to `results/index.jsonl`.", "",
            "The final gate, on a fresh clone of your branch, runs "
            + (", ".join(f"the {n} check" for n in gate) + ", then " if gate else "")
            + "every test you ran expecting pass (its last form), then the test files the branch changes.",
        ])

    def req_yaml(self, rid, req):
        """Node and runner together in one jail with no network; a fresh node per request."""
        out = self.cand / "results" / f"{rid}.log"
        ydir = self.engine_dir() / self.prof["YAML_DIR"]
        if req.get("full"):
            files = []
        else:
            files = req.get("files", [])
            files = files if isinstance(files, list) else []
            ok = [f for f in files if isinstance(f, str) and re.fullmatch(r"[A-Za-z0-9_./-]{1,200}\.ya?ml", f)
                  and ".." not in f.split("/") and not f.startswith("/") and (ydir / f).is_file()
                  and inside(ydir / f, ydir)]
            if not ok or len(ok) != len(files):
                return 2, out, "yaml needs full, or files that exist under the YAML dir"
            files = ok
        server, rc = self.binary_for("server", rid)
        if not server:
            return rc, out, "server build failed"
        runner, rc = self.binary_for("runner", rid)
        if not runner:
            return rc, out, "runner build failed"
        ndir = WORK / "nodes" / f"yaml-{self.cand.name}"
        shutil.rmtree(ndir, ignore_errors=True)
        (ndir / "data").mkdir(parents=True)
        inner = (
            'srv=$1 run=$2 data=$3 ydir=$4; shift 4\n'
            f'"$srv" --insecure --data-dir "$data" --port {JAIL_PORT} > "$data/../node.log" 2>&1 &\n'
            f'for i in $(seq 1 240); do curl -sf -o /dev/null --max-time 2 http://127.0.0.1:{JAIL_PORT}/_cluster/health && break; sleep 0.5; done\n'
            f'curl -sf -o /dev/null --max-time 2 http://127.0.0.1:{JAIL_PORT}/_cluster/health || '
            '{ echo "the node never became healthy"; tail -n 40 "$data/../node.log"; kill %1 2>/dev/null; exit 1; }\n'
            'rc=0\n'
            f'if [ $# -eq 0 ]; then "$run" --url http://127.0.0.1:{JAIL_PORT} --dir "$ydir" || rc=$?\n'
            f'else for f in "$@"; do "$run" --url http://127.0.0.1:{JAIL_PORT} --verbose --file "$ydir/$f" || rc=$?; done; fi\n'
            'kill %1 2>/dev/null; wait\n'
            'exit $rc\n')
        argv = (str(server), str(runner), str(ndir / "data"), str(ydir), *files)
        jail = self.jail(inner, rw=(ndir,), ro=(self.clone(), server, runner), chdir=self.engine_dir(), argv=argv)
        try:
            rc, out = self.guarded(rid, jail, retries=0)
        finally:
            shutil.rmtree(ndir, ignore_errors=True)
        tail = out.read_text(errors="replace").strip().splitlines()[-3:] if out.exists() else []
        return rc, out, " | ".join(tail)

    def req_gh(self, req, out):
        argv, why = gh_argv(req.get("args"), self.repo)
        if not argv:
            return 2, why
        if self.args.stub:
            Path(out).write_text("[stub] gh " + shlex.join(argv) + "\n")
            return 0, "stub"
        env = self.gh_env()
        r = subprocess.run(["gh", *argv], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=300, env=env)
        Path(out).write_text((r.stdout + r.stderr)[:400_000])
        return r.returncode, ""

    # ----- the clone ------------------------------------------------------------------
    def wip_refs(self, slug):
        refs = self.git("for-each-ref", "--format=%(refname)", f"refs/contrib-wip/{slug}/", check=False).split()
        return sorted(refs, key=lambda r: int(r.rsplit("/", 1)[1]) if r.rsplit("/", 1)[1].isdigit() else -1)

    def make_clone(self, slug, branch, base, restore=True):
        """Each candidate gets its own clone with its own copy of the objects (no hardlinks into
        the pipeline clone), so a session can only ever write its own repository. Resume brings
        back the last snapshot of unfinished work."""
        dst = self.clone()
        if dst.exists():
            raise RuntimeError(f"{dst} already exists; recover_stale should have saved and removed it")
        self.git("clone", "--quiet", "--no-hardlinks", "--no-checkout", "--origin", "pipeline", str(self.repo_dir),
                 str(dst))
        self.git("remote", "set-url", "--push", "pipeline", "no_push", cwd=dst)
        # A session's own git runs with the clone's config, and a commit there could start a
        # background gc that outlives the session and rewrites packs while the driver copies .git.
        self.git("config", "gc.auto", "0", cwd=dst)
        self.git("config", "maintenance.auto", "false", cwd=dst)
        # Inside the session sandbox, Claude Code masks shell and git startup files in the
        # working folder with /dev/null devices; git would list them as untracked and fail to
        # add them. info/ is not writable from a session, so this list holds.
        excl = dst / ".git" / "info" / "exclude"
        excl.parent.mkdir(parents=True, exist_ok=True)
        with open(excl, "a") as fh:
            fh.write("\n# sandbox masks (contrib-run)\n" + "".join(f"/{n}\n" for n in SANDBOX_MASKS))
        self.git("update-ref", f"refs/remotes/{self.upstream}", base, cwd=dst)
        if self.git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False):
            self.git("checkout", "-q", "-B", branch, f"pipeline/{branch}", cwd=dst)
        else:
            self.git("checkout", "-q", "-b", branch, base, cwd=dst)
        wips = self.wip_refs(slug)
        if restore and wips and self.st().get("wip_pending"):
            last = wips[-1]
            self.git("fetch", "-q", "--no-tags", str(self.repo_dir), f"+{last}:refs/contrib-restore", cwd=dst)
            self.cgit("read-tree", "-u", "--reset", "refs/contrib-restore")
            self.cgit("reset", "-q")
            got = self.tree_key()
            want = self.cgit("rev-parse", "refs/contrib-restore^{tree}")
            self.cgit("update-ref", "-d", "refs/contrib-restore")
            if got != want:
                self.log(f"restored {last} but the tree differs ({got[:12]} vs {want[:12]}); check by hand")
            self.state(wip_pending=False, wip_restored=last)
        return dst

    def save_clone(self):
        """Copy every branch out first (an object transfer runs nothing from the clone's config),
        then snapshot unfinished work in the jail, copy the branch and the snapshot into the
        pipeline clone, verify both, and only then delete the clone. A HEAD that does not
        resolve keeps the clone for a person; a rewritten branch keeps its old tip."""
        dst = self.clone()
        if not dst.exists():
            return "no clone"
        if dst.is_symlink() or not inside(dst, WORK):
            raise RuntimeError(f"{dst} is not a plain folder under {WORK}; kept")
        s = self.st()
        slug, branch = self.cand.name, s.get("branch", "")
        n = len(self.wip_refs(slug)) + 1
        keep = f"refs/contrib-keep/{slug}/{n}"
        self.fetch_from_clone(f"+refs/heads/*:{keep}/*", check=False)
        notes = []
        head = self.cgit("rev-parse", "--verify", "--quiet", "HEAD", check=False)
        if not re.fullmatch(r"[0-9a-f]{40}", head):
            raise RuntimeError(f"HEAD does not resolve in {dst}; its branches are copied under {keep}/, "
                               "the clone is kept for a person")
        self.cgit("read-tree", "HEAD", index=True)
        self.cgit("add", "-A", index=True)
        keep_files = []
        for p in self.cgit("ls-files", "-z", "-o", "-i", "--exclude-standard", check=False).split("\0"):
            try:
                st_ = os.lstat(dst / p) if p else None
            except OSError:
                st_ = None
            if st_ and stat.S_ISREG(st_.st_mode) and st_.st_size <= 1_000_000:
                keep_files.append(p)
        keep_files = keep_files[:200]
        for i in range(0, len(keep_files), 50):
            self.cgit("add", "-f", "--", *keep_files[i:i + 50], index=True)
        tree = self.cgit("write-tree", index=True)
        snap = None
        if tree != self.cgit("rev-parse", "HEAD^{tree}"):
            snap = self.cgit("commit-tree", tree, "-p", head, "-m",
                             f"WIP snapshot of {slug} at stop ({one_line(self.stop_reason or 'stop', 100)})")
        elif branch and head != self.cgit("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False):
            snap = head      # a detached or moved HEAD: keep it too
        for op, marker in (("rebase", "rebase-merge"), ("rebase", "rebase-apply"), ("merge", "MERGE_HEAD"),
                           ("cherry-pick", "CHERRY_PICK_HEAD"), ("revert", "REVERT_HEAD")):
            if os.path.lexists(dst / ".git" / marker):
                self.cgit(op, "--abort", check=False)
                notes.append(f"aborted an in-progress {op} (its state is in the snapshot)")
        if branch and self.cgit("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False):
            inc = f"refs/contrib-incoming/{slug}"
            self.fetch_from_clone(f"+refs/heads/{branch}:{inc}")
            new = self.git("rev-parse", inc)
            if new != self.cgit("rev-parse", f"refs/heads/{branch}"):
                raise RuntimeError("branch copy does not match; clone kept")
            old = self.git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False)
            if old and old != new and not self.git_ok("merge-base", "--is-ancestor", old, new):
                self.git("update-ref", f"refs/contrib-rewritten/{slug}/{n}", old)
                notes.append(f"the branch was rewritten; its old tip is kept as refs/contrib-rewritten/{slug}/{n}")
            self.git("update-ref", f"refs/heads/{branch}", new)
            self.git("update-ref", "-d", inc)
        if snap:
            ref = f"refs/contrib-wip/{slug}/{n}"
            self.cgit("update-ref", "refs/contrib-save", snap)
            self.fetch_from_clone(f"+refs/contrib-save:{ref}")
            if self.git("rev-parse", ref) != snap:
                raise RuntimeError("snapshot copy does not match; clone kept")
            self.state(wip_ref=ref, wip_saved=now(), wip_pending=True)
            notes.append(f"unfinished work saved as {ref}")
        tip = self.git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", check=False) if branch else ""
        others = []
        for line in self.git("for-each-ref", "--format=%(objectname) %(refname)", f"{keep}/", check=False).splitlines():
            sha, ref = line.split(" ", 1)
            if tip and (sha == tip or self.git_ok("merge-base", "--is-ancestor", sha, tip)):
                self.git("update-ref", "-d", ref)
            else:
                others.append(ref)
        if others:
            notes.append(f"other branches the session made are kept under {keep}/")
        shutil.rmtree(dst)
        self.state(clone_removed=now())
        return "; ".join(notes + ["clone removed"])

    # ----- stages --------------------------------------------------------------------
    def stage_loop(self, stage, stage_file, model, extra_prompt=""):
        nxt = self.sdir / "next.json"
        first = True
        retry_note, last_prompt, errors, bad_next = "", "", 0, 0
        turns = 0
        while turns < MAX_TURNS[stage]:
            self.check_stop(between=first)
            nxt.unlink(missing_ok=True)
            if retry_note:
                prompt, retry_note = retry_note + last_prompt, ""
            elif first:
                prompt = (f"Run stage {stage} for the candidate in {self.cand}. That folder is read-only for you "
                          f"except {self.sdir}, where your packet, notes, PR body and next.json go. Your working "
                          f"directory is the candidate's own clone. Read state.json, gh/, results/index.jsonl and "
                          f"session/packet.md (if any) first. Follow the stage checklist in your instructions. "
                          f"End by writing {nxt}." + extra_prompt)
            else:
                prompt = (f"The driver ran your requests. New lines are at the end of {self.cand}/results/index.jsonl; "
                          f"each line names its log file. Continue stage {stage}, then write {nxt}.")
            cut = self.st().get("cut_note")
            if isinstance(cut, str) and cut and cut not in prompt:   # a retry resends the prompt that has it
                prompt = cut + "\n\n" + prompt
            last_prompt = prompt
            res = self.session(stage, self.clone(), prompt, self.system_text(stage_file), model,
                               [self.clone(), self.sdir], self.clone(), self.cand)
            self.check_stop()
            first = False
            act = read_session_json(nxt)
            if not act and (res.get("is_error") or res.get("_rc")):
                # An overloaded API, a dropped connection or a turn timeout is not the candidate's
                # fault: wait and retry once, then stop the run so the candidate stays resumable.
                errors += 1
                why = one_line(res.get("result") or f"exit {res.get('_rc')}", 200)
                if errors >= 2:
                    self.request_stop("soft", f"stage {stage}: two session errors in a row ({why})")
                    raise StopRun()
                self.log(f"candidate {self.cand.name}: stage {stage} session error, retrying in 60 s: {why}")
                for _ in range(60):
                    time.sleep(1)
                    self.check_stop()
                retry_note = (f"Your previous turn ended with an error ({why}) before you wrote next.json. "
                              "If you had already acted on the message below, check where you got to and "
                              "carry on; otherwise act on it now.\n\n")
                continue
            errors = 0
            turns += 1
            if self.st().get("cut_note"):
                self.state(cut_note="")         # this turn's prompt carried it
            a = act.get("action") if act else None
            if a == "run":
                bad_next = 0
                self.state(stage=stage, last_request=now())
                self.run_requests(act.get("requests"))
                if self.cut_note:
                    self.state(cut_note=self.cut_note)
                continue
            if a in ("stage-done", "needs-you", "abandon"):
                return act
            why = (f"next.json has an unknown action {one_line(a, 40)!r}" if act
                   else "the turn ended without a readable next.json (a regular file holding a JSON object)")
            bad_next += 1
            if bad_next >= 2:
                return {"action": "driver-stop", "reason": f"stage {stage}: {why}, twice"}
            retry_note = f"The driver could not use your last turn: {why}. "
            continue
        return {"action": "driver-stop", "reason": f"stage {stage} used all {MAX_TURNS[stage]} turns"}

    def final_checks(self):
        """Mechanical checks on stage C output: files exist, the packet's shape, no dashes, no attribution."""
        problems = []
        texts = {}
        for f in ("packet.md", "details.md", "PR_BODY.md"):
            t = read_session_file(self.sdir / f)
            if t is None:
                problems.append(f"session/{f} missing, not a regular file, or over "
                                f"{SESSION_FILE_LIMIT // 1_000_000} MB")
                continue
            texts[f] = t
            if EM_DASH in t or EN_DASH in t:
                problems.append(f"session/{f} contains an em or en dash")
            if f != "details.md" and re.search(r"co-authored-by|generated with \[?claude", t, re.I):
                problems.append(f"session/{f} contains attribution")
        if "packet.md" in texts:
            problems += packet_problems(texts["packet.md"])
        review = read_session_file(self.sdir / "evidence" / "review.md")
        if not review or len(review.strip()) < 200:
            problems.append("session/evidence/review.md (the code-reviewer subagent's own report) is missing or empty")
        why = self.review_check()
        if why:
            problems.append(why + "; then save its report as session/evidence/review.md")
        base = self.st()["base_sha"]
        self.git_dir_check()
        if self.cgit("symbolic-ref", "-q", "HEAD", check=False) != f"refs/heads/{self.st()['branch']}":
            problems.append(f"HEAD is not on branch {self.st()['branch']}; check it out and commit there")
        log = self.cgit("log", "--no-show-signature", "--format=%B", f"{base}..HEAD", check=False)
        if not self.cgit("rev-list", f"{base}..HEAD", check=False):
            problems.append("no commits on the branch")
        if EM_DASH in log or EN_DASH in log:
            problems.append("a commit message contains an em or en dash")
        if re.search(r"co-authored-by|generated with \[?claude", log, re.I):
            problems.append("a commit message contains attribution")
        diff = self.cgit("diff", "--no-ext-diff", "--no-textconv", f"{base}..HEAD", check=False)
        added = [l for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++")]
        if any(EM_DASH in l or EN_DASH in l for l in added):
            problems.append("the diff adds a line with an em or en dash")
        if self.cgit("status", "--porcelain", check=False):
            problems.append("uncommitted changes left in the clone")
        problems += self.citation_problems(log, texts.get("PR_BODY.md", ""), diff, base)
        return problems

    CITATION_NAMES_CHECKED = 50

    def citation_problems(self, log, body, diff, base):
        """The profile's PUBLIC_FORBID_RE names reference-source citations that must stay out of
        what goes public; details.md may keep them. Commit messages and the PR body are checked
        as they are. In the diff only a name the change brings in counts: one the same change
        removes (a line it rewords) or one already in the base tree (test data, an existing
        comment) is the project's own, not a new citation."""
        pat = self.prof.get("PUBLIC_FORBID_RE", "")
        if not pat:
            return []
        try:
            rx = re.compile(pat)
        except re.error as e:
            return [f"the profile's PUBLIC_FORBID_RE is not a valid pattern ({e}); tell the user"]
        fix = "state the reference's behaviour instead and keep file and line citations in details.md"
        out = []
        for where, text in (("a commit message", log), ("session/PR_BODY.md", body)):
            m = rx.search(text)
            if m:
                out.append(f"{where} cites reference source ({one_line(m.group(0), 80)!r}); {fix}")
        removed, added, path, header = set(), {}, "?", False
        for l in diff.splitlines():
            if l.startswith("diff --git "):
                header = True
            elif header:  # file headers run from "diff --git" to the first hunk
                if l.startswith("+++ "):
                    path = l[6:] if l.startswith("+++ b/") else l[4:]
                header = not l.startswith("@@")
            elif l.startswith("-"):
                removed.update(m.group(0) for m in rx.finditer(l[1:]))
            elif l.startswith("+"):
                for m in rx.finditer(l[1:]):
                    added.setdefault(m.group(0), path)
        new = [(n, p) for n, p in added.items() if n not in removed]
        for n, p in new[:self.CITATION_NAMES_CHECKED]:
            if not self.cgit("grep", "-F", "-l", "-e", n, base, "--", ".", check=False):
                out.append(f"{one_line(p, 120)} adds a citation of reference source "
                           f"({one_line(n, 80)!r}); {fix}")
        if len(new) > self.CITATION_NAMES_CHECKED:
            out.append(f"the diff adds {len(new)} different names that look like reference-source "
                       f"citations; only {self.CITATION_NAMES_CHECKED} were checked, so tell the user")
        return out

    def review_check(self):
        """'' when stage C's own transcript (under ~/.claude, which sessions can neither read nor
        write) shows a code-reviewer subagent call that completed, used tools and returned a
        real report; else the reason. Every reviewer call, in order, goes to the driver-owned
        results/review-transcript.md with its brief and report, followed by every tool call made
        after the last good review that could have changed code, so the user sees all of it."""
        sid = read_json(self.cand / "sessions.json", {}).get("C")
        if not isinstance(sid, str) or not re.fullmatch(r"[0-9a-f-]{36}", sid):
            return "stage C has no session id"
        uses, results, calls, seen = {}, {}, [], set()
        pos = 0
        for t in self.transcripts(sid):
            with open(t, encoding="utf-8", errors="replace") as f:
                for line in f:
                    try:
                        o = json.loads(line)
                    except ValueError:
                        continue
                    # Only the conversation itself: Claude Code also writes other line types (an
                    # api-request copy of the messages, for one) that repeat earlier tool calls
                    # without their toolUseResult, and a later copy must not stand in for the
                    # real result or move a call's place.
                    if not isinstance(o, dict) or o.get("type") not in ("user", "assistant"):
                        continue
                    msg = o.get("message")
                    content = msg.get("content") if isinstance(msg, dict) else None
                    for part in content if isinstance(content, list) else []:
                        if not isinstance(part, dict):
                            continue
                        pos += 1
                        inp = part.get("input") if isinstance(part.get("input"), dict) else {}
                        if part.get("type") == "tool_use":
                            uid = str(part.get("id"))
                            if uid in seen:
                                continue
                            seen.add(uid)
                            if part.get("name") in ("Agent", "Task") and inp.get("subagent_type") == "code-reviewer":
                                uses[uid] = (pos, inp)
                            else:
                                calls.append((pos, str(part.get("name")), inp, uid))
                        elif part.get("type") == "tool_result" and part.get("tool_use_id"):
                            results.setdefault(str(part["tool_use_id"]), (part, o.get("toolUseResult")))
        if not uses:
            return ("no code-reviewer subagent call is in the stage C transcript; spawn it with the Agent "
                    "tool, subagent_type code-reviewer, in the foreground")
        verdicts = []
        for uid, (at, inp) in uses.items():
            why, text = "", ""
            if uid not in results:
                why = "the code-reviewer call has no result in the transcript"
            else:
                part, tur = results[uid]
                text = tool_text(part.get("content"))
                if part.get("is_error"):
                    why = "the code-reviewer call ended in an error"
                elif inp.get("run_in_background") or (isinstance(tur, dict) and (
                        tur.get("isAsync") or tur.get("status") == "async_launched")):
                    why = ("the code-reviewer ran in the background, so its result here is only a launch "
                           "notice and the code may have changed while it worked; run it again in the "
                           "foreground (no run_in_background)")
                elif isinstance(tur, dict) and (tur.get("status") not in (None, "completed")
                                                or tur.get("agentType") not in (None, "code-reviewer")):
                    why = f"the code-reviewer call did not complete (status {tur.get('status')!r})"
                elif isinstance(tur, dict) and isinstance(tur.get("totalToolUseCount"), int) \
                        and tur["totalToolUseCount"] < 1:
                    why = "the code-reviewer read nothing (no tool calls); give it the diff to review"
                else:
                    if isinstance(tur, dict):
                        # A subagent can hand its report back as a message; the result's content
                        # is then a short pointer and the report itself is in handbackReport.
                        hb = tur.get("handbackReport")
                        hb = hb.get("text") if isinstance(hb, dict) else None
                        text = (hb if isinstance(hb, str) else "") or tool_text(tur.get("content")) or text
                    if len(text.strip()) < 200:
                        why = "the code-reviewer's report is too short to be a review"
            verdicts.append((uid, at, inp, why, text))
        good = [v for v in verdicts if not v[3]]
        if not good:
            return verdicts[-1][3]
        last_at = good[-1][1]
        sdir = os.path.realpath(self.sdir)

        def may_change_code(name, inp):
            if name in ("Read", "Glob", "Grep", "WebFetch", "TodoWrite"):
                return False
            if name in ("Write", "Edit", "MultiEdit", "NotebookEdit"):
                path = os.path.realpath(str(inp.get("file_path") or inp.get("notebook_path") or "/"))
                return not (path == sdir or path.startswith(sdir + "/"))
            return True

        # A reviewer call can itself run commands, and a background command started before the
        # review can finish after it: both count as changes the review may not have seen.
        # A background agent is the same: a reviewer refused for running in the background, or
        # any other agent or task started that way, can still be working after the review.
        def background(uid, inp):
            tur = results.get(uid, (None, None))[1]
            return bool(inp.get("run_in_background")) or (isinstance(tur, dict) and bool(
                tur.get("isAsync") or tur.get("status") == "async_launched"))

        after = [(n, i) for at, n, i, _ in calls if at > last_at and may_change_code(n, i)]
        after += [("Agent", i) for at, i in uses.values() if at > last_at]
        after += [(n, i) for at, n, i, u in calls
                  if at <= last_at and n in ("Bash", "Agent", "Task") and background(u, i)]
        after += [("Agent", i) for u, (at, i) in uses.items() if at < last_at and background(u, i)]
        out = [f"# Code review, copied by the driver from stage C's transcript\n\nSession {sid}: "
               f"{len(verdicts)} reviewer call(s), {len(good)} usable. All of them follow, in order.\n"]
        for k, (uid, at, inp, why, text) in enumerate(verdicts, 1):
            out.append(f"\n## Review {k} (call {uid}){': NOT USABLE, ' + why if why else ''}\n\n"
                       f"### The brief the session gave the reviewer\n\n{inp_text(inp.get('prompt'))}\n\n"
                       f"### The reviewer's report\n\n{text.strip() or '(none)'}\n")
        out.append(f"\n## Calls after the last usable review that could have changed code: {len(after)}\n\n")
        for n, i in after[:200]:
            detail = i.get("command") or i.get("file_path") or i.get("notebook_path") or i.get("prompt") or ""
            out.append(f"- {n}: `{one_line(str(detail), 240).replace('`', chr(39))}`\n")
        if not after:
            out.append("None: the final code is the code the last usable review saw.\n")
        (self.cand / "results" / "review-transcript.md").write_text("".join(out))
        self.state(review={"calls": len(verdicts), "usable": len(good), "changes_after": len(after)})
        return ""

    def test_key(self, r):
        """What makes two test requests the same run: (crate, target, filter) in cargo mode,
        (paths, filter) in commands mode. A list, as the gate stores it in state.json."""
        if self.commands:
            paths = r.get("paths") if isinstance(r.get("paths"), list) else []
            return ["\n".join(str(p) for p in paths), r.get("filter", "")]
        return [r.get("crate"), r.get("target", "lib"), r.get("filter", "")]

    def replay_tests(self, skip_gone=False):
        """The candidate's passing test requests, each once (see test_key)."""
        tests, seen = [], set()
        idx = self.cand / "results" / "index.jsonl"
        for line in (idx.read_text(errors="replace").splitlines() if idx.is_file() else []):
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            r = rec.get("req") if isinstance(rec, dict) else None
            if rec.get("kind") == "test" and rec.get("expect") == "pass" and rec.get("met") and isinstance(r, dict) \
                    and not str(rec.get("id", "")).startswith(("retest-", "gate-")):
                key = tuple(self.test_key(r))
                if key not in seen:
                    seen.add(key)
                    if self.commands:
                        tests.append({"kind": "test", "paths": key[0].split("\n") if key[0] else [], "filter": key[1]})
                    else:
                        tests.append({"kind": "test", "crate": key[0], "target": key[1], "filter": key[2]})
        # Each final gate replays every test, so one that is still gone is reported again and one
        # the session restored counts again; contrib-publish shows the gate's list. Only a retest,
        # which comes after that gate, leaves the gone ones out.
        if not skip_gone:
            return tests
        gone = {tuple(g) for g in (self.st().get("gate") or {}).get("gone_reqs", []) if isinstance(g, list)}
        return [t for t in tests if tuple(self.test_key(t)) not in gone]

    def changed_test_files(self, base):
        """Files the branch's own commits add or change that the profile's TEST_FILES globs call
        tests, and that still exist: the gate runs them all, expecting pass."""
        globs = self.prof.get("TEST_FILES", "").split()
        out = []
        for n in self.cgit("diff", "--name-only", "--no-renames", "--diff-filter=AM", "-z", f"{base}..HEAD",
                           check=False).split("\0"):
            if n and any(fnmatch.fnmatchcase(n, g) for g in globs) and self.session_paths([n]):
                out.append(n)
        if len(out) > 40:
            self.log(f"candidate {self.cand.name}: gate runs 40 of the {len(out)} changed test files; "
                     "left out: " + one_line(", ".join(out[40:]), 300))
        return out[:40]

    def setup_paths_touched(self, base):
        """Files under the profile's SETUP_KEY paths that the branch changes. Every run used their
        base version (the dependency setup installs from the base commit), so none was tested."""
        keys = self.prof.get("SETUP_KEY", "").split()
        if not keys:
            return []
        return [n for n in self.cgit("diff", "--name-only", "--no-renames", "-z", f"{base}..HEAD", "--", *keys,
                                     check=False).split("\0") if n]

    def replay_split(self, tests, stamp):
        """Commands mode: the replayed tests whose files all still exist in the clone, to run, and
        those with a file the branch removed or renamed since it passed, counted as gone."""
        run, gone = [], []
        for i, t in enumerate(tests):
            r = dict(t, id=f"{stamp}-t{i}")
            (run if all(os.path.lexists(self.clone() / p) for p in t.get("paths", [])) else gone).append(r)
        return run, gone

    def changed_crates(self, base):
        """Package names of the crates the branch's own commits touch (nearest Cargo.toml)."""
        out, clone = set(), self.clone()
        for n in self.cgit("diff", "--name-only", "-z", f"{base}..HEAD", check=False).split("\0"):
            if not n or ".." in Path(n).parts:
                continue
            d = (clone / n).parent
            while True:
                m = d / "Cargo.toml"
                if m.is_file() and not m.is_symlink():
                    txt = m.read_text(errors="replace")[:20000]
                    pk = re.search(r'^\[package\][^\[]*?^name\s*=\s*"([\w-]{1,60})"', txt, re.M)
                    if pk:
                        out.add(pk.group(1))
                    break
                if d == clone or d == d.parent:
                    break
                d = d.parent
        return out

    def final_gate(self):
        """The driver's own last word, on a fresh clone of the committed branch: nothing the
        session left in its working tree (ignored files, a local .cargo config) is present, the
        target dir and cached binaries are thrown away, and before every step the tree is
        cleaned and checked against the commit. Runs the candidate's passing tests, clippy on
        the crates it tested and touched, and the full YAML suite. '' or the reason."""
        tests = self.replay_tests()
        if not tests:
            return "no passing test requests were recorded"
        self.node_stop()
        s = self.st()
        ignored = [p for p in self.cgit("ls-files", "-z", "-o", "-i", "--exclude-standard",
                                        check=False).split("\0") if p and p not in SANDBOX_MASKS][:20]
        if ignored:
            self.log(f"candidate {self.cand.name}: files git ignores were in the clone, left out of the gate: "
                     + one_line(", ".join(ignored), 300))
        tip = self.cgit("rev-parse", f"refs/heads/{s['branch']}")
        self.save_clone()
        self.make_clone(self.cand.name, s["branch"], s["base_sha"], restore=False)
        self.state(wip_pending=False)
        head = self.cgit("rev-parse", "HEAD")
        if head != tip:
            return f"the fresh clone is at {head[:12]}, not the branch tip {tip[:12]} the checks covered"
        shutil.rmtree(self.target_dir(), ignore_errors=True)
        shutil.rmtree(self.bins(), ignore_errors=True)
        self.state(binaries={})
        stamp = "gate-" + time.strftime("%m%d-%H%M%S")
        if self.commands:
            # The repo's own checks first, then every test the sessions saw pass, then the test
            # files the branch changes, all on this fresh clone.
            crates = []
            touched = self.setup_paths_touched(s["base_sha"])
            if touched:
                return ("the branch changes files the dependency setup installs from the base commit ("
                        + one_line(", ".join(touched), 200) + "), so no run tested that change")
            reqs = [{"kind": "check", "name": n, "id": f"{stamp}-{n.lower()}"} for n in self.prof.get("GATE_CHECKS", "").split()]
            replay, missing = self.replay_split(tests, stamp)
            reqs += replay
            # Test files the branch adds or changes, less those a replayed run already covers whole.
            covered = {p for t in tests if not t.get("filter") for p in t.get("paths", [])}
            changed = [p for p in self.changed_test_files(s["base_sha"]) if p not in covered]
            if changed:
                reqs.append({"kind": "test", "paths": changed, "filter": "", "id": f"{stamp}-changed"})
        else:
            missing = []
            crates = sorted({t["crate"] for t in tests} | self.changed_crates(s["base_sha"]))
            # The YAML suite and clippy run first, so nothing a session-chosen test build leaves in
            # the target dir can feed them.
            reqs = [{"kind": "fmt", "check": True, "id": f"{stamp}-fmt"},
                    {"kind": "yaml", "full": True, "id": f"{stamp}-yaml"},
                    {"kind": "clippy", "workspace": True, "crates": crates, "id": f"{stamp}-clippy"}]
            reqs += [dict(t, id=f"{stamp}-t{i}") for i, t in enumerate(tests)]
        self.log(f"candidate {self.cand.name}: final gate on a fresh clone and build, {len(reqs)} runs")
        bad = []

        def tree_moved():
            return bool(self.cgit("status", "--porcelain", check=False)) or self.cgit("rev-parse", "HEAD") != head

        for r in reqs:
            self.cgit("clean", "-ffdxq")
            if tree_moved():
                bad.append(f"the clone changed before {r['id']} (a gate step wrote to tracked files)")
                break
            self.run_requests([r], driver=True)
        self.check_stop()
        self.node_stop()
        if not bad:
            self.cgit("clean", "-ffdxq")      # as before each step: only tracked changes count
            if tree_moved():
                bad.append("the clone changed during the last gate step (it wrote to tracked files)")
        recs = {}
        idx = self.cand / "results" / "index.jsonl"
        for line in idx.read_text(errors="replace").splitlines():
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if isinstance(rec, dict) and str(rec.get("id", "")).startswith(stamp + "-"):
                recs[rec["id"]] = rec
        infra = [i for i, rec in recs.items() if rec.get("infra")]
        if not bad and infra:
            # A memory kill, a full disk or a lock timeout says nothing about the change.
            self.request_stop("soft", f"final gate: the machine, not the change, stopped {', '.join(infra)}; "
                                      "resume to run the gate again")
            raise StopRun()
        gone = []
        if not bad:
            def no_test_ran(rec):
                return rec.get("kind") == "test" and gone_note(rec.get("note"))
            passed = [r["id"] for r in reqs if r.get("kind") == "test" and recs.get(r["id"], {}).get("met")]
            gone = ([r["id"] for r in reqs if no_test_ran(recs.get(r["id"], {}))] + [r["id"] for r in missing]
                    if passed else [])
            bad = [f"not met: {r['id']}" for r in reqs
                   if not recs.get(r["id"], {}).get("met") and r["id"] not in gone]
            bad += [f"not met: {r['id']} (its test files are gone, and no other test passed)"
                    for r in missing if r["id"] not in gone]
            if gone:
                self.log(f"candidate {self.cand.name}: gate: {', '.join(gone)} matched no test (renamed or "
                         "removed since it passed); not counted, shown at publish")
        self.state(gate={"at": now(), "head": head, "ok": not bad, "gone": gone,
                               "gone_reqs": [self.test_key(r) for r in reqs + missing if r["id"] in gone],
                               "ids": [r["id"] for r in reqs + missing],
                         "crates": crates, "ignored_files": ignored})
        return "; ".join(bad)

    def safe_final_checks(self):
        try:
            return self.final_checks()
        except Exception as e:      # session-made content must not stop the whole run
            return [f"the final checks could not run: {type(e).__name__}: {one_line(e, 200)}"]

    def new_slug(self, raw):
        slug = re.sub(r"[^a-z0-9-]+", "-", str(raw or "").lower()).strip("-")[:48].strip("-")
        if not slug:
            slug = f"cand-{self.run_id}"
        base, n = slug, 2
        while (LEDGER / "candidates" / slug).exists() or (WORK / "clones" / slug).exists():
            slug = f"{base}-{n}"
            n += 1
        return slug

    def work_candidate(self, c, resume_dir=None):
        if resume_dir:
            self.cand = Path(resume_dir)
            slug = self.cand.name
        else:
            slug = self.new_slug(c.get("slug"))
            self.cand = LEDGER / "candidates" / slug
        for d in ("results", "gh", "sessions", "session"):
            (self.cand / d).mkdir(parents=True, exist_ok=True)
        n = None
        if not resume_dir:
            base = self.git("rev-parse", self.upstream)
            n = issue_number(c.get("issue"))
            self.state(slug=slug, repo=self.repo, title=one_line(c.get("title"), 200),
                       source=one_line(c.get("source"), 200), issue=n if n and n > 0 else None,
                       status="running", stage="A", stages_done=[], base_sha=base,
                       branch=self.prof.get("BRANCH_PREFIX", "fix/") + slug, clone=str(self.clone()),
                       search_terms=c.get("search_terms", []),
                       run=self.run_id, started=now(), candidate=c)
        else:
            self.state(status="running", run=self.run_id, stop_reason=None, stop_kind=None)
        s = self.st()
        if self.assign_first and n == -1:
            # Assignment first cannot be checked without the issue: never guess, drop it.
            why = f"the scout's issue field {one_line(c.get('issue'), 40)!r} is not an issue number"
            self.reject(self.cand.name, why)
            return self.finish("abandoned", reason=why)
        if self.assign_first and isinstance(s.get("issue"), int):
            stop = self.assignment_stop(s["issue"], None if resume_dir else c)
            if stop:
                return stop
        self.snapshot(self.cand / "gh")
        self.make_clone(slug, s["branch"], s["base_sha"])
        self.log(f"candidate {slug}: {'resuming at stage ' + s.get('stage', 'A') if resume_dir else 'started'}")
        act = {}
        for stage, f in (("A", "A-investigate.md"), ("B", "B-fix.md"), ("C", "C-finish.md")):
            if stage in self.st().get("stages_done", []):
                continue
            self.state(stage=stage)
            extra = ""
            if stage == "C":
                self.snapshot(self.cand / "gh")      # fresh view for the last overlap check
                extra = " The gh/ snapshot was just refreshed: recheck claims and overlapping PRs first."
            pend = self.st().get("answer_pending")
            if pend:
                who = pend.get("asked_by") or "session"
                lead = {"session": " The user answered your needs-you question. Your question: ",
                        "gate": " The driver's final gate on a fresh build failed after your stage C. What it said: ",
                        "driver": " The driver stopped this candidate with an error of its own. What it said: ",
                        "assign": " The issue is now assigned to the user, so the work can start. The driver's note: "
                        }.get(who, " The user answered a question about this candidate. The question: ")
                extra += (f"{lead}{one_line(pend.get('question'), 400)} The user's answer: "
                          f"{one_line(pend.get('answer'), 2000)} Act on the answer and continue stage {stage} "
                          "from where it stopped.")
            act = self.stage_loop(stage, f, self.args.model, extra)
            if pend:
                self.state(answer_pending=None, question=None, asked_by=None, context=None)
            if stage == "C" and act.get("action") == "stage-done":
                problems = self.safe_final_checks()
                if problems and not self.stop_kind:
                    (self.cand / "results" / "final-checks.txt").write_text("\n".join(problems) + "\n")
                    act = self.stage_loop("C", f, self.args.model,
                                          f" The driver's final checks found problems, listed in "
                                          f"{self.cand}/results/final-checks.txt. Fix every one, then finish again.")
                    problems = self.safe_final_checks() if act.get("action") == "stage-done" else problems
                if act.get("action") == "stage-done" and problems and self.stop_kind:
                    raise StopRun()          # stopped before the fix-up turn; resume reruns C
                if act.get("action") == "stage-done" and problems:
                    return self.finish("needs-you", asked_by="driver",
                                       question="stage C finished twice but the driver's final checks still fail: "
                                       + one_line("; ".join(problems), 300),
                                       context="see results/final-checks.txt")
            a = act.get("action")
            if a == "stage-done":
                self.state(stages_done=self.st().get("stages_done", []) + [stage])
                self.log(f"candidate {slug}: stage {stage} done: {one_line(act.get('summary'), 200)}")
                continue
            if a == "needs-you":
                return self.finish("needs-you", asked_by="session", question=one_line(act.get("question"), 400),
                                   context=one_line(act.get("context"), 800))
            if a == "abandon":
                self.reject(slug, act.get("reason", ""))
                return self.finish("abandoned", reason=one_line(act.get("reason"), 300))
            if a == "driver-stop":
                return self.finish("needs-you", asked_by="driver", question=one_line(act.get("reason"), 400),
                                   context="answer to let the same session carry on, or reject the candidate")
            return self.finish("failed", reason=one_line(act.get("reason", f"stage {stage}: {a}"), 300))
        self.check_stop(between=True)
        lost = self.assignment_recheck()
        if lost:
            return lost
        gate = self.final_gate()
        if gate:
            return self.finish("needs-you", asked_by="gate",
                               question="the driver's own final gate on a fresh build did not pass: "
                               + gate, context="see results/ for the gate-* logs")
        return self.finish("ready", summary=one_line(act.get("summary"), 300))

    # ----- assignment first (ASSIGN_FIRST=1) ---------------------------------------------
    def issue_assignees(self, n):
        """Logins assigned to issue n, read from GitHub by the driver. Stub runs read STUB_ASSIGNEES."""
        if self.args.stub:
            return [x for x in os.environ.get("STUB_ASSIGNEES", "").split(",") if x]
        data = json.loads(self.gh("issue", "view", str(int(n)), "-R", self.repo, "--json", "assignees"))
        return [a["login"] for a in data.get("assignees", []) if isinstance(a, dict) and isinstance(a.get("login"), str)]

    def is_assigned(self, n):
        me = self.prof["CONTRIBUTOR"].lower()
        return any(w.lower() == me for w in self.issue_assignees(n))

    def assignment_recheck(self):
        """Before the final gate: '' while the candidate's issue is still assigned to CONTRIBUTOR
        (or the repo does not ask for that); otherwise the candidate stops for the user."""
        n = self.st().get("issue")
        if self.assign_first and isinstance(n, int) and not self.is_assigned(n):
            return self.finish("needs-you", asked_by="driver",
                               question=f"issue #{n} is no longer assigned to @{self.prof['CONTRIBUTOR']}, so the "
                               "final gate did not run. Ask to be assigned again, then answer; or reject the candidate.")
        return ""

    def assignment_stop(self, n, c=None):
        """'' when issue n is assigned to CONTRIBUTOR. Assigned to someone else: the candidate is
        dropped. Unassigned: it stops before any fix work with the scout's draft of a comment
        asking to be assigned, which the user posts; --answer continues it once assigned."""
        me = self.prof["CONTRIBUTOR"]
        who = self.issue_assignees(n)
        if any(w.lower() == me.lower() for w in who):
            return ""
        if who:
            why = f"issue #{n} is assigned to {', '.join(who)}"
            self.reject(self.cand.name, why)
            return self.finish("abandoned", reason=why)
        draft = one_line((c or {}).get("assign_comment"), 1500)
        f = self.cand / "session" / "assign-comment.md"
        if draft or not f.exists():
            f.write_text((draft or "(the scout drafted no comment: write one)") + "\n")
        return self.finish("needs-you", asked_by="assign", context="session/assign-comment.md",
                           question=f"issue #{n} is not assigned to @{me}, and this repo wants that before any fix "
                           "work. Post the comment drafted in session/assign-comment.md on the issue yourself; "
                           "once a maintainer assigns you, answer this candidate to start the work.")

    def archive_transcripts(self, home):
        """Copy the sessions' transcripts and their subagents' into the ledger, gzipped: Claude Code
        deletes its own copies after 30 days. Never raises."""
        try:
            sids = set()
            for f in (home / "sessions").glob("*.json"):
                try:
                    sid = json.loads(f.read_text()).get("session_id")
                except (ValueError, OSError, AttributeError):
                    continue
                if isinstance(sid, str) and re.fullmatch(r"[0-9a-f-]{36}", sid):
                    sids.add(sid)
            out = home / "transcripts"
            for sid in sorted(sids):
                for t in self.transcripts(sid):
                    files = [(t, out / f"{sid}.jsonl.gz")]
                    sub = t.parent / sid / "subagents"
                    if sub.is_dir():
                        files += [(x, out / f"{sid}-subagents" / (x.name + ".gz")) for x in sorted(sub.iterdir())
                                  if x.is_file() and not x.is_symlink() and x.suffix in (".jsonl", ".json")]
                    for src, dst in files:
                        try:
                            dst.parent.mkdir(parents=True, exist_ok=True)
                            gz_copy(src, dst)
                        except Exception as e:
                            self.log(f"transcript archive: {src.name}: {one_line(e, 200)}")
        except Exception as e:
            self.log(f"transcript archive for {home.name}: {one_line(e, 200)}")

    def write_summary(self):
        """runs/<id>/SUMMARY.md: time, cost, denials and driver requests for this run only."""
        def ts(v):
            try:
                return datetime.datetime.fromisoformat(v).timestamp()
            except (TypeError, ValueError):
                return 0
        homes = [("scout", self.run_dir / "scout")] + [(n, LEDGER / "candidates" / n) for n, _ in self.done]
        lines = ["### Sessions", "", "| Who | Stage | Turns | Model turns | Minutes | Cost (USD) | Denials |",
                 "|---|---|---|---|---|---|---|"]
        total, denials, sess_ms, req_secs = 0.0, [], 0, 0
        for who, home in homes:
            per = {}
            for f in sorted((home / "sessions").glob("*.json")) if (home / "sessions").is_dir() else []:
                m = re.fullmatch(r"(\w+?)-(\d+)(?:_\d+)?\.json", f.name)
                if not m:
                    continue
                try:
                    d = json.loads(f.read_text())
                except (ValueError, OSError):
                    continue
                stg, sid = m.group(1), d.get("session_id")
                cost = d.get("total_cost_usd") if isinstance(d.get("total_cost_usd"), (int, float)) else 0.0
                p = per.setdefault(stg, {"turns": 0, "mt": 0, "ms": 0, "before": {}, "after": {}, "den": []})
                if int(m.group(2)) < int(self.t_start):
                    p["before"][sid] = max(p["before"].get(sid, 0.0), cost)
                    continue
                p["turns"] += 1
                p["mt"] += d.get("num_turns") or 0
                p["ms"] += d.get("duration_ms") or 0
                p["after"][sid] = max(p["after"].get(sid, 0.0), cost)
                for x in d.get("permission_denials") or []:
                    if isinstance(x, dict):
                        p["den"].append(f"{x.get('tool_name')}: {one_line(inp_text(x.get('tool_input')), 160)}")
            for stg, p in per.items():
                if not p["turns"]:
                    continue
                c = sum(max(0.0, v - p["before"].get(k, 0.0)) for k, v in p["after"].items())
                total += c
                sess_ms += p["ms"]
                lines.append(f"| {who} | {stg} | {p['turns']} | {p['mt']} | {p['ms'] / 60000:.1f} | {c:.2f} | {len(p['den'])} |")
                denials += [f"- {who} {stg}: {x}" for x in p["den"]]
        lines += ["", f"Total: {total:.2f} USD, API-equivalent as Claude Code reports it (cumulative per session, "
                      "so a resumed session counts only this run's share).", "", "### Denials", ""]
        lines += denials or ["None."]
        lines += ["", "### Driver requests", "", "| Who | Kind | Count | Not met | Infra | Minutes |", "|---|---|---|---|---|---|"]
        for who, home in homes:
            idx, agg = home / "results" / "index.jsonl", {}
            if not idx.exists():
                continue
            for line in idx.read_text(errors="replace").splitlines():
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(r, dict) or ts(r.get("at")) < self.t_start:
                    continue
                a = agg.setdefault(str(r.get("kind")), [0, 0, 0, 0])
                a[0] += 1
                a[1] += 0 if r.get("met") else 1
                a[2] += 1 if r.get("infra") else 0
                a[3] += r.get("secs") or 0
            for k, (n, nm, inf, secs) in sorted(agg.items()):
                lines.append(f"| {who} | {k} | {n} | {nm} | {inf} | {secs / 60:.1f} |")
                req_secs += secs
        words = {"ready": "ready for your review", "needs-you": "waiting on your decision",
                 "stopped": "stopped mid-way", "failed": "failed", "abandoned": "abandoned"}
        counts = {}
        for _, st in self.done:
            counts[st] = counts.get(st, 0) + 1
        outcome = ", ".join(f"{n} {words.get(st, st)}" for st, n in counts.items()) or "No candidate was worked"
        top = [f"# Run {self.run_id}", "",
               f"**{outcome[0].upper() + outcome[1:]}.** {(time.time() - self.t_start) / 60:.0f} min, "
               f"{total:.2f} USD. Ended {now()} ({self.stop_kind or 'done'}): "
               f"{md_text(self.stop_reason or 'finished', 200).rstrip('.')}.", ""]
        if self.done:
            top += ["| Candidate | Outcome | Report |", "|---|---|---|"]
            for n, st in self.done:
                title = self.report_head(LEDGER / "candidates" / n)[0] or n
                top.append(f"| {title} | {words.get(st, st)} | [packet](../../candidates/{n}/session/packet.md) |")
            top.append("")
        top += [f"Time: the sessions worked {sess_ms / 60000:.0f} min; the driver's builds, tests and suites "
                f"took {req_secs / 60:.0f} min between their turns.", "", "## Details", ""]
        (self.run_dir / "SUMMARY.md").write_text("\n".join(top + lines) + "\n")

    def answer_setup(self, slug, text):
        """--answer: record the user's answer on a needs-you candidate; the run then resumes it,
        and the stage that asked gets the answer in its next prompt."""
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,60}", slug or ""):
            raise RuntimeError(f"bad slug {slug!r}")
        cand = LEDGER / "candidates" / slug
        try:
            st = json.loads((cand / "state.json").read_text())
        except (OSError, ValueError):
            raise RuntimeError(f"no candidate {slug} in the ledger")
        if st.get("status") == "stopped" and st.get("answer_pending"):
            raise RuntimeError(f"{slug} already has your answer and was stopped before it finished; "
                               "continue it with --resume")
        if st.get("status") != "needs-you":
            raise RuntimeError(f"{slug} is {st.get('status')!r}, not waiting on an answer")
        if self.assign_first and isinstance(st.get("issue"), int) and not self.is_assigned(st["issue"]):
            raise RuntimeError(f"issue #{st['issue']} is not assigned to @{self.prof['CONTRIBUTOR']} yet; post the "
                               "comment in session/assign-comment.md and answer once a maintainer assigns you")
        if (st.get("repo") or "").lower() != self.repo.lower():
            raise RuntimeError(f"{slug} belongs to {st.get('repo')!r}; run --answer with --repo {st.get('repo')}")
        clone = st.get("clone")
        if clone and Path(clone).exists():
            raise RuntimeError(f"{slug}'s clone is still at {clone}: the driver could not save it, so its "
                               "latest work may exist only there. Look at it, then move it aside and answer again")
        text = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", " ", text or "").strip()
        if not text or len(text) > 2000:
            raise RuntimeError("the answer must be 1 to 2000 characters")
        return cand, text

    def answer_write(self, cand, text):
        """Record the answer just before the candidate runs, so a run that stops earlier
        (preflight, the open-PR cap, a STOP file) leaves the question as it was."""
        st = json.loads((cand / "state.json").read_text())
        rec = {"at": now(), "stage": st.get("stage"), "asked_by": st.get("asked_by") or "session",
               "question": st.get("question"), "answer": text}
        st["answers"] = (st.get("answers") or []) + [rec]
        st["answer_pending"] = rec
        done = st.get("stages_done") or []
        if all(x in done for x in ("A", "B", "C")):
            # Raised after stage C (the final gate, or a driver error there): reopen C, whose
            # session gets the answer, rather than rerunning the gate on unchanged code.
            st["stages_done"], st["stage"] = [x for x in done if x != "C"], "C"
        write_json(cand / "state.json", st)
        self.log(f"candidate {cand.name}: answer recorded for stage {st['stage']}")

    def finish(self, status, **info):
        self.node_stop()
        try:
            note = self.save_clone()
        except Exception as e:
            note = f"clone kept: {one_line(e, 200)}"
            status, info["question"], info["asked_by"] = "needs-you", note, "driver"
        info.setdefault("asked_by", None)
        # A needs-you candidate continues with --answer, so its build folder stays (a cold build
        # is about 13 minutes); every other end drops it. Preflight drops orphans.
        keep_build = status == "needs-you" and self.target_dir().is_dir()
        drop = [self.session_tmp(self.cand, make=False)] + ([] if keep_build else [self.target_dir(), self.bins()])
        for d in drop:
            if inside(d, WORK) and d not in (WORK, WORK / "targets", WORK / "bins", WORK / "tmp"):
                shutil.rmtree(d, ignore_errors=True)
        self.drop_copy(WORK / "snap" / f"{self.cand.name}.build")    # each build makes a new one
        self.archive_transcripts(self.cand)
        self.state(status=status, finished=now(), cleanup=note, build_kept=keep_build, **info)
        self.log(f"candidate {self.cand.name}: {status} ({note})")
        driver_stop = status == "needs-you" and info.get("asked_by") == "driver"
        self.failures_in_row = self.failures_in_row + 1 if status == "failed" or driver_stop else 0
        self.done.append((self.cand.name, status))
        self.rebuild_queue()
        self.ledger_commit(f"{self.cand.name}: {status}")
        self.cand = None
        if self.failures_in_row >= 2:
            self.request_stop("soft", "two candidates failed in a row")
        return status

    def scout(self):
        home = self.run_dir / "scout"
        sdir = home / "session"
        sdir.mkdir(parents=True, exist_ok=True)
        (home / "results").mkdir(exist_ok=True)
        self.snapshot(home / "gh")
        known = {Path(s["_dir"]).name for s in self.all_states()}
        (home / "known.txt").write_text("\n".join(sorted(known)) + "\n")
        shutil.copy2(LEDGER / "rejects.md", home / "rejects.md")
        topic = one_line(self.args.topic, 200) or "none given; use the profile's focus"
        prompt = (f"Scout {self.repo} for contribution candidates. Topic: {topic}. Your folder is {home} (read-only "
                  f"except {sdir}): GitHub snapshots in gh/, slugs already in the ledger in known.txt, past rejects "
                  f"in rejects.md. The clone is {self.repo_dir}; read code with `git -C {self.repo_dir} show "
                  f"{self.upstream}:<path>`. The contributor is @{self.prof['CONTRIBUTOR']}. Write "
                  f"{sdir}/candidates.json, then {sdir}/next.json with action stage-done.")
        if self.assign_first:
            prompt += (" In this repo, work on an issue starts only once the issue is assigned to the contributor: "
                       "add assign_comment to each issue candidate not assigned to them yet.")
        system = "\n\n---\n\n".join([(SKILL / "rules" / "common.md").read_text(), self.prof_md,
                                     (SKILL / "stages" / "scout.md").read_text()])
        nxt = sdir / "next.json"
        self.cand = None
        try:
            for _ in range(4):
                self.check_stop(between=True)
                nxt.unlink(missing_ok=True)
                self.session("scout", sdir, prompt, system, self.args.scout_model, [sdir], None, home)
                act = read_session_json(nxt)
                if act and act.get("action") == "run":
                    self.cand = home          # the scout may only ask for gh reads
                    reqs = act.get("requests") if isinstance(act.get("requests"), list) else []
                    gh = [r for r in reqs if isinstance(r, dict) and r.get("kind") == "gh"]
                    self.run_requests(gh)
                    self.cand = None
                    prompt = f"Your gh reads are done; see {home}/results/index.jsonl. Finish and write {nxt}."
                    if self.cut_note:
                        prompt = self.cut_note + "\n\n" + prompt
                    if len(gh) < len(reqs):
                        prompt = (f"{len(reqs) - len(gh)} of your requests were not gh reads and did not run: "
                                  "the scout may only ask for gh reads.\n\n" + prompt)
                    continue
                break
        finally:
            self.cand = None
            self.archive_transcripts(home)
            shutil.rmtree(self.session_tmp(home, make=False), ignore_errors=True)
        raw = read_session_file(sdir / "candidates.json")
        try:
            cands = json.loads(raw) if raw else []
        except ValueError:
            cands = []
        out = []
        for c in cands if isinstance(cands, list) else []:
            if isinstance(c, dict) and isinstance(c.get("slug"), str) and c["slug"] not in known:
                out.append({k: c[k] for k in ("slug", "title", "source", "issue", "why", "size", "risk", "issue_less",
                                              "assign_comment") if k in c})
                terms = c.get("search_terms")
                if isinstance(terms, list):
                    out[-1]["search_terms"] = [one_line(t, 60) for t in terms[:3] if isinstance(t, str) and t.strip()]
        return out

    # ----- publish-time retest --------------------------------------------------------
    def retest(self, slug, merge):
        """Re-run, in the jail, a candidate's passing test requests, clippy on their crates and
        the full YAML suite, on its branch as it now is in the pipeline clone, or with --merge on
        a trial merge with the current base. Nothing is saved back: the clone is thrown away."""
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,60}", slug or ""):
            raise RuntimeError(f"bad slug {slug!r}")
        if self.commands:
            raise RuntimeError("retest runs cargo profiles only for now; for this repo, rerun the final gate "
                               "with --answer, or test by hand")
        self.cand = LEDGER / "candidates" / slug
        s = self.st()
        if not s.get("branch") or not s.get("base_sha"):
            raise RuntimeError(f"{slug}: state.json has no branch or base")
        if not shutil.which("bwrap") or not shutil.which("socat"):
            raise RuntimeError("bubblewrap or socat missing")
        self.git("fetch", "--quiet", self.prof["UPSTREAM_REMOTE"], self.prof["BASE_BRANCH"])
        base_now = self.git("rev-parse", self.upstream)
        idx = self.cand / "results" / "index.jsonl"
        tests = self.replay_tests(skip_gone=True)
        if not tests:
            raise RuntimeError("no passing test requests are recorded for this candidate; test it by hand")
        if self.clone().exists():
            raise RuntimeError(f"{self.clone()} exists; another run may be using it")
        if not self.git("rev-parse", "--verify", "--quiet", f"refs/heads/{s['branch']}", check=False):
            raise RuntimeError(f"the pipeline clone has no branch {s['branch']}; nothing to retest")
        stamp = time.strftime("%m%d-%H%M%S") + uuid.uuid4().hex[:4]
        self.target_name = f"retest-{slug}"
        dst, head, merged = self.clone(), "", ""
        try:
            self.make_clone(slug, s["branch"], s["base_sha"], restore=False)
            head = self.cgit("rev-parse", "HEAD")
            crates = sorted({t["crate"] for t in tests} | self.changed_crates(s["base_sha"]))
            if merge:
                self.git("fetch", "-q", str(self.repo_dir), f"+refs/remotes/{self.upstream}:refs/remotes/{self.upstream}", cwd=dst)
                try:
                    self.cgit("merge", "-q", "--no-ff", "--no-edit", self.upstream)
                except RuntimeError as e:
                    raise RuntimeError(f"the trial merge with the base failed ({one_line(e, 150)}); rebase first")
                merged = base_now
            reqs = [{"kind": "fmt", "check": True, "id": f"retest-{stamp}-fmt"}]
            reqs += [dict(t, id=f"retest-{stamp}-t{i}") for i, t in enumerate(tests)]
            reqs += [{"kind": "clippy", "workspace": True, "crates": crates, "id": f"retest-{stamp}-clippy"},
                     {"kind": "yaml", "full": True, "id": f"retest-{stamp}-yaml"}]
            for r in reqs:
                self.run_requests([r], driver=True)
        finally:
            try:
                self.node_stop()
                self.sweep([dst, WORK / "nodes"])
            finally:
                shutil.rmtree(dst, ignore_errors=True)
                shutil.rmtree(self.target_dir(), ignore_errors=True)
                shutil.rmtree(self.bins(), ignore_errors=True)
                self.drop_copy(WORK / "snap" / f"{self.cand.name}.build")
        recs = []
        for line in idx.read_text().splitlines():
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if str(rec.get("id", "")).startswith(f"retest-{stamp}-"):
                recs.append(rec)
        ok = len(recs) == len(reqs) and all(r.get("met") for r in recs)
        self.state(retest={"at": now(), "head": head, "merged_with": merged, "ok": ok,
                           "ids": [r["id"] for r in recs]})
        for r in recs:
            print(f"{'ok  ' if r.get('met') else 'FAIL'} {r['id']} ({r['kind']}) exit {r['exit']}: "
                  f"{self.cand / r['log']}")
        print(f"RETEST {'ok' if ok else 'failed'} on {head[:12]}" + (f" merged with {merged[:12]}" if merged else ""))
        return EXIT_DONE if ok else EXIT_SOFT

    # ----- main and shutdown ---------------------------------------------------------
    def main(self):
        signal.signal(signal.SIGINT, self.on_signal)
        signal.signal(signal.SIGTERM, self.on_signal)
        if signal.getsignal(signal.SIGHUP) != signal.SIG_IGN:
            signal.signal(signal.SIGHUP, self.on_signal)
        threading.Thread(target=self.watchdog, daemon=True).start()
        if getattr(self.args, "approve_profile", None):
            return self.approve_profile(self.args.approve_profile)
        if getattr(self.args, "learn", False):
            try:
                return self.learn()
            except StopRun as e:
                print(f"learn stopped: {e}", file=sys.stderr)
                return EXIT_HARD
            except Exception as e:
                self.log(self.learn_failure(e))
                return 1
        if self.args.commit_ledger:
            try:
                self.ledger_commit(self.args.commit_ledger)
            except Exception as e:
                print(f"commit-ledger: {type(e).__name__}: {e}", file=sys.stderr)
                return EXIT_SOFT
            return EXIT_DONE
        if self.args.retest:
            try:
                return self.retest(self.args.retest, self.args.merge)
            except StopRun as e:
                print(f"retest stopped: {e}", file=sys.stderr)
                return EXIT_HARD
            except Exception as e:
                print(f"retest: {type(e).__name__}: {e}", file=sys.stderr)
                return EXIT_SOFT
        if self.args.answer:
            try:
                self.answer_cand = self.answer_setup(*self.args.answer)
            except RuntimeError as e:
                print(f"answer: {e}", file=sys.stderr)
                return 2
        code = EXIT_DONE
        try:
            self.preflight()
            queue = []
            if self.answer_cand:
                queue = [("resume", str(self.answer_cand[0]))]
                self.args.limit = 1          # answering runs only that candidate
            elif self.args.resume:
                queue = [("resume", s["_dir"]) for s in self.all_states() if s.get("status") == "stopped"]
            while len(self.done) < self.args.limit:
                self.check_stop(between=True)
                mine, ready = self.open_count()
                if not self.answer_cand and mine + ready >= int(self.prof.get("MAX_OPEN", 10)):
                    self.request_stop("soft", f"open-PR cap: {mine} open PRs + {ready} ready packets "
                                              f">= {self.prof.get('MAX_OPEN', 10)}")
                    break
                if not queue:
                    queue = [("new", c) for c in self.scout()]
                    if not queue:
                        self.request_stop("soft", "no good candidates left")
                        break
                kind, item = queue.pop(0)
                if self.answer_cand and kind == "resume" and item == str(self.answer_cand[0]):
                    self.answer_write(*self.answer_cand)
                try:
                    if kind == "resume":
                        self.work_candidate({}, resume_dir=item)
                    else:
                        self.work_candidate(item)
                except StopRun:
                    raise
                except Exception as e:
                    self.log(f"candidate error: {e!r}")
                    if not self.cand or self.st().get("status") != "running":
                        raise
                    self.finish("needs-you", asked_by="driver",
                                question=f"the driver hit an error on this candidate: "
                                f"{type(e).__name__}: {one_line(e, 200)}")
            if not self.stop_kind:
                self.stop_kind, self.stop_reason = "done", f"candidate limit reached ({self.args.limit})"
        except StopRun:
            pass
        except Exception as e:
            self.log(f"driver error: {e!r}")
            self.request_stop("hard", f"driver error: {one_line(e, 200)}")
        finally:
            ok = self.shutdown()
        if not ok:
            code = EXIT_SHUTDOWN_FAILED
        elif self.stop_kind == "soft":
            code = EXIT_SOFT
        elif self.stop_kind == "hard":
            code = EXIT_HARD
        self.log(f"exit {code}")
        try:
            self.ledger_commit(f"run {self.run_id}: exit {code}")
        except Exception:
            pass
        return code

    def sweep(self, roots):
        """Stop jail and build processes still pointing at our folders (after a guard was killed)."""
        roots = [str(r) for r in roots]
        killed = []
        for d in Path("/proc").iterdir():
            if not d.name.isdigit() or int(d.name) == os.getpid():
                continue
            pid = int(d.name)
            try:
                comm = (d / "comm").read_bytes().decode(errors="replace").strip()
            except OSError:
                continue
            if comm not in JAIL_TOOLS and comm not in self.prof.get("JAIL_PROCS", "").split():
                continue
            cl = cmdline(pid)
            if any(r in cl for r in roots):
                try:
                    os.kill(pid, signal.SIGKILL)
                    killed.append(f"{comm}({pid})")
                except ProcessLookupError:
                    pass
        if killed:
            self.log("stopped leftovers: " + ", ".join(killed))
        return killed

    def shutdown(self):
        """Steps 1 to 9 of the shutdown routine in DESIGN.md. Never raises."""
        steps, leftovers = [], []
        reason = self.stop_reason or "finished"
        self.log(f"shutdown: {self.stop_kind or 'done'} stop, reason: {reason}")
        # A group that outlived its stop earlier in the run (a hard stop or a time limit) counts too.
        survivors = self.survived
        for role, pgid in list(self.current.items()):
            if not stop_group(pgid, signal.SIGINT if role == "session" else signal.SIGTERM,
                              60 if role == "session" else 30, self.log):
                leftovers.append(f"{role} process group {pgid}")
                survivors = True
        try:
            if self.cand and (self.cand / "state.json").exists() and self.cand.parent == LEDGER / "candidates":
                if not self.node_stop():
                    node = self.st().get("node") or {}
                    leftovers.append(f"scratch node pid {node.get('pid')} port {node.get('port')}")
                self.sweep([self.clone(), WORK / "nodes", self.bins()])
                if survivors:
                    # Something from this run may still be writing the clone: leave it unread.
                    note = "clone kept: a process from this run was still running, so its .git was not read"
                    leftovers.append(note)
                else:
                    try:
                        note = self.save_clone()
                    except Exception as e:
                        note = f"clone kept: {one_line(e, 200)}"
                        leftovers.append(note)
                steps.append(note)
                s = self.st()
                self.state(status="stopped", stop_reason=reason, stop_kind=self.stop_kind, stopped=now(),
                           cleanup=note, last_good_sha=self.git("rev-parse", "--verify", "--quiet", s.get("branch", "-"),
                                                                check=False) or None,
                           resume=f"contrib-run --repo {self.repo} --resume")
                self.archive_transcripts(self.cand)
                self.done.append((self.cand.name, "stopped"))
        except Exception as e:
            leftovers.append(f"candidate cleanup error: {one_line(e, 200)}")
        try:
            self.sweep([WORK / "nodes", WORK / "targets", WORK / "envs"])
        except Exception as e:
            leftovers.append(f"leftover sweep error: {one_line(e, 200)}")
        for pid in list(self.started):
            try:
                os.killpg(pid, 0)
                os.killpg(pid, signal.SIGKILL)
                time.sleep(0.5)
                os.killpg(pid, 0)
                leftovers.append(f"process group {pid} still alive")
            except ProcessLookupError:
                pass
            except PermissionError:
                pass
        stamp = now()
        kind = f"Stopped ({self.stop_kind}): " if self.stop_kind in ("soft", "hard") else ""
        banner = [f"> **Run {self.run_id} ended {stamp}.** {kind}{one_line(reason, 200)}."]
        if self.done:
            banner.append("> This run: " + ", ".join(f"{n} ({st})" for n, st in self.done) + ".")
        for st in steps:
            banner.append(f"> Cleanup: {one_line(st, 200)}.")
        if leftovers:
            banner.append("> **Still running or kept, check these:** " + "; ".join(leftovers) + ".")
        if any(st == "stopped" for _, st in self.done):
            banner.append(f"> Resume with: `contrib-run --repo {self.repo} --resume`")
        try:
            self.write_summary()
            banner.append(f"> Summary: [runs/{self.run_id}/SUMMARY.md](runs/{self.run_id}/SUMMARY.md).")
        except Exception as e:
            leftovers.append(f"summary error: {one_line(e, 200)}")
        try:
            self.rebuild_queue(banner)
            self.ledger_commit(f"run {self.run_id}: {self.stop_kind or 'done'}: {reason}")
        except Exception as e:
            leftovers.append(f"ledger write error: {one_line(e, 200)}")
        for f in ("STOP", "STOP-NOW"):
            (LEDGER / f).unlink(missing_ok=True)
        self.log("shutdown complete" + (f"; leftovers: {leftovers}" if leftovers else "; nothing left running"))
        try:
            self.ledger_commit(f"run {self.run_id}: final log")
        except Exception:
            pass
        return not leftovers

    def recover_stale(self):
        """A previous run that could not shut down (sleep, wsl --shutdown, power loss)."""
        for s in self.all_states():
            if s.get("status") != "running":
                self.cand = Path(s["_dir"])
                if s.get("status") == "stopped" and self.clone().exists():
                    try:
                        note = self.save_clone()
                    except Exception as e:
                        note = f"clone still kept: {one_line(e, 200)}"
                    self.log(f"{self.cand.name}: a stopped candidate's clone was left behind; {note}")
                    self.state(cleanup=note)
                self.cand = None
                continue
            self.cand = Path(s["_dir"])
            self.log(f"recovering stale candidate {self.cand.name}")
            node = s.get("node") or {}
            for k in ("pid", "bridge"):
                pid = node.get(k)
                if pid and alive(pid) and (str(WORK / "nodes") in cmdline(pid)):
                    stop_group(pid, signal.SIGTERM, 20, self.log)
            d = node.get("dir", "")
            if d and inside(d, WORK / "nodes") and Path(d) != WORK / "nodes":
                shutil.rmtree(d, ignore_errors=True)
            self.state(node=None)
            self.sweep([self.clone(), self.bins()])
            try:
                note = self.save_clone()
            except Exception as e:
                note = f"clone kept: {one_line(e, 200)}"
            self.state(status="stopped", stop_reason="previous run ended without shutting down (sleep or power loss?)",
                       stop_kind="hard", cleanup=note, resume=f"contrib-run --repo {self.repo} --resume")
            self.cand = None
        for d in (WORK / "nodes").iterdir():
            shutil.rmtree(d, ignore_errors=True)


def main():
    ap = argparse.ArgumentParser(description="Run the contribution pipeline (never pushes or posts).")
    ap.add_argument("--repo", default="xerj-org/xerj")
    ap.add_argument("--limit", type=int, default=3, help="candidates to finish this run")
    ap.add_argument("--hours", type=float, default=8.0, help="deadline from now")
    ap.add_argument("--topic", default="", help="steer the scout")
    ap.add_argument("--resume", action="store_true", help="first pick up stopped candidates")
    ap.add_argument("--model", default="opus")
    ap.add_argument("--scout-model", default="sonnet")
    ap.add_argument("--claude", default="claude", help="the claude binary (a stub for tests)")
    ap.add_argument("--stub", action="store_true", help="test mode: no GitHub, no builds")
    ap.add_argument("--real-requests", action="store_true", help="with --stub, still run builds and nodes")
    ap.add_argument("--tick", type=float, default=60.0, help="watchdog interval, seconds")
    ap.add_argument("--commit-ledger", metavar="MESSAGE",
                    help="commit the ledger the safe way (contrib-publish uses this), then exit")
    ap.add_argument("--retest", metavar="SLUG", help="publish-time: re-run a candidate's checks in the jail, then exit")
    ap.add_argument("--answer", nargs=2, metavar=("SLUG", "TEXT"),
                    help="answer a needs-you candidate's question and continue it (runs only that candidate)")
    ap.add_argument("--merge", action="store_true", help="with --retest, test a trial merge with the current base")
    ap.add_argument("--learn", action="store_true",
                    help="learn the repo's contribution rules from its guides and PRs; writes PROFILE-REVIEW.md, "
                         "approves nothing")
    ap.add_argument("--approve-profile", metavar="ID", help="approve the learned rules with this id, then exit")
    ap.add_argument("--learn-model", default="opus")
    sys.exit(Driver(ap.parse_args()).main())


if __name__ == "__main__":
    main()
