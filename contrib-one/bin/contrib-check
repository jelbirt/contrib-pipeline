#!/usr/bin/env python3
"""contrib-check <slug>: has anything changed since this packet was made? No builds.
contrib-check --where <slug>: the candidate's repo, folders and branch, as shell assignments.

Every repo fact comes from the repo's profile: SENSITIVE_PATHS, AREAS, DOC_FILES, RATCHET_FILE
and SETUP_KEY (see SPEC.md, phase 3).

Prints facts, then one verdict line, worst first:
  merged-or-closed  upstream fixed it or the issue closed
  overlap           another PR or person has the same fix
  needs-look        something this script could not decide; read the printed lines
  rebase-code       conflicts in code: rebase, then the full bar on the final SHA
  rebase-docs       conflicts only in the profile's DOC_FILES: rebase, then the PR's tests
  retest-merge      merges cleanly, but the base changed this branch's areas (AREAS) or the
                    dependency setup (SETUP_KEY): run the PR's tests on a trial merge first
  unchanged         open it as it is
Exit 0 for unchanged, 1 for anything that needs work or a decision, 2 if the check failed.
"""
import datetime, json, os, re, shlex, subprocess, sys
from collections import Counter
from pathlib import Path

SKILL = Path(__file__).resolve().parent.parent
LEDGER = Path(os.environ.get("CONTRIB_LEDGER", Path.home() / "contrib-queue"))
NEEDED = ("REPO_DIR", "UPSTREAM_REMOTE", "BASE_BRANCH", "SENSITIVE_PATHS", "AREAS")


def after(t, since):
    """GitHub times end in Z, ours carry a local offset: compare them as moments."""
    def p(x):
        try:
            d = datetime.datetime.fromisoformat(str(x).replace("Z", "+00:00"))
        except ValueError:
            return None
        return d if d.tzinfo else d.astimezone()
    a, b = p(t), p(since)
    return a is not None and (b is None or a > b)


WHERE_MODE = False   # --where: the caller evals stdout, so a failure prints to stderr only


def fail(msg):
    out = sys.stderr if WHERE_MODE else sys.stdout
    print(f"CHECK FAILED: {msg}", file=out)
    print("VERDICT needs-look", file=out)
    sys.exit(2)


def sh(*a, check=True):
    r = subprocess.run(a, capture_output=True, text=True)
    if check and r.returncode:
        fail(f"{' '.join(a[:4])}: {r.stderr.strip()[:300]}")
    return r.stdout.strip()


def merge_tree(repo_dir, a, b):
    """Conflicted paths of a trial merge, [] when clean. Anything but exit 0 or 1 is an error."""
    r = subprocess.run(["git", "-C", repo_dir, "merge-tree", "--write-tree", "--name-only",
                        "--no-messages", a, b], capture_output=True, text=True)
    if r.returncode not in (0, 1):
        fail(f"merge-tree {a} {b}: {r.stderr.strip()[:300]}")
    return r.stdout.strip().splitlines()[1:] if r.returncode == 1 else []


def conflict_blocks(repo_dir, a, b):
    """The conflict blocks of a trial merge, by path: each block is its (ours, theirs) text with the
    marker labels dropped, so one clash reads the same from two merges. A conflicted path with no
    markers (a delete, a rename, a binary file) maps to None."""
    r = subprocess.run(["git", "-C", repo_dir, "-c", "merge.conflictStyle=merge", "merge-tree", "--write-tree",
                        "--name-only", "--no-messages", a, b], capture_output=True, text=True)
    if r.returncode not in (0, 1):
        fail(f"merge-tree {a} {b}: {r.stderr.strip()[:300]}")
    if r.returncode == 0:
        return {}
    lines = r.stdout.strip().splitlines()
    out = {}
    for path in dict.fromkeys(lines[1:]):
        blob = subprocess.run(["git", "-C", repo_dir, "cat-file", "blob", f"{lines[0]}:{path}"], capture_output=True)
        blocks, cur, side = [], None, 0
        # Bytes, split on \n only: a change of encoding or line ending is still a change. Git writes
        # the markers with the file's own line ending, so only they lose a trailing \r.
        for line in blob.stdout.split(b"\n") if blob.returncode == 0 else []:
            bare = line.rstrip(b"\r")
            if bare.startswith(b"<<<<<<<"):
                cur, side = ([], []), 0
            elif cur is not None and bare == b"=======":
                side = 1
            elif cur is not None and bare.startswith(b">>>>>>>"):
                blocks.append((b"\n".join(cur[0]), b"\n".join(cur[1])))
                cur = None
            elif cur is not None:
                cur[side].append(line)
        out[path] = blocks or None
    return out


CLAIM_WORDS = ("i'll take", "i will take", "working on", "i'm on it", "im on it", "/assign", "assign me",
               "can i take", "i'd like to work", "i would like to work", "picking this up", "opened #",
               "pr incoming", "draft pr")

PATH_KEYS = ("REPO_DIR", "USER_REPO_DIR", "GUARD", "TOOLS")   # profile keys where ~/ is the home folder
HOME_WORD = re.compile(r"(?<!\S)~(?=/|\s|$)")   # ~ or ~/... as a whole word, as a shell expands it


def load(slug):
    """A candidate's folder, state.json and repo profile, with the keys this script needs checked."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,60}", slug or ""):
        fail(f"bad slug {slug!r}")
    cand = LEDGER / "candidates" / slug
    s = json.loads((cand / "state.json").read_text())
    prof = {}
    pdir = Path(os.environ.get("CONTRIB_PROFILE_DIR", SKILL / "profiles"))
    for line in (pdir / f"{s['repo'].replace('/', '-')}.env").read_text().splitlines():
        line = "" if line.lstrip().startswith("#") else line.split(" #", 1)[0].strip()
        if "=" in line:          # read as contrib-run's load_env reads it
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip().strip('"').strip("'")
            prof[k] = HOME_WORD.sub(lambda _: str(Path.home()), v) if k in PATH_KEYS else v
    missing = [k for k in NEEDED if not prof.get(k)]
    if missing:
        fail(f"the {s['repo']} profile has no {', '.join(missing)}")
    for key in ("SENSITIVE_PATHS", "AREAS"):
        for rx in prof[key].split():
            try:
                groups = re.compile(rx).groups
            except re.error as e:
                fail(f"{key} {rx!r} is not a regex: {e}")
            if key == "AREAS" and groups < 1:
                fail(f"AREAS {rx!r} has no group naming the area")
    return cand, s, prof


def where(slug):
    """What contrib-publish needs to know about a candidate, as lines a shell can eval."""
    cand, s, prof = load(slug)
    out = {"SLUG": slug, "CAND": str(cand), "REPO": s["repo"], "BRANCH": s.get("branch", ""),
           "REPO_DIR": prof["REPO_DIR"], "USER_REPO_DIR": prof.get("USER_REPO_DIR", ""),
           "UPSTREAM_REMOTE": prof["UPSTREAM_REMOTE"], "BASE_BRANCH": prof["BASE_BRANCH"],
           "CONTRIBUTOR": prof.get("CONTRIBUTOR", ""), "FORK_CI": prof.get("FORK_CI", "")}
    for k, v in out.items():
        print(f"{k}={shlex.quote(str(v))}")


def area_of(areas, path):
    """The area a path is in: the first group of the first AREAS regex that matches, or None."""
    for rx in areas:
        m = rx.search(path)
        if m and m.group(1):
            return m.group(1)
    return None


def main():
    global WHERE_MODE
    if len(sys.argv) == 3 and sys.argv[1] == "--where":
        WHERE_MODE = True
        where(sys.argv[2])
        return
    if len(sys.argv) != 2:
        fail("usage: contrib-check <slug>, or contrib-check --where <slug>")
    slug = sys.argv[1]
    cand, s, prof = load(slug)
    sensitive = prof["SENSITIVE_PATHS"].split()
    areas = [re.compile(rx) for rx in prof["AREAS"].split()]
    doc_files = set(prof.get("DOC_FILES", "").split())
    rl = prof.get("RATCHET_FILE", "")
    setup_key = [k.rstrip("/") for k in prof.get("SETUP_KEY", "").split()]
    repo_dir, up, base = prof["REPO_DIR"], prof["UPSTREAM_REMOTE"], prof["BASE_BRANCH"]
    branch, made_from = s["branch"], s["base_sha"]
    git = lambda *a, check=True: sh("git", "-C", repo_dir, *a, check=check)
    git("fetch", "--quiet", up, base)
    if subprocess.run(["git", "-C", repo_dir, "rev-parse", "--verify", "--quiet", branch],
                      capture_output=True).returncode:
        fail(f"branch {branch} is not in {repo_dir}")
    issue = None
    try:
        issue = int(s["issue"]) if s.get("issue") not in (None, "") else None
    except (TypeError, ValueError):
        print(f"state.json issue {s.get('issue')!r} is not a number; checking without it")
    me = prof.get("CONTRIBUTOR", "")
    main_ref = f"{up}/{base}"
    main_sha = git("rev-parse", main_ref)
    mine = git("diff", "--name-only", f"{main_ref}...{branch}").splitlines()
    print(f"branch {branch} at {git('rev-parse', '--short', branch)}, made from {made_from[:9]}, "
          f"{main_ref} now {main_sha[:9]}")
    print(f"files this branch changes: {', '.join(mine)}")
    verdicts = []
    touchy = [f for f in mine if any(re.search(rx, f) for rx in sensitive)]
    if touchy:
        print(f"sensitive paths touched (show their full diff before any push): {', '.join(touchy)}")
        verdicts.append("needs-look")

    since = s.get("started") or ""
    my_ratchet = set()
    if rl and rl in mine:
        my_ratchet = {l[1:] for l in git("diff", f"{main_ref}...{branch}", "--", rl).splitlines()
                      if l.startswith("-") and not l.startswith("---")}

    # 1. upstream already has it, the issue closed, or someone claimed it
    if issue:
        st = json.loads(sh("gh", "issue", "view", str(issue), "-R", s["repo"], "--json",
                           "state,closedAt,assignees,comments"))
        if st["state"] != "OPEN":
            print(f"issue #{issue} is {st['state']} since {st['closedAt']}")
            verdicts.append("merged-or-closed")
        others = [a["login"] for a in st.get("assignees", []) if a.get("login") != me]
        if others:
            print(f"issue #{issue} is assigned to {', '.join(others)}")
            verdicts.append("overlap")
        for c in st.get("comments", []):
            who = (c.get("author") or {}).get("login", "")
            if who != me and after(c.get("createdAt"), since) and any(w in c.get("body", "").lower() for w in CLAIM_WORDS):
                print(f"possible claim on #{issue} by {who} at {c['createdAt']}: "
                      f"{' '.join(c.get('body', '').split())[:160]}")
                verdicts.append("needs-look")
    if my_ratchet:
        still = set(git("show", f"{main_ref}:{rl}", check=False).splitlines())
        gone = sorted(my_ratchet - still)
        if gone:
            print(f"the base already removed {len(gone)} of this branch's ratchet lines: {gone[0][:120]}")
            verdicts.append("merged-or-closed")

    # 2. overlap: open PRs touching the same non-doc files, and the same ratchet lines
    prs = json.loads(sh("gh", "pr", "list", "-R", s["repo"], "--state", "open", "--limit", "200",
                        "--json", "number,title,author,createdAt,files,headRefName,headRepositoryOwner,"
                        "closingIssuesReferences"))
    code_files = set(mine) - doc_files
    quiet = []
    own_base = git("merge-base", main_ref, branch)
    for pr in prs:
        if (pr.get("headRefName") == branch and (pr.get("author") or {}).get("login") == me
                and (pr.get("headRepositoryOwner") or {}).get("login") == me):
            continue                  # this candidate's own PR, already opened
        files = {f["path"] for f in pr.get("files", [])}
        shared = code_files & files
        issue_hit = bool(issue) and any(i.get("number") == issue for i in pr.get("closingIssuesReferences", []))
        ratchet_hit = False
        if my_ratchet and rl in files:
            diff = sh("gh", "pr", "diff", str(pr["number"]), "-R", s["repo"])
            theirs = {l[1:] for l in diff.splitlines() if l.startswith("-") and not l.startswith("---")}
            ratchet_hit = bool(my_ratchet & theirs)
        if issue_hit or ratchet_hit:
            print(f"OVERLAP #{pr['number']} {pr['title']} ({pr['author']['login']}): "
                  f"{'closes the same issue' if issue_hit else 'deletes the same ratchet line'}")
            verdicts.append("overlap")
        elif shared:
            # Sharing a file is common (in some repos most PRs touch one big file). What matters is
            # whether the two changes meet: a trial merge of this branch with that PR's head.
            prref = f"refs/contrib-check/pr-{pr['number']}"
            f = subprocess.run(["git", "-C", repo_dir, "fetch", "--quiet", "--no-tags", "--no-write-fetch-head", up,
                                f"+pull/{pr['number']}/head:{prref}"],
                               capture_output=True, text=True)
            if f.returncode:
                print(f"could not fetch #{pr['number']}; read it by hand: {pr['title']}")
                verdicts.append("needs-look")
                continue
            # A PR cut from an older base also "conflicts" in files neither change touched;
            # only clashes in this branch's own files mean the two changes meet.
            clash = [c for c in merge_tree(repo_dir, branch, prref) if c in mine]
            stale = []
            if clash:
                # A PR that already conflicts with this branch's own base conflicts with every branch
                # cut from it. Count only the conflict blocks this branch's commits add to those.
                ours, theirs = conflict_blocks(repo_dir, branch, prref), conflict_blocks(repo_dir, own_base, prref)
                stale = [c for c in clash if ours.get(c) and theirs.get(c)
                         and not Counter(ours[c]) - Counter(theirs[c])]
                clash = [c for c in clash if c not in stale]
            subprocess.run(["git", "-C", repo_dir, "update-ref", "-d", prref], capture_output=True)
            if stale:
                print(f"#{pr['number']} {pr['title']} ({pr['author']['login']}) already conflicts with this "
                      f"branch's base in {', '.join(stale)}; this branch adds no conflict there")
            if clash:
                new = after(pr.get("createdAt"), since)
                code_clash = set(clash) - doc_files
                what = ("same code, maybe the same fix: read its diff" if code_clash
                        else "neighbouring lines in DOC_FILES only; whichever merges second rebases")
                print(f"{'NEW ' if new else ''}CONFLICTS with #{pr['number']} {pr['title']} "
                      f"({pr['author']['login']}): {', '.join(clash)}  <- {what}")
                if code_clash:
                    verdicts.append("overlap")
            elif not stale:
                quiet.append(pr["number"])

    # 2b. a PR on the same topic that shares no file and names no issue (the #2960 case)
    seen = {pr["number"] for pr in prs}
    for term in s.get("search_terms") or []:
        hits = json.loads(sh("gh", "search", "prs", "--repo", s["repo"], "--state", "open", "--json",
                             "number,title,author,createdAt", "--limit", "20", "--", term))
        for h in hits:
            if (h.get("author") or {}).get("login") != me and after(h.get("createdAt"), since):
                print(f"same-topic PR #{h['number']} {h['title']} ({h['author']['login']}), "
                      f"found by \"{term}\": read it")
                verdicts.append("needs-look")
        seen |= {h["number"] for h in hits}

    if quiet:
        print(f"{len(quiet)} open PRs share files but merge cleanly with this branch: "
              f"{', '.join('#' + str(n) for n in quiet)}")

    # 3. does it still merge, and did the base change code this branch depends on
    if subprocess.run(["git", "-C", repo_dir, "merge-base", "--is-ancestor", main_ref, branch]).returncode == 0:
        print("base has not moved")
    else:
        conflicts = merge_tree(repo_dir, main_ref, branch)
        meet = git("merge-base", main_ref, branch)
        moved = git("diff", "--name-only", f"{meet}..{main_ref}").splitlines()
        mine_areas = {a for a in (area_of(areas, p) for p in code_files) if a}
        area_moved = sorted(p for p in moved if area_of(areas, p) in mine_areas)
        setup_moved = sorted(p for p in moved if any(p == k or p.startswith(k + "/") for k in setup_key))
        print(f"base moved {len(moved)} files; conflicts: {', '.join(conflicts) or 'none'}")
        if area_moved:
            print(f"base changed code in this branch's areas: {', '.join(area_moved[:12])}"
                  f"{' ...' if len(area_moved) > 12 else ''}")
        if setup_moved:
            print(f"base changed the dependency setup: {', '.join(setup_moved[:12])}"
                  f"{' ...' if len(setup_moved) > 12 else ''}")
        retest = bool(area_moved or setup_moved)
        # No conflict means no rebase, and no rebase means no re-test: the PR is opened as is and
        # CI runs on the merge with the base (pull_request events build the merge ref).
        if conflicts and not set(conflicts) <= doc_files:
            verdicts.append("rebase-code")
        elif conflicts:
            verdicts.append("rebase-code" if retest else "rebase-docs")
        elif retest:
            print("merges cleanly, but the base changed code or dependencies this branch builds on")
            verdicts.append("retest-merge")
    order = ["merged-or-closed", "overlap", "needs-look", "rebase-code", "rebase-docs", "retest-merge"]
    verdict = next((v for v in order if v in verdicts), "unchanged")
    print(f"VERDICT {verdict}")
    sys.exit(0 if verdict == "unchanged" else 1)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:          # any crash means "could not decide", never a green light
        fail(f"contrib-check crashed: {type(e).__name__}: {e}")
