# Machine settings for pydantic/pydantic (set up 2026-11-12). Commands mode: the driver runs
# pydantic's own tests and ruff checks in the jail, from an environment SETUP_CMD installs once
# per change of SETUP_KEY. pydantic-core is built from source at setup, at the base commit, so a
# change to any file under pydantic-core (its Rust or its Python) is not seen by the tests, and the
# final gate refuses a branch that makes one: candidates stay in pydantic itself.
REPO=pydantic/pydantic
REPO_DIR=/home/user/contrib-work/repos/pydantic   # pipeline clone (full history)
USER_REPO_DIR=/home/user/pydantic                 # contrib-publish only (clone of the fork)
UPSTREAM_REMOTE=upstream
FORK_REMOTE=origin
BASE_BRANCH=main
CONTRIBUTOR=jelbirt
MAX_OPEN=2
BRANCH_PREFIX=fix/
ASSIGN_FIRST=1
GUARD=/home/user/contrib-pipeline/tools/guarded.sh
TOOLS=/home/user/contrib-work/tools/uv-0.13.7
SETUP_CMD=uv sync --frozen --no-install-project --no-editable --group dev --group linting --group testing-extra --all-extras
SETUP_KEY=uv.lock pyproject.toml pydantic-core
JAIL_ENV=UV_PROJECT_ENVIRONMENT={env} UV_CACHE_DIR={cache} UV_PYTHON=/usr/bin/python3.12 UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 RUFF_NO_CACHE=true CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
TEST_CMD={env}/bin/python -m pytest -p no:cacheprovider -q --junitxml={junit} {paths}
TEST_FILTER_FLAG=-k
TEST_EXIT_PASS=0
TEST_EXIT_FAIL=1
TEST_EXIT_NONE=5
TEST_FILES=tests/*test_*.py
CHECKS=FORMAT LINT
CHECK_FORMAT={env}/bin/ruff format --check --diff {paths}
CHECK_LINT={env}/bin/ruff check --no-fix {paths}
CHECK_PATHS=pydantic tests docs/plugins release pydantic-core/python pydantic-core/tests pydantic-core/wasm-preview/run_tests.py
GATE_CHECKS=FORMAT LINT
JAIL_PROCS=python python3 python3.12 uv ruff maturin
SESSION_DENY=uv uvx pip pytest ruff python python3 cargo maturin

# contrib-check and contrib-publish (SPEC.md phase 3): files whose full diff the user sees before any
# push; areas where a base change forces a retest; FORK_CI=1 offers a CI run on the fork first.
SENSITIVE_PATHS=^\.github/ ^pyproject\.toml$ ^uv\.lock$ ^Makefile$ ^\.pre-commit-config\.yaml$ (^|/)Cargo\.(toml|lock)$ (^|/)build\.rs$ \.(sh|bash)$
AREAS=^(pydantic)/ ^(pydantic-core)/ ^(docs)/ ^(tests)/
FORK_CI=1
