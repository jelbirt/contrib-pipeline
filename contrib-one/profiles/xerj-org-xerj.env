# Machine settings for xerj-org/xerj. Sourced by the driver (bash).
REPO=xerj-org/xerj
REPO_DIR=/home/user/contrib-work/repos/xerj   # pipeline clone; never the user's checkout
USER_REPO_DIR=/home/user/xerj                  # contrib-publish only
UPSTREAM_REMOTE=upstream
FORK_REMOTE=origin
BASE_BRANCH=main
CRATE_ROOT=engine                      # cargo workspace, relative to the repo root
GUARD=/home/user/contrib-pipeline/tools/guarded.sh
MAX_OPEN=10                            # open PRs by the user + unpublished ready packets
CONTRIBUTOR=jelbirt
BRANCH_PREFIX=fix/                     # pipeline branches: fix/<slug>
PORT_BASE=19400                        # scratch nodes use PORT_BASE..PORT_BASE+49
SERVER_BUILD="cargo build --profile ci-test -p xerj-server --bin xerj"
SERVER_BIN=ci-test/xerj                # relative to the candidate's target dir
RUNNER_BUILD="cargo build --profile ci-test -p es-yaml-runner"
RUNNER_BIN=ci-test/es-yaml-runner
YAML_DIR=tests/es-compat-yaml/yaml     # relative to CRATE_ROOT
# Reference-source citations kept out of commits, the PR body and names the diff brings in
# (ES is read for wire semantics only; its file and line citations go in details.md). A name
# already in the base tree or moved by the change is the project's own and is not refused.
PUBLIC_FORBID_RE=\b[A-Za-z0-9_]+\.java\b(?!\.\w)
